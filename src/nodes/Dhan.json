{
  "name": "Dhan",
  "broker": "dhan",
  "def": "Dhan",
  "node_type": "main",
  "icon": "/assets/icons/dhan.svg",
  "category": "Broker",
  "description": "Execute trades and get market data from Dhan Api",
  "color": "text-green-600",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Dhan"
    },
    {
      "key": "client_id",
      "label": "Client ID",
      "type": "text",
      "placeholder": "Client Id"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Dhan API Key"
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "live",
          "name": "Live"
        },
        {
          "id": "sandbox",
          "name": "Sandbox"
        }
      ],
      "default": "live"
    }
  ],
  "authAction": {
    "url": "/broker/dhan/auth",
    "method": "POST"
  },
  "action": {
    "url": "/broker/dhan/{{operation}}",
    "method": "{{method}}"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true,
      "description": "Your saved Dhan API credential."
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "get_account",
          "name": "Get Account",
          "method": "POST"
        },
        {
          "id": "get_positions",
          "name": "Get Positions",
          "method": "POST"
        },
        {
          "id": "get_holdings",
          "name": "Get Holdings",
          "method": "POST"
        },
        {
          "id": "get_orders",
          "name": "Get Orders",
          "method": "POST"
        },
        {
          "id": "get_trades",
          "name": "Get Trades",
          "method": "POST"
        },
        {
          "id": "get_order_by_id",
          "name": "Get Order By ID",
          "method": "POST"
        },
        {
          "id": "modify_order",
          "name": "Modify Order",
          "method": "POST"
        },
        {
          "id": "cancel_order",
          "name": "Cancel Order",
          "method": "POST"
        },
        {
          "id": "get_candle",
          "name": "Get Historical Bars",
          "method": "POST"
        },
        {
          "id": "place_order",
          "name": "Place Order",
          "method": "POST"
        }
      ],
      "placeholder": "Select operation",
      "required": true
    },
    {
      "key": "orderId",
      "label": "Order ID",
      "type": "text",
      "placeholder": "Dhan order ID",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_order_by_id",
            "modify_order",
            "cancel_order"
          ]
        }
      },
      "description": "Dhan order ID for lookup, modification, or cancellation."
    },
    {
      "key": "instrument",
      "label": "Instrument Type",
      "type": "select",
      "options": [
        {
          "id": "INDEX",
          "name": "Index"
        },
        {
          "id": "FUTIDX",
          "name": "Futures - Index"
        },
        {
          "id": "OPTIDX",
          "name": "Options - Index"
        },
        {
          "id": "EQUITY",
          "name": "Equity"
        },
        {
          "id": "FUTSTK",
          "name": "Futures - Stock"
        },
        {
          "id": "OPTSTK",
          "name": "Options - Stock"
        },
        {
          "id": "FUTCOM",
          "name": "Futures - Commodity"
        },
        {
          "id": "OPTFUT",
          "name": "Options - Futures"
        },
        {
          "id": "FUTCUR",
          "name": "Futures - Currency"
        },
        {
          "id": "OPTCUR",
          "name": "Options - Currency"
        }
      ],
      "placeholder": "Select instrument type",
      "required": true,
      "default": "EQUITY",
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      },
      "description": "Dhan instrument type. Example: EQUITY for stocks, INDEX for indices, FUTIDX for index futures, OPTIDX for index options."
    },
    {
      "key": "symbol",
      "label": "Ticker Symbol",
      "type": "text",
      "placeholder": "e.g. HDFCBANK",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "place_order"
          ]
        }
      },
      "description": "NSE/BSE stock symbol (e.g., RELIANCE, TCS, INFY)."
    },
    {
      "key": "exchangeSegment",
      "label": "Exchange Segment",
      "type": "select",
      "options": [
        {
          "id": "NSE_EQ",
          "name": "NSE - Equity Cash"
        },
        {
          "id": "NSE_FNO",
          "name": "NSE - Futures & Options"
        },
        {
          "id": "NSE_CURRENCY",
          "name": "NSE - Currency"
        },
        {
          "id": "BSE_EQ",
          "name": "BSE - Equity Cash"
        },
        {
          "id": "BSE_FNO",
          "name": "BSE - Futures & Options"
        },
        {
          "id": "BSE_CURRENCY",
          "name": "BSE - Currency"
        },
        {
          "id": "MCX_COMM",
          "name": "MCX - Commodity"
        },
        {
          "id": "IDX_I",
          "name": "INDEX - Indices"
        }
      ],
      "placeholder": "Select exchange segment",
      "required": true,
      "default": "NSE_EQ",
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      },
      "description": "Dhan exchange segment. Example: NSE_EQ for NSE Equity, NSE_FNO for NSE Futures & Options, IDX_I for indices."
    },
    {
      "key": "expiryCode",
      "label": "Expiry",
      "type": "select",
      "options": [
        {
          "id": "0",
          "name": "Current / Near Expiry"
        },
        {
          "id": "1",
          "name": "Next Expiry"
        },
        {
          "id": "2",
          "name": "Far Expiry"
        }
      ],
      "default": 0,
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ],
          "instrument": [
            "FUTIDX",
            "OPTIDX",
            "FUTSTK",
            "OPTSTK",
            "FUTCOM",
            "OPTFUT",
            "FUTCUR",
            "OPTCUR"
          ]
        }
      },
      "description": "Used only for derivative instruments. 0 = current/near expiry, 1 = next expiry, 2 = far expiry."
    },
    {
      "key": "interval",
      "label": "Interval",
      "type": "select",
      "options": [
        {
          "id": "1",
          "name": "1 min"
        },
        {
          "id": "5",
          "name": "5 min"
        },
        {
          "id": "15",
          "name": "15 min"
        },
        {
          "id": "25",
          "name": "25 min"
        },
        {
          "id": "60",
          "name": "1 hour"
        },
        {
          "id": "1Day",
          "name": "Day (Daily)"
        }
      ],
      "placeholder": "Select interval",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      }
    },
    {
      "key": "start",
      "label": "Start Date",
      "type": "text",
      "placeholder": "2024-01-03 09:15:00",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      },
      "description": "Optional. Start date/time for candle data. Format: YYYY-MM-DD HH:mm:ss. Example: 2024-01-03 09:15:00."
    },
    {
      "key": "end",
      "label": "End Date",
      "type": "text",
      "placeholder": "2024-01-04 15:30:00",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      },
      "description": "Optional. End date/time for candle data. Format: YYYY-MM-DD HH:mm:ss. Example: 2024-01-04 15:30:00."
    },
    {
      "key": "lookback",
      "label": "Bars to Fetch",
      "type": "text",
      "placeholder": "e.g. 100",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      }
    },
    {
      "key": "exchange_segment",
      "label": "Exchange Segment",
      "type": "select",
      "options": [
        {
          "id": "NSE_EQ",
          "name": "NSE Equity"
        },
        {
          "id": "BSE_EQ",
          "name": "BSE Equity"
        },
        {
          "id": "NSE_FNO",
          "name": "NSE F&O"
        },
        {
          "id": "BSE_FNO",
          "name": "BSE F&O"
        }
      ],
      "default": "NSE_EQ",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Exchange and segment: NSE/BSE for equities, FNO for futures & options."
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "id": "buy",
          "name": "Buy"
        },
        {
          "id": "sell",
          "name": "Sell"
        }
      ],
      "default": "buy",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Buy to open/add position, Sell to close/reduce position."
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order",
            "modify_order"
          ]
        }
      },
      "description": "Number of shares/lots to trade."
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market"
        },
        {
          "id": "limit",
          "name": "Limit"
        }
      ],
      "default": "market",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order",
            "modify_order"
          ]
        }
      },
      "description": "Market executes immediately at best price, Limit waits for specified price."
    },
    {
      "key": "validity",
      "label": "Validity",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "ioc",
          "name": "Immediate Or Cancel"
        }
      ],
      "default": "day",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order",
            "modify_order"
          ]
        }
      },
      "description": "Day order valid until market close, IOC fills immediately or cancels."
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "Required for limit orders",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order",
            "modify_order"
          ]
        }
      },
      "description": "Limit price for the order."
    }
  ]
}
