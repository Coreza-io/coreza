{
  "name": "Schwab",
  "broker": "schwab",
  "def": "Schwab",
  "node_type": "schwab",
  "description": "Access Schwab account info, positions, orders, quotes, and price history",
  "icon": "/assets/icons/schwab.svg",
  "color": "text-blue-500",
  "size": {
    "width": 300,
    "height": 300
  },
  "category": "Broker",
  "subCategory": "Schwab",
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "SchwabAuthModal",
  "authAction": {
    "url": "/oauth/schwab/generate-auth-url",
    "method": "POST"
  },
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "required": true,
      "placeholder": "e.g., My Schwab Account"
    },
    {
      "key": "app_key",
      "label": "App Key",
      "type": "password",
      "required": true,
      "placeholder": "Your Schwab App Key"
    },
    {
      "key": "app_secret",
      "label": "App Secret",
      "type": "password",
      "required": true,
      "placeholder": "Your Schwab App Secret"
    },
    {
      "key": "account_number",
      "label": "Account Number (Optional)",
      "type": "text",
      "required": false,
      "placeholder": "For reference only - will be fetched dynamically"
    }
  ],
  "action": {
    "url": "/broker/schwab/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "required": true,
      "optionsSource": "credentialsApi",
      "optionsApiUrl": "/broker/schwab/credentials",
      "description": "Your saved Schwab OAuth credential."
    },
    {
      "key": "accountHash",
      "label": "Account",
      "type": "select",
      "required": true,
      "optionsSource": "dependentApi",
      "optionsApiUrl": "/broker/schwab/get_account_numbers",
      "dependsOn": "credential_id",
      "placeholder": "Select an account",
      "description": "Select the Schwab account to use",
      "displayOptions": {
        "show": {
          "operation": [
            "get_account",
            "get_positions",
            "get_orders",
            "place_order"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "required": true,
      "options": [
        {
          "id": "get_account",
          "name": "Get Account"
        },
        {
          "id": "get_positions",
          "name": "Get Positions"
        },
        {
          "id": "get_orders",
          "name": "Get Orders"
        },
        {
          "id": "get_quotes",
          "name": "Get Quotes"
        },
        {
          "id": "get_price_history",
          "name": "Get Price History"
        },
        {
          "id": "place_order",
          "name": "Place Order"
        }
      ],
      "default": "get_account"
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "AAPL,TSLA,MSFT",
      "description": "Comma-separated list of symbols",
      "displayOptions": {
        "show": {
          "operation": [
            "get_quotes"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "fields",
      "label": "Quote Fields",
      "type": "select",
      "options": [
        {
          "id": "quote",
          "name": "Quote Only"
        },
        {
          "id": "fundamental",
          "name": "Fundamental Only"
        },
        {
          "id": "extended",
          "name": "Extended Only"
        },
        {
          "id": "quote,fundamental",
          "name": "Quote + Fundamental"
        },
        {
          "id": "all",
          "name": "All Fields"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "get_quotes"
          ]
        }
      }
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "AAPL",
      "description": "Single symbol for price history or trading",
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history",
            "place_order"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "periodType",
      "label": "Period Type",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "month",
          "name": "Month"
        },
        {
          "id": "year",
          "name": "Year"
        },
        {
          "id": "ytd",
          "name": "Year to Date"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history"
          ]
        }
      }
    },
    {
      "key": "period",
      "label": "Period",
      "type": "text",
      "placeholder": "10",
      "description": "Number of periods (depends on periodType)",
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "frequencyType",
      "label": "Frequency Type",
      "type": "select",
      "options": [
        {
          "id": "minute",
          "name": "Minute"
        },
        {
          "id": "daily",
          "name": "Daily"
        },
        {
          "id": "weekly",
          "name": "Weekly"
        },
        {
          "id": "monthly",
          "name": "Monthly"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history"
          ]
        }
      }
    },
    {
      "key": "frequency",
      "label": "Frequency",
      "type": "text",
      "placeholder": "1",
      "description": "Interval (e.g., 1 for 1-minute, 5 for 5-minute)",
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "needExtendedHoursData",
      "label": "Include Extended Hours",
      "type": "select",
      "options": [
        {
          "id": "true",
          "name": "Yes"
        },
        {
          "id": "false",
          "name": "No"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "get_price_history"
          ]
        }
      }
    },
    {
      "key": "limit",
      "label": "Max Results",
      "type": "text",
      "placeholder": "100",
      "displayOptions": {
        "show": {
          "operation": [
            "get_orders"
          ]
        }
      }
    },
    {
      "key": "start_date",
      "label": "Start Date",
      "type": "text",
      "placeholder": "2024-01-01T00:00:00Z",
      "description": "ISO 8601 format",
      "displayOptions": {
        "show": {
          "operation": [
            "get_orders"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "end_date",
      "label": "End Date",
      "type": "text",
      "placeholder": "2024-12-31T23:59:59Z",
      "description": "ISO 8601 format",
      "displayOptions": {
        "show": {
          "operation": [
            "get_orders"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "status",
      "label": "Order Status",
      "type": "text",
      "placeholder": "FILLED,CANCELED,REJECTED",
      "description": "Comma-separated list of statuses",
      "displayOptions": {
        "show": {
          "operation": [
            "get_orders"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "instruction",
      "label": "Action",
      "type": "select",
      "options": [
        {
          "id": "BUY",
          "name": "Buy"
        },
        {
          "id": "SELL",
          "name": "Sell"
        },
        {
          "id": "BUY_TO_COVER",
          "name": "Buy to Cover"
        },
        {
          "id": "SELL_SHORT",
          "name": "Sell Short"
        }
      ],
      "default": "BUY",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Trade action: Buy/Sell for regular positions, Short/Cover for short selling."
    },
    {
      "key": "quantity",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 10",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Number of shares to trade."
    },
    {
      "key": "orderType",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "MARKET",
          "name": "Market"
        },
        {
          "id": "LIMIT",
          "name": "Limit"
        },
        {
          "id": "STOP",
          "name": "Stop"
        },
        {
          "id": "STOP_LIMIT",
          "name": "Stop Limit"
        }
      ],
      "default": "MARKET",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Order execution type: Market fills immediately, Limit at specified price, Stop triggers at price."
    },
    {
      "key": "price",
      "label": "Limit Price",
      "type": "text",
      "placeholder": "Required for limit orders",
      "displayOptions": {
        "show": {
          "orderType": [
            "LIMIT",
            "STOP_LIMIT"
          ],
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Price for limit/stop-limit orders."
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "select",
      "options": [
        {
          "id": "DAY",
          "name": "Day"
        },
        {
          "id": "GOOD_TILL_CANCEL",
          "name": "Good Till Cancel"
        },
        {
          "id": "FILL_OR_KILL",
          "name": "Fill or Kill"
        }
      ],
      "default": "DAY",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "How long order stays active: Day expires at close, GTC until filled/cancelled."
    },
    {
      "key": "session",
      "label": "Session",
      "type": "select",
      "options": [
        {
          "id": "NORMAL",
          "name": "Normal"
        },
        {
          "id": "AM",
          "name": "Pre-Market"
        },
        {
          "id": "PM",
          "name": "After-Hours"
        }
      ],
      "default": "NORMAL",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Trading session: Normal (9:30am-4pm), AM (pre-market), PM (after-hours)."
    }
  ]
}