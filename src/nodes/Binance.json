{
  "name": "Binance",
  "def": "Fetch Market Data",
  "node_type": "main",
  "category": "Broker",
  "subCategory": "Binance",
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "Personal Binance"
    },
    {
      "key": "api_key",
      "label": "Binance API Key",
      "type": "password",
      "placeholder": "API Key"
    },
    {
      "key": "secret_key",
      "label": "Binance Secret Key",
      "type": "password",
      "placeholder": "Secret Key"
    }
  ],
  "authAction": { "url": "/broker/binance/auth", "method": "POST" },
  "icon": "/assets/icons/binance.svg",
  "size": { "width": 340, "height": 340 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": {
    "url": "/broker/binance/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        { "name": "Testnet (Paper)", "id": "testnet" },
        { "name": "Production (Live)", "id": "live" }
      ],
      "default": "testnet",
      "required": true
    },
    {
      "key": "asset_type",
      "label": "Asset Type",
      "type": "select",
      "options": [
        { "name": "Spot", "id": "spot" },
        { "name": "Futures", "id": "futures" }
      ],
      "default": "spot",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "name": "Get Account", "id": "get_account" },
        { "name": "Get Positions", "id": "get_positions" },
        { "name": "Get Orders", "id": "get_orders" },
        { "name": "Cancel Order", "id": "cancel_order" },
        { "name": "Get Candle", "id": "get_candle" },
        { "name": "Get Latest Bar", "id": "get_latest_bar" },
        { "name": "Get Ticker", "id": "get_ticker" }
      ],
      "required": true,
      "default": "get_ticker"
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. BTCUSDT",
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "get_latest_bar",
            "get_ticker",
            "cancel_order"
          ]
        }
      }
    },
    {
      "key": "order_id",
      "label": "Order ID",
      "type": "text",
      "placeholder": "Order ID to cancel",
      "displayOptions": {
        "show": {
          "operation": ["cancel_order"]
        }
      },
      "required": true
    },
    {
      "key": "interval",
      "label": "Interval",
      "type": "select",
      "options": [
        { "name": "1 Minute", "id": "1m" },
        { "name": "5 Minutes", "id": "5m" },
        { "name": "3 Minutes", "id": "3m" },
        { "name": "15 Minutes", "id": "15m" },
        { "name": "30 Minutes", "id": "30m" },
        { "name": "1 Hour", "id": "1h" },
        { "name": "4 Hours", "id": "4h" },
        { "name": "1 Day", "id": "1d" },
        { "name": "1 Week", "id": "1w" }
      ],
      "default": "1h",
      "displayOptions": {
        "show": {
          "operation": ["get_candle"]
        }
      }
    },
    {
      "key": "limit",
      "label": "Limit",
      "type": "text",
      "default": 100,
      "placeholder": "Number of records",
      "displayOptions": {
        "show": {
          "operation": ["get_candle", "get_orders"]
        }
      }
    },
    {
      "key": "startTime",
      "label": "Start Time",
      "type": "text",
      "placeholder": "YYYY-MM-DD HH:mm:ss",
      "displayOptions": {
        "show": {
          "operation": ["get_candle", "get_orders"]
        }
      }
    },
    {
      "key": "endTime",
      "label": "End Time",
      "type": "text",
      "placeholder": "YYYY-MM-DD HH:mm:ss",
      "displayOptions": {
        "show": {
          "operation": ["get_candle", "get_orders"]
        }
      }
    }
  ]
}
