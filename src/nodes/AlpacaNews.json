{
  "name": "AlpacaNews",
  "def": "Alpaca News",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Broker",
  "subCategory": "Alpaca",
  "executionMode": "streaming",
  "streamingConfig": {
    "waitForFirstEvent": true,
    "timeout": 30000
  },
  "description": "Subscribe to real-time news from Alpaca News API",
  "color": "text-yellow-500",
  "size": { "width": 340, "height": 300 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": { "url": "/broker/alpaca/auth", "method": "POST" },
  "action": { "url": "/websocket/alpaca_news/{{operation}}", "method": "POST" },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "id": "subscribe", "name": "Subscribe", "method": "POST" },
        { "id": "unsubscribe", "name": "Unsubscribe", "method": "POST" }
      ],
      "required": true
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "e.g. AAPL,MSFT or * for all",
      "description": "Comma-separated symbols or * for all news",
      "required": true
    }
  ]
}
