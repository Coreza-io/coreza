{
  "name": "BinanceTrade",
  "def": "Execute Trade",
  "node_type": "main",
  "category": "Broker",
  "subCategory": "binance",
  "parentNode": "Binance",
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "Personal Binance"
    },
    {
      "key": "api_key",
      "label": "Binance API Key",
      "type": "password",
      "placeholder": "API Key"
    },
    {
      "key": "secret_key",
      "label": "Binance Secret Key",
      "type": "password",
      "placeholder": "Secret Key"
    }
  ],
  "authAction": {
    "url": "/broker/binance/auth",
    "method": "POST"
  },
  "icon": "/assets/icons/binance.svg",
  "size": {
    "width": 340,
    "height": 340
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/broker/binance/place_order",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "place_order",
          "name": "Place Order"
        }
      ],
      "default": "place_order",
      "required": true
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "name": "Testnet (Paper)",
          "id": "testnet"
        },
        {
          "name": "Production (Live)",
          "id": "live"
        }
      ],
      "default": "testnet",
      "required": true
    },
    {
      "key": "marketType",
      "label": "Market Type",
      "type": "select",
      "options": [
        {
          "name": "Spot",
          "id": "spot"
        },
        {
          "name": "Futures",
          "id": "futures"
        },
        {
          "name": "Margin",
          "id": "margin"
        }
      ],
      "default": "spot",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. BTCUSDT",
      "required": true
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "name": "Buy",
          "id": "BUY"
        },
        {
          "name": "Sell",
          "id": "SELL"
        }
      ],
      "required": true
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "name": "Market",
          "id": "MARKET"
        },
        {
          "name": "Limit",
          "id": "LIMIT"
        },
        {
          "name": "Stop Loss",
          "id": "STOP_LOSS"
        },
        {
          "name": "Stop Loss Limit",
          "id": "STOP_LOSS_LIMIT"
        },
        {
          "name": "Take Profit",
          "id": "TAKE_PROFIT"
        },
        {
          "name": "Take Profit Limit",
          "id": "TAKE_PROFIT_LIMIT"
        }
      ],
      "default": "MARKET",
      "required": true,
      "displayOptions": {
        "show": {
          "marketType": [
            "spot"
          ]
        }
      }
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "name": "Market",
          "id": "MARKET"
        },
        {
          "name": "Limit",
          "id": "LIMIT"
        },
        {
          "name": "Stop",
          "id": "STOP"
        },
        {
          "name": "Take Profit",
          "id": "TAKE_PROFIT"
        },
        {
          "name": "Stop Market",
          "id": "STOP_MARKET"
        },
        {
          "name": "Take Profit Market",
          "id": "TAKE_PROFIT_MARKET"
        },
        {
          "name": "Trailing Stop Market",
          "id": "TRAILING_STOP_MARKET"
        }
      ],
      "default": "MARKET",
      "required": true,
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ]
        }
      }
    },
    {
      "key": "quantity",
      "label": "Quantity",
      "type": "text",
      "placeholder": "Order quantity",
      "required": true,
      "description": "Required unless Close Position is enabled for futures stop-market take-profit-market orders.",
      "displayOptions": {
        "hide": {
          "closePosition": [
            true
          ]
        }
      }
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "Limit price",
      "displayOptions": {
        "show": {
          "marketType": [
            "spot"
          ],
          "type": [
            "LIMIT",
            "STOP_LOSS_LIMIT",
            "TAKE_PROFIT_LIMIT"
          ]
        }
      }
    },
    {
      "key": "stopPrice",
      "label": "Stop Price",
      "type": "text",
      "placeholder": "Stop price",
      "displayOptions": {
        "show": {
          "marketType": [
            "spot"
          ],
          "type": [
            "STOP_LOSS",
            "STOP_LOSS_LIMIT",
            "TAKE_PROFIT",
            "TAKE_PROFIT_LIMIT"
          ]
        }
      }
    },
    {
      "key": "timeInForce",
      "label": "Time In Force",
      "type": "select",
      "options": [
        {
          "name": "GTC (Good Till Cancel)",
          "id": "GTC"
        },
        {
          "name": "IOC (Immediate Or Cancel)",
          "id": "IOC"
        },
        {
          "name": "FOK (Fill Or Kill)",
          "id": "FOK"
        }
      ],
      "default": "GTC",
      "displayOptions": {
        "show": {
          "marketType": [
            "spot"
          ],
          "type": [
            "LIMIT",
            "STOP_LOSS_LIMIT",
            "TAKE_PROFIT_LIMIT"
          ]
        }
      }
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "Order price",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "LIMIT",
            "STOP",
            "TAKE_PROFIT"
          ]
        }
      }
    },
    {
      "key": "stopPrice",
      "label": "Trigger Price",
      "type": "text",
      "placeholder": "Trigger price",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "STOP",
            "TAKE_PROFIT",
            "STOP_MARKET",
            "TAKE_PROFIT_MARKET"
          ]
        }
      }
    },
    {
      "key": "timeInForce",
      "label": "Time In Force",
      "type": "select",
      "options": [
        {
          "name": "GTC (Good Till Cancel)",
          "id": "GTC"
        },
        {
          "name": "IOC (Immediate Or Cancel)",
          "id": "IOC"
        },
        {
          "name": "FOK (Fill Or Kill)",
          "id": "FOK"
        },
        {
          "name": "GTD (Good Till Date)",
          "id": "GTD"
        }
      ],
      "default": "GTC",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "LIMIT",
            "STOP",
            "TAKE_PROFIT"
          ]
        }
      }
    },
    {
      "key": "goodTillDate",
      "label": "Good Till Date",
      "type": "text",
      "placeholder": "YYYY-MM-DDTHH:mm:ssZ",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "timeInForce": [
            "GTD"
          ]
        }
      }
    },
    {
      "key": "priceMatch",
      "label": "Price Match",
      "type": "select",
      "options": [
        {
          "name": "NONE",
          "id": "NONE"
        },
        {
          "name": "OPPONENT",
          "id": "OPPONENT"
        },
        {
          "name": "OPPONENT_5",
          "id": "OPPONENT_5"
        },
        {
          "name": "OPPONENT_10",
          "id": "OPPONENT_10"
        },
        {
          "name": "OPPONENT_20",
          "id": "OPPONENT_20"
        },
        {
          "name": "QUEUE",
          "id": "QUEUE"
        },
        {
          "name": "QUEUE_5",
          "id": "QUEUE_5"
        },
        {
          "name": "QUEUE_10",
          "id": "QUEUE_10"
        },
        {
          "name": "QUEUE_20",
          "id": "QUEUE_20"
        }
      ],
      "default": "NONE",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "LIMIT",
            "STOP",
            "TAKE_PROFIT"
          ]
        }
      }
    },
    {
      "key": "selfTradePreventionMode",
      "label": "Self Trade Prevention",
      "type": "select",
      "options": [
        {
          "name": "NONE",
          "id": "NONE"
        },
        {
          "name": "EXPIRE_TAKER",
          "id": "EXPIRE_TAKER"
        },
        {
          "name": "EXPIRE_MAKER",
          "id": "EXPIRE_MAKER"
        },
        {
          "name": "EXPIRE_BOTH",
          "id": "EXPIRE_BOTH"
        }
      ],
      "default": "NONE",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ]
        }
      }
    },
    {
      "key": "icebergQty",
      "label": "Iceberg Quantity",
      "type": "text",
      "placeholder": "Optional iceberg quantity",
      "displayOptions": {
        "show": {
          "type": [
            "LIMIT"
          ],
          "marketType": [
            "spot"
          ]
        }
      }
    },
    {
      "key": "newOrderRespType",
      "label": "Response Type",
      "type": "select",
      "options": [
        {
          "name": "ACK",
          "id": "ACK"
        },
        {
          "name": "RESULT",
          "id": "RESULT"
        },
        {
          "name": "FULL",
          "id": "FULL"
        }
      ],
      "default": "ACK"
    },
    {
      "key": "clientAlgoId",
      "label": "Client Algo ID",
      "type": "text",
      "placeholder": "Optional client algo id",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "STOP",
            "TAKE_PROFIT",
            "STOP_MARKET",
            "TAKE_PROFIT_MARKET",
            "TRAILING_STOP_MARKET"
          ]
        }
      }
    },
    {
      "key": "positionSide",
      "label": "Position Side",
      "type": "select",
      "options": [
        {
          "name": "BOTH",
          "id": "BOTH"
        },
        {
          "name": "LONG",
          "id": "LONG"
        },
        {
          "name": "SHORT",
          "id": "SHORT"
        }
      ],
      "default": "BOTH",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ]
        }
      }
    },
    {
      "key": "reduceOnly",
      "label": "Reduce Only",
      "type": "boolean",
      "default": false,
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ]
        }
      }
    },
    {
      "key": "closePosition",
      "label": "Close Position",
      "type": "boolean",
      "default": false,
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "STOP_MARKET",
            "TAKE_PROFIT_MARKET"
          ]
        }
      }
    },
    {
      "key": "workingType",
      "label": "Working Type",
      "type": "select",
      "options": [
        {
          "name": "Mark Price",
          "id": "MARK_PRICE"
        },
        {
          "name": "Contract Price",
          "id": "CONTRACT_PRICE"
        }
      ],
      "default": "CONTRACT_PRICE",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ]
        }
      }
    },
    {
      "key": "priceProtect",
      "label": "Price Protect",
      "type": "boolean",
      "default": false,
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "STOP_MARKET",
            "TAKE_PROFIT_MARKET"
          ]
        }
      }
    },
    {
      "key": "activationPrice",
      "label": "Activation Price",
      "type": "text",
      "placeholder": "Optional activation price",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "TRAILING_STOP_MARKET"
          ]
        }
      }
    },
    {
      "key": "callbackRate",
      "label": "Callback Rate",
      "type": "text",
      "placeholder": "e.g. 0.1 - 10",
      "displayOptions": {
        "show": {
          "marketType": [
            "futures"
          ],
          "type": [
            "TRAILING_STOP_MARKET"
          ]
        }
      }
    }
  ]
}
