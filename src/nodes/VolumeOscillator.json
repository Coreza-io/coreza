{
  "name": "VolumeOscillator",
  "def": "Volume Oscillator",
  "node_type": "main",
  "icon": "/assets/icons/volume-oscillator.svg",
  "category": "Indicators",
  "description": "Volume Oscillator showing difference between two volume moving averages",
  "color": "text-purple-500",
  "size": {
    "width": 300,
    "height": 320
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/volume-oscillator",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true
    },
    {
      "key": "short_period",
      "label": "Short Period",
      "type": "text",
      "placeholder": "e.g. 12",
      "default": "12",
      "required": true
    },
    {
      "key": "long_period",
      "label": "Long Period",
      "type": "text",
      "placeholder": "e.g. 26",
      "default": "26",
      "required": true
    },
    {
      "key": "type",
      "label": "Calculation Type",
      "type": "select",
      "options": [
        {
          "id": "percentage",
          "name": "Percentage (PVO)"
        },
        {
          "id": "absolute",
          "name": "Absolute Difference"
        }
      ],
      "default": "percentage",
      "required": true
    }
  ]
}
