{
  "name": "AlpacaStreamData",
  "def": "Alpaca Stream Data",
  "node_type": "trigger",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Market",
  "subCategory": "alpaca",
  "executionMode": "streaming",
  "action": {
    "url": "/stream/alpaca/register",
    "method": "POST"
  },
  "streamingConfig": {
    "waitForFirstEvent": false,
    "timeout": 300000,
    "listeningFlag": "isTestListening",
    "subscribeListeningFlag": "isStreamingWaiting",
    "recoveryPolling": {
      "endpoint": "/market/stream-test-result/{{workflow_id}}/{{node_id}}",
      "interval": 10000
    }
  },
  "description": "Receives real-time market data, news, or order fill events from Alpaca. Use AlpacaSubscribe node to explicitly subscribe to market streams and/or Order Updates (Fills). Use an If node downstream to route market events vs order updates. Use Listen mode to receive pre-subscribed symbols, or Subscribe mode to subscribe and stream in one node.",
  "color": "text-yellow-500",
  "size": {
    "width": 320,
    "height": 320
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "fields": [
    {
      "key": "data_type",
      "label": "Data Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market Data (Trades, Quotes, Bars)"
        },
        {
          "id": "crypto",
          "name": "Crypto (BTC/USD, ETH/USD)"
        },
        {
          "id": "news",
          "name": "News"
        }
      ],
      "default": "market",
      "required": true
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        {
          "id": "listen",
          "name": "Listen (Use Pre-subscribed Symbols)"
        },
        {
          "id": "subscribe",
          "name": "Subscribe & Stream (Self-contained)"
        }
      ],
      "default": "listen",
      "description": "Listen mode uses symbols from Subscribe nodes. Subscribe mode subscribes symbols directly.",
      "showDescription": false
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": false
    },
    {
      "key": "feed",
      "label": "Data Feed",
      "type": "select",
      "options": [
        {
          "id": "iex",
          "name": "IEX (Free)"
        },
        {
          "id": "sip",
          "name": "SIP (Paid - Full Market)"
        },
        {
          "id": "test",
          "name": "Test (FAKEPACA - Always Active)"
        }
      ],
      "default": "iex",
      "description": "IEX is free but regular hours only. SIP includes pre/post market.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"],
          "data_type": ["market"]
        }
      },
      "showDescription": false
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "AAPL, TSLA, SPY or BTC/USD, ETH/USD",
      "description": "Symbols to subscribe and stream.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "showDescription": false
    },
    {
      "key": "stream_types",
      "label": "Stream Types",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trades"
        },
        {
          "id": "quote",
          "name": "Quotes"
        },
        {
          "id": "bar",
          "name": "Minute Bars (1min Candles)"
        },
        {
          "id": "daily_bar",
          "name": "Daily Bars (EOD Candles)"
        },
        {
          "id": "order_update",
          "name": "Order Updates (Fills)"
        }
      ],
      "default": ["trade"],
      "displayOptions": {
        "show": {
          "mode": ["subscribe"],
          "data_type": ["market", "crypto"]
        }
      }
    },
    {
      "key": "close_bars",
      "label": "Close Bars Only",
      "type": "checkbox",
      "default": true,
      "description": "When checked, only emit completed 1-min bars. When unchecked, emit continuous updated bars (tick-level partial candles).",
      "showDescription": true,
      "displayOptions": {
        "show": {
          "stream_types": ["bar"],
          "mode": ["subscribe"],
          "data_type": ["market", "crypto"]
        }
      }
    },
    {
      "key": "scope",
      "label": "scope",
      "type": "select",
      "options": [
        {
          "id": "workflow",
          "name": "Only This Workflow's Subscriptions"
        },
        {
          "id": "global",
          "name": "All My Subscriptions"
        }
      ],
      "default": "workflow",
      "description": "Receive only symbols subscribed targeting this workflow, or all your global subscriptions.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_symbols",
      "label": "Filter Symbols (Optional)",
      "type": "text",
      "placeholder": "AAPL, TSLA (leave empty for all)",
      "description": "Only receive data for specific symbols. Leave empty to receive all pre-subscribed.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_types",
      "label": "Filter Event Types (Optional)",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trades"
        },
        {
          "id": "quote",
          "name": "Quotes"
        },
        {
          "id": "bar",
          "name": "Minute Bars"
        },
        {
          "id": "daily_bar",
          "name": "Daily Bars"
        },
        {
          "id": "updated_bar",
          "name": "Updated Bars (Continuous)"
        },
        {
          "id": "news",
          "name": "News"
        },
        {
          "id": "order_update",
          "name": "Order Updates (Fills)"
        }
      ],
      "description": "Filter specific event types. Leave empty to receive all types.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    }
  ]
}
