{
  "name": "Portfolio",
  "def": "Portfolio",
  "node_type": "main",
  "icon": "/assets/icons/backtest.svg",
  "category": "Portfolio",
  "description": "Query and update portfolio state -- positions, cash, equity, orders, trades. Works in both backtest and live broker modes.",
  "color": "text-orange-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/portfolio",
    "method": "POST"
  },
  "fields": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "required": true,
      "default": "backtest",
      "options": [
        {
          "id": "backtest",
          "name": "Backtest (SimBroker)"
        },
        {
          "id": "broker",
          "name": "Live (Broker)"
        }
      ]
    },
    {
      "key": "backtest_id",
      "label": "Backtest ID",
      "type": "text",
      "placeholder": "{{ $('BacktestInit').json.backtest_id }}",
      "required": true,
      "displayOptions": {
        "show": {
          "mode": ["backtest"]
        }
      }
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "required": true,
      "default": "get_portfolio",
      "options": [
        {
          "id": "create_portfolio",
          "name": "Create Portfolio (Bootstrap)"
        },
        {
          "id": "update_portfolio",
          "name": "Sync Fills"
        },
        {
          "id": "register_order",
          "name": "Register Pending Order"
        },
        {
          "id": "cancel_order",
          "name": "Cancel Pending Order"
        },
        {
          "id": "get_pending_orders",
          "name": "Get Pending Orders"
        },
        {
          "id": "get_portfolio",
          "name": "Get Portfolio"
        },
        {
          "id": "get_position",
          "name": "Get Position"
        },
        {
          "id": "update_mtm",
          "name": "Update Portfolio (MTM)"
        },
        {
          "id": "get_cash",
          "name": "Get Cash"
        },
        {
          "id": "get_equity",
          "name": "Get Equity"
        },
        {
          "id": "get_trades",
          "name": "Get Trades"
        }
      ]
    },
    {
      "key": "base_currency",
      "label": "Base Currency",
      "type": "select",
      "required": true,
      "default": "USDT",
      "options": [
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "EUR",
          "name": "EUR"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "create_portfolio",
            "update_portfolio",
            "update_mtm",
            "get_portfolio",
            "get_cash",
            "get_equity"
          ]
        }
      }
    },
    {
      "key": "cash_balance",
      "label": "Cash Balance",
      "type": "text",
      "placeholder": "e.g. 64786.0",
      "required": true,
      "description": "Starting cash balance in the base currency.",
      "displayOptions": {
        "show": {
          "operation": ["create_portfolio"]
        }
      }
    },
    {
      "key": "symbol",
      "label": "Symbol(s)",
      "type": "text",
      "placeholder": "e.g. BTCUSDT or BTCUSDT,ETHUSDT",
      "required": false,
      "description": "One or more symbols (comma-separated).",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "get_position", "update_mtm", "register_order", "get_pending_orders"]
        }
      }
    },
    {
      "key": "side",
      "label": "Side",
      "type": "text",
      "placeholder": "e.g. BUY/SELL",
      "required": true,
      "description": "Trade side. Determines whether quantity adds or reduces the position.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "register_order"]
        }
      }
    },
    {
      "key": "quantity",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": true,
      "description": "Cumulative filled quantity when using Fill ID (delta computed automatically). Absolute value — side controls direction.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "register_order"]
        }
      }
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "e.g. 64786.0",
      "required": true,
      "description": "Average fill price.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "update_mtm", "register_order"]
        }
      }
    },
    {
      "key": "commission",
      "label": "Commission",
      "type": "text",
      "placeholder": "0",
      "required": false,
      "default": "0",
      "description": "Trade commission (deducted from cash).",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio"]
        }
      }
    },
    {
      "key": "fill_id",
      "label": "Order ID / Fill ID",
      "type": "text",
      "placeholder": "{{ $(AlpacaStreamData).json.data.order.orderId }}",
      "required": false,
      "description": "Unique order identifier. Used for deduplication in Sync Fills, and as the key for Register/Cancel Pending Order operations.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "register_order", "cancel_order"]
        }
      }
    },
    {
      "key": "client_order_id",
      "label": "Client Order ID (Fallback)",
      "type": "text",
      "placeholder": "{{ $(AlpacaStreamData).json.data.order.client_order_id }}",
      "required": false,
      "description": "Fallback dedup key if orderId not yet indexed. Maps to the client_order_id sent with the original order.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "register_order"]
        }
      }
    },
    {
      "key": "current_bar",
      "label": "Current Bar",
      "type": "textarea",
      "placeholder": "{{ $('OnBar').json.bar }}",
      "required": false,
      "description": "Current OHLCV bar for mark-to-market pricing",
      "displayOptions": {
        "show": {
          "operation": ["update_mtm"],
          "mode": ["backtest"]
        }
      }
    }
  ],
  "operationDisplayOptions": {
    "update_mtm": {
      "show": {
        "mode": ["backtest", "broker"]
      }
    },
    "register_order": {
      "show": {
        "mode": ["broker"]
      }
    },
    "cancel_order": {
      "show": {
        "mode": ["broker"]
      }
    },
    "get_pending_orders": {
      "show": {
        "mode": ["broker"]
      }
    }
  }
}
