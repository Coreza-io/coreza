{
  "name": "SchwabTradeTool",
  "def": "Schwab Trade",
  "node_type": "sub",
  "icon": "/assets/icons/schwab.svg",
  "category": "Tool",
  "subCategory": "Schwab",
  "description": "Execute stock trades through Charles Schwab. Supports market, limit, stop, and stop-limit orders with buy, sell, short, and cover actions.",
  "color": "text-blue-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "auth": "SchwabAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Schwab"
    },
    {
      "key": "app_key",
      "label": "App Key",
      "type": "password",
      "placeholder": "Your Schwab App Key"
    },
    {
      "key": "app_secret",
      "label": "App Secret",
      "type": "password",
      "placeholder": "Your Schwab App Secret"
    },
    {
      "key": "account_number",
      "label": "Account Number (Optional)",
      "type": "text",
      "required": false,
      "placeholder": "For reference only - will be fetched dynamically"
    }
  ],
  "authAction": {
    "url": "/oauth/schwab/generate-auth-url",
    "method": "POST"
  },
  "action": {
    "url": "/broker/schwab/place_order",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "hidden",
      "default": "place_order"
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "description": "Your saved Schwab OAuth credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "accountHash",
      "label": "Account",
      "type": "select",
      "required": true,
      "optionsSource": "dependentApi",
      "optionsApiUrl": "/broker/schwab/get_account_numbers",
      "dependsOn": "credential_id",
      "placeholder": "Select an account",
      "description": "Select the Schwab brokerage account for trading.",
      "showDescription": false
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "description": "Stock ticker symbol to trade.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "instruction",
      "label": "Action",
      "type": "select",
      "options": [
        {
          "id": "BUY",
          "name": "Buy"
        },
        {
          "id": "SELL",
          "name": "Sell"
        },
        {
          "id": "BUY_TO_COVER",
          "name": "Buy to Cover"
        },
        {
          "id": "SELL_SHORT",
          "name": "Sell Short"
        }
      ],
      "default": "BUY",
      "description": "Trade action: Buy/Sell for regular positions, Short/Cover for short selling.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "quantity",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 10",
      "description": "Number of shares to trade.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "orderType",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "MARKET",
          "name": "Market"
        },
        {
          "id": "LIMIT",
          "name": "Limit"
        },
        {
          "id": "STOP",
          "name": "Stop"
        },
        {
          "id": "STOP_LIMIT",
          "name": "Stop Limit"
        }
      ],
      "default": "MARKET",
      "description": "Order execution type: Market fills immediately, Limit at specified price, Stop triggers at price.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "price",
      "label": "Limit Price",
      "type": "text",
      "placeholder": "Required for limit orders",
      "description": "Price for limit/stop-limit orders.",
      "displayOptions": {
        "show": {
          "orderType": [
            "LIMIT",
            "STOP_LIMIT"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "select",
      "options": [
        {
          "id": "DAY",
          "name": "Day"
        },
        {
          "id": "GOOD_TILL_CANCEL",
          "name": "Good Till Cancel"
        },
        {
          "id": "FILL_OR_KILL",
          "name": "Fill or Kill"
        }
      ],
      "default": "DAY",
      "description": "How long order stays active: Day expires at close, GTC until filled/cancelled.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "session",
      "label": "Session",
      "type": "select",
      "options": [
        {
          "id": "NORMAL",
          "name": "Normal"
        },
        {
          "id": "AM",
          "name": "Pre-Market"
        },
        {
          "id": "PM",
          "name": "After-Hours"
        }
      ],
      "default": "NORMAL",
      "description": "Trading session: Normal (9:30am-4pm), AM (pre-market), PM (after-hours).",
      "showDescription": false
    }
  ]
}
