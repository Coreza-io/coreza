{
  "name": "FMPScreener",
  "def": "FMP Screener",
  "description": "Screen stocks using Financial Modeling Prep (FMP)",
  "node_type": "main",
  "category": "Screener",
  "subCategory": "FMP",
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My FMP API"
    },
    {
      "key": "api_key",
      "label": "FMP API Key",
      "type": "password",
      "placeholder": "Your FMP API key"
    }
  ],
  "authAction": { "url": "/fmp/auth", "method": "POST" },
  "icon": "/assets/icons/fmp.svg",
  "size": { "width": 340, "height": 600 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/screener/fmp/{{operation}}", "method": "POST" },
  "fields": [
    {
      "key": "operation",
      "type": "hidden",
      "default": "stock_screener"
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "required": true
    },
    {
      "key": "limit",
      "label": "Limit (Results)",
      "type": "text",
      "default": "100"
    },

    {
      "key": "marketCapMoreThan",
      "label": "Min Market Cap",
      "type": "text",
      "placeholder": "1000000000"
    },
    {
      "key": "marketCapLowerThan",
      "label": "Max Market Cap",
      "type": "text",
      "placeholder": "10000000000"
    },

    {
      "key": "priceMoreThan",
      "label": "Min Price",
      "type": "text"
    },
    {
      "key": "priceLowerThan",
      "label": "Max Price",
      "type": "text"
    },

    {
      "key": "betaMoreThan",
      "label": "Min Beta",
      "type": "text"
    },
    {
      "key": "betaLowerThan",
      "label": "Max Beta",
      "type": "text"
    },

    {
      "key": "volumeMoreThan",
      "label": "Min Volume",
      "type": "text"
    },

    {
      "key": "dividendMoreThan",
      "label": "Min Dividend Yield",
      "type": "text"
    },
    {
      "key": "dividendLowerThan",
      "label": "Max Dividend Yield",
      "type": "text"
    },

    {
      "key": "sector",
      "label": "Sector",
      "type": "select",
      "options": [
        { "id": "", "name": "All" },
        { "id": "Technology", "name": "Technology" },
        { "id": "Healthcare", "name": "Healthcare" },
        { "id": "Financial Services", "name": "Financial Services" },
        { "id": "Consumer Cyclical", "name": "Consumer Cyclical" },
        { "id": "Consumer Defensive", "name": "Consumer Defensive" },
        { "id": "Industrials", "name": "Industrials" },
        { "id": "Energy", "name": "Energy" },
        { "id": "Basic Materials", "name": "Basic Materials" },
        { "id": "Communication Services", "name": "Communication Services" },
        { "id": "Real Estate", "name": "Real Estate" },
        { "id": "Utilities", "name": "Utilities" }
      ]
    },

    {
      "key": "industry",
      "label": "Industry",
      "type": "text"
    },
    {
      "key": "country",
      "label": "Country",
      "type": "text",
      "default": "US"
    },
    {
      "key": "exchange",
      "label": "Exchange",
      "type": "select",
      "options": [
        { "id": "", "name": "All" },
        { "id": "NYSE", "name": "NYSE" },
        { "id": "NASDAQ", "name": "NASDAQ" },
        { "id": "AMEX", "name": "AMEX" }
      ]
    },

    {
      "key": "isEtf",
      "label": "ETF Filter",
      "type": "select",
      "options": [
        { "id": "", "name": "All" },
        { "id": "true", "name": "ETFs Only" },
        { "id": "false", "name": "Exclude ETFs" }
      ],
      "default": "false"
    },

    {
      "key": "isActivelyTrading",
      "label": "Actively Trading",
      "type": "select",
      "options": [
        { "id": "", "name": "All" },
        { "id": "true", "name": "Active Only" },
        { "id": "false", "name": "Inactive Only" }
      ],
      "default": "true"
    }
  ]
}
