{
  "name": "BinanceScreener",
  "def": "Screen Assets",
  "node_type": "main",
  "category": "Screener",
  "parentNode": "binance",
  "subCategory": "binance",
  "icon": "/assets/icons/binance.svg",
  "size": {
    "width": 340,
    "height": 340
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/screener/binance/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true,
      "description": "Your saved Binance API credential."
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "name": "Testnet (Paper)",
          "id": "testnet"
        },
        {
          "name": "Production (Live)",
          "id": "live"
        }
      ],
      "default": "testnet",
      "required": true,
      "description": "Testnet for testing, Production for real market data."
    },
    {
      "key": "assetType",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "name": "Spot",
          "id": "spot"
        },
        {
          "name": "Futures",
          "id": "futures"
        }
      ],
      "default": "spot",
      "required": true,
      "description": "Market type: Spot for regular trading, Futures for derivatives."
    },
    {
      "key": "operation",
      "label": "Filter Type",
      "type": "select",
      "options": [
        {
          "name": "Top Gainers",
          "id": "top_gainers"
        },
        {
          "name": "Top Losers",
          "id": "top_losers"
        },
        {
          "name": "Most Active by Volume",
          "id": "most_active"
        },
        {
          "name": "New Listings",
          "id": "new_listings"
        }
      ],
      "default": "top_gainers",
      "required": true
    },
    {
      "key": "limit",
      "label": "Limit",
      "type": "text",
      "default": 10,
      "placeholder": "Number of results",
      "required": true,
      "description": "Maximum number of results to return."
    },
    {
      "key": "quote_asset",
      "label": "Quote Asset",
      "type": "select",
      "options": [
        {
          "name": "USDT",
          "id": "USDT"
        },
        {
          "name": "BUSD",
          "id": "BUSD"
        },
        {
          "name": "BTC",
          "id": "BTC"
        },
        {
          "name": "ETH",
          "id": "ETH"
        }
      ],
      "default": "USDT",
      "displayOptions": {
        "show": {
          "asset_type": [
            "spot"
          ]
        }
      },
      "description": "Quote currency to filter pairs (e.g., USDT shows only *USDT pairs)."
    },
    {
      "key": "min_volume",
      "label": "Min Volume (24h)",
      "type": "text",
      "placeholder": "Minimum 24h volume",
      "displayOptions": {
        "show": {
          "operation": [
            "most_active"
          ]
        }
      },
      "description": "Minimum 24-hour trading volume in quote currency."
    },
    {
      "key": "min_price_change",
      "label": "Min Price Change %",
      "type": "text",
      "placeholder": "Minimum price change percentage",
      "displayOptions": {
        "show": {
          "operation": [
            "top_gainers",
            "top_losers"
          ]
        }
      },
      "description": "Minimum absolute price change percentage to include."
    }
  ]
}
