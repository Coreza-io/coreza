# Application logs (console, structured and HTTP): only debug enables output.
# This includes warnings/errors. Restart the service after changing this value.
# Set LOG_LEVEL=debug to enable; unset or any other value keeps logs silent.
# Values: debug (enable all logs and local timing), silent (disable). Any other value or unset also disables logs.
LOG_LEVEL=silent

# LOG_LEVEL=debug also enables local live-event latency histograms.
# Enable cross-service estimates only after checking gateway/runner/Redis clock offsets.
# Values: true, false. true enables cross-service timing estimates; requires verified clocks and LOG_LEVEL=debug.
LIVE_TIMING_CLOCKS_VERIFIED=false

# Supabase Configuration (runtime — backend only)
# Format: https://<project-ref>.supabase.co (your project URL); required, no default.
SUPABASE_URL=
# Format: your Supabase project reference from its URL/dashboard; required, no default.
SUPABASE_PROJECT_ID=
# Format: sb_publishable_... (or a legacy anon JWT); required, use the public project key.
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon JWT fallback; leave empty when SUPABASE_PUBLISHABLE_KEY is configured.
SUPABASE_ANON_KEY=
# Format: sb_secret_... (or a legacy service_role JWT); required, server-only secret.
SUPABASE_SECRET_KEY=

# Encryption Configuration
# Format: base64 master key; setup generates 32 random bytes. Reuse the same key in both services; do not rotate casually.
COREZA_ENCRYPTION_KEY=

# Redis Configuration
# Format: redis://[user:password@]host:port[/db] or rediss://... for TLS; queue Redis connection.
REDIS_QUEUE_URL=redis://localhost:6379
# Format: redis://[user:password@]host:port[/db] or rediss://... for TLS; cache Redis connection.
REDIS_CACHE_URL=redis://localhost:6379
# Values: true, false (legacy setting). Current backend does not read this variable; it does not toggle the queue.
USE_BULLMQ_QUEUE=true
# Values: true, false. true forces TLS; rediss:// URLs enable TLS even when this is false.
REDIS_TLS=false
# Values: true (verify TLS certificates), false (skip certificate verification). Applies only to TLS connections.
REDIS_TLS_REJECT_UNAUTHORIZED=true

# User config
# Values: integer >= 1; total attempts including the first run (1 = no retries).
WORKFLOW_JOB_ATTEMPTS=1
# Values: integer >= 1; maximum concurrent test listeners per user.
MAX_LISTENERS_PER_USER=5
# Values: integer > 0; test listener lifetime in seconds.
LISTENER_TTL_SECONDS=300
# Values: integer > 0; default frontend polling interval in milliseconds.
DEFAULT_POLL_INTERVAL_MS=1000
# Values: integer >= 0; polling jitter in milliseconds (0 = no jitter).
POLL_JITTER_MS=200
# Values: integer > 0; listener cleanup interval in milliseconds.
LISTENER_CLEANUP_INTERVAL_MS=60000

# Runtime Ports
# Values: integer 1-65535; backend HTTP port. Keep frontend URLs in sync.
PORT=8000
# Values: integer 1-65535; backend WebSocket port. Keep VITE_BACKEND_WS_URL in sync.
WEBSOCKET_PORT=8081
# Values: integer 1-65535; market-stream HTTP port. Set in the market-stream service env. The backend does not read this variable.
MARKET_STREAM_PORT=8090

# Backtest execution mode: "auto" (default), "compiled", "engine"
# Values: auto (try compilation), compiled (prefer compilation), engine (skip compilation). Compilation failures fall back to engine; runtime fallback when unset: auto.
BACKTEST_EXECUTION_MODE=compiled
