{
  "name": "Scheduler",
  "def": "Schedule Trigger",
  "node_type": "trigger",
  "category": "Scheduler",
  "icon": "/assets/icons/scheduler.svg",
  "size": { "width": 340, "height": 200 },
  "handles": [{ "type": "source", "position": "right", "id": "output" }],
  "action": {
    "url": "/execute/scheduler",
    "method": "POST"
  },
  "fields": [
    {
      "key": "interval",
      "label": "Trigger Interval",
      "type": "select",
      "optionsSource": "static",
      "options": [
        { "label": "Minutes", "value": "Minutes" },
        { "label": "Hours", "value": "Hours" },
        { "label": "Days", "value": "Days" },
        { "label": "Weeks", "value": "Weeks" },
        { "label": "Months", "value": "Months" }
      ],
      "default": "Days",
      "required": true
    },
    {
      "key": "count",
      "label": "Interval Count",
      "type": "text",
      "placeholder": "e.g. 1",
      "default": "1",
      "required": true
    },
    {
      "key": "hour",
      "label": "Trigger at Hour",
      "type": "select",
      "optionsSource": "static",
      "options": [
        { "label": "Midnight", "value": "0" },
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" },
        { "label": "3", "value": "3" },
        { "label": "4", "value": "4" },
        { "label": "5", "value": "5" },
        { "label": "6", "value": "6" },
        { "label": "7", "value": "7" },
        { "label": "8", "value": "8" },
        { "label": "9", "value": "9" },
        { "label": "10", "value": "10" },
        { "label": "11", "value": "11" },
        { "label": "12", "value": "12" },
        { "label": "13", "value": "13" },
        { "label": "14", "value": "14" },
        { "label": "15", "value": "15" },
        { "label": "16", "value": "16" },
        { "label": "17", "value": "17" },
        { "label": "18", "value": "18" },
        { "label": "19", "value": "19" },
        { "label": "20", "value": "20" },
        { "label": "21", "value": "21" },
        { "label": "22", "value": "22" },
        { "label": "23", "value": "23" }
      ],
      "default": "0",
      "required": true
    },
    {
      "key": "minute",
      "label": "Trigger at Minute",
      "type": "text",
      "placeholder": "0",
      "default": "0",
      "required": true
    },
    {
      "key": "dow",
      "label": "Days of Week (for Weekly trigger)",
      "type": "multiselect",
      "options": [
        { "id": "0", "name": "Sunday" },
        { "id": "1", "name": "Monday" },
        { "id": "2", "name": "Tuesday" },
        { "id": "3", "name": "Wednesday" },
        { "id": "4", "name": "Thursday" },
        { "id": "5", "name": "Friday" },
        { "id": "6", "name": "Saturday" }
      ],
      "default": ["1"],
      "required": false,
      "placeholder": "Select days (only applies to Weekly interval)"
    },
    {
      "key": "timezone",
      "label": "Timezone",
      "type": "select",
      "optionsSource": "static",
      "options": [
        { "label": "UTC (Coordinated Universal Time)", "value": "UTC" },
        { "label": "America/New_York (EST/EDT)", "value": "America/New_York" },
        { "label": "America/Chicago (CST/CDT)", "value": "America/Chicago" },
        { "label": "America/Denver (MST/MDT)", "value": "America/Denver" },
        { "label": "America/Los_Angeles (PST/PDT)", "value": "America/Los_Angeles" },
        { "label": "America/Toronto", "value": "America/Toronto" },
        { "label": "America/Sao_Paulo", "value": "America/Sao_Paulo" },
        { "label": "Europe/London (GMT/BST)", "value": "Europe/London" },
        { "label": "Europe/Paris (CET/CEST)", "value": "Europe/Paris" },
        { "label": "Europe/Berlin", "value": "Europe/Berlin" },
        { "label": "Europe/Moscow", "value": "Europe/Moscow" },
        { "label": "Asia/Dubai", "value": "Asia/Dubai" },
