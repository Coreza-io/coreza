{
  "name": "AIAgent",
  "def": "AI Agent",
  "node_type": "main",
  "category": "AIAgent",
  "icon": "/assets/icons/aiagent.svg",
  "size": { "width": 380, "height": 420 },
  "collapsedSize": { "width": 320, "height": 150 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    {
      "type": "target",
      "position": "bottom",
      "id": "chatModel",
      "label": "Chat Model",
      "required": true
    },
    {
      "type": "target",
      "position": "bottom",
      "id": "memory",
      "label": "Memory"
    },
    { "type": "target", "position": "bottom", "id": "tool", "label": "Tool" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/aiagent/execute", "method": "POST" },
  "fields": [
    {
      "key": "systemPrompt",
      "label": "System Prompt",
      "type": "textarea",
      "placeholder": "You are a helpful AI assistant...",
      "default": "You are an expert quantitative financial analyst with deep knowledge of technical indicators. You have access to multiple analysis tools.",
      "required": true
    },
    {
      "key": "userPrompt",
      "label": "User Prompt",
      "type": "textarea",
      "placeholder": "Enter user message or use {{variable}}",
      "required": true
    },
    {
      "key": "maxIterations",
      "label": "Max Iterations",
      "type": "number",
      "default": 10,
      "required": false
    }
  ]
}
