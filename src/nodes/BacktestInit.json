{
  "name": "BacktestInit",
  "def": "Backtest Init",
  "node_type": "backtest",
  "icon": "/assets/icons/backtest.svg",
  "category": "Backtest",
  "description": "Initialize a backtest session with capital and simulation settings",
  "color": "text-orange-500",
  "size": {
    "width": 380,
    "height": 700
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    },
    {
      "type": "target",
      "position": "bottom",
      "id": "broker",
      "label": "Broker",
      "connectionKind": "attachment",
      "required": true
    }
  ],
  "action": {
    "url": "/backtest/init",
    "method": "POST"
  },
  "fields": [
    {
      "key": "name",
      "label": "Backtest Name",
      "type": "text",
      "placeholder": "My Strategy Backtest",
      "required": false
    },
    {
      "key": "initial_capital",
      "label": "Initial Capital ($)",
      "type": "text",
      "placeholder": "10000",
      "default": "10000",
      "required": true
    },
    {
      "key": "warmup_period",
      "label": "Pre-Start Warm-Up (bars)",
      "type": "text",
      "placeholder": "200",
      "default": "200",
      "description": "Number of historical bars strictly before Start Date used to initialize indicators and rolling windows. Set to 0 to disable warm-up.",
      "required": false
    },
    {
      "key": "warmup_mode",
      "label": "Warm-Up Mode",
      "type": "select",
      "options": [
        {
          "id": "seed",
          "name": "Direct Seed (Compatibility)"
        },
        {
          "id": "workflow_replay",
          "name": "Workflow Replay"
        }
      ],
      "default": "seed",
      "description": "Replay runs pre-start bars through the strategy workflow; direct seed preserves legacy behavior.",
      "required": false
    },
    {
      "key": "fill_model",
      "label": "Fill Model",
      "type": "select",
      "options": [
        {
          "id": "next_bar_open",
          "name": "Next Bar Open (Realistic)"
        },
        {
          "id": "immediate",
          "name": "Immediate (Current Close)"
        }
      ],
      "default": "next_bar_open",
      "required": true
    },
    {
      "key": "slippage_model",
      "label": "Slippage Model",
      "type": "select",
      "options": [
        {
          "id": "none",
          "name": "None"
        },
        {
          "id": "fixed",
          "name": "Fixed ($)"
        },
        {
          "id": "percentage",
          "name": "Percentage (%)"
        }
      ],
      "default": "percentage",
      "required": true
    },
    {
      "key": "slippage_value",
      "label": "Slippage Value",
      "type": "text",
      "placeholder": "0.001 (0.1%)",
      "default": "0.001",
      "required": false
    },
    {
      "key": "commission_model",
      "label": "Commission Model",
      "type": "select",
      "options": [
        {
          "id": "none",
          "name": "None (Zero Commission)"
        },
        {
          "id": "per_share",
          "name": "Per Share ($)"
        },
        {
          "id": "percentage",
          "name": "Percentage (%)"
        },
        {
          "id": "fixed",
          "name": "Fixed Per Trade ($)"
        }
      ],
      "default": "per_share",
      "required": true
    },
    {
      "key": "commission_value",
      "label": "Commission Value",
      "type": "text",
      "placeholder": "0.01 ($0.01/share)",
      "default": "0.01",
      "required": false
    }
  ]
}
