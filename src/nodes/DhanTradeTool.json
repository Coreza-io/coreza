{
  "name": "DhanTradeTool",
  "def": "Dhan Trade",
  "node_type": "sub",
  "icon": "/assets/icons/dhan.svg",
  "category": "Tool",
  "subCategory": "Dhan",
  "description": "Execute trades through Dhan (Indian broker). Supports NSE/BSE equity and F&O with market and limit orders.",
  "color": "text-blue-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Dhan"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Dhan API Key"
    },
    {
      "key": "client_id",
      "label": "Client ID",
      "type": "text",
      "placeholder": "Your Dhan Client ID"
    }
  ],
  "authAction": {
    "url": "/broker/dhan/auth",
    "method": "POST"
  },
  "action": {
    "url": "/broker/dhan/place_order",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "hidden",
      "default": "place_order"
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "description": "Your saved Dhan API credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "symbol",
      "label": "Ticker Symbol",
      "type": "text",
      "placeholder": "e.g. RELIANCE",
      "description": "NSE/BSE stock symbol (e.g., RELIANCE, TCS, INFY).",
      "required": true,
      "showDescription": false
    },
    {
      "key": "exchange_segment",
      "label": "Exchange Segment",
      "type": "select",
      "options": [
        {
          "id": "NSE_EQ",
          "name": "NSE Equity"
        },
        {
          "id": "BSE_EQ",
          "name": "BSE Equity"
        },
        {
          "id": "NSE_FNO",
          "name": "NSE F&O"
        },
        {
          "id": "BSE_FNO",
          "name": "BSE F&O"
        }
      ],
      "default": "NSE_EQ",
      "description": "Exchange and segment: NSE/BSE for equities, FNO for futures & options.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "id": "buy",
          "name": "Buy"
        },
        {
          "id": "sell",
          "name": "Sell"
        }
      ],
      "default": "buy",
      "description": "Buy to open/add position, Sell to close/reduce position.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "description": "Number of shares/lots to trade.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market"
        },
        {
          "id": "limit",
          "name": "Limit"
        }
      ],
      "default": "market",
      "description": "Market executes immediately at best price, Limit waits for specified price.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "validity",
      "label": "Validity",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "ioc",
          "name": "Immediate Or Cancel"
        }
      ],
      "default": "day",
      "description": "Day order valid until market close, IOC fills immediately or cancels.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "Required for limit orders",
      "description": "Limit price for the order.",
      "required": false,
      "showDescription": false
    }
  ]
}
