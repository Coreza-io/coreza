{
  "name": "FinnHubTool",
  "def": "FinnHub Market Data",
  "node_type": "sub",
  "icon": "/assets/icons/FinnHub.svg",
  "category": "Tool",
  "subCategory": "FinnHub",
  "description": "Fetch real-time stock quotes from FinnHub. Returns current price, open, high, low, previous close, and change percentage.",
  "color": "text-orange-500",
  "size": {
    "width": 340,
    "height": 280
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "Personal FinnHub"
    },
    {
      "key": "api_key",
      "label": "FinnHub API Key",
      "type": "password",
      "placeholder": "API Secret key"
    }
  ],
  "authAction": {
    "url": "/finnhub/auth",
    "method": "POST"
  },
  "action": {
    "url": "/finnhub/get-quote",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "description": "Your saved FinnHub API credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "ticker",
      "label": "Ticker Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "description": "Stock ticker symbol to fetch real-time quote for.",
      "required": true,
      "showDescription": false
    }
  ]
}
