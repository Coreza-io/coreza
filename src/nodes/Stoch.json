{
  "name": "Stochastic Oscillator",
  "def": "Stochastic Oscillator",
  "node_type": "main",
  "icon": "/assets/icons/stochastic.svg",
  "category": "Indicators",
  "description": "Stochastic Oscillator for identifying overbought/oversold conditions and price momentum",
  "color": "text-green-500",
  "size": {
    "width": 340,
    "height": 320
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/stochastic",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "The ticker symbol for the asset being analyzed (e.g. AAPL, BTCUSDT)."
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true,
      "description": "The timeframe/interval of the candle data (e.g. 1m, 5m, 1h, 1d)."
    },
    {
      "key": "k_period",
      "label": "%K Period",
      "type": "text",
      "default": "14",
      "placeholder": "e.g. 14",
      "required": true,
      "description": "Lookback period for %K."
    },
    {
      "key": "d_period",
      "label": "%D Period (SMA)",
      "type": "text",
      "default": "3",
      "placeholder": "e.g. 3",
      "required": true,
      "description": "Smoothing for %D signal line."
    },
    {
      "key": "smooth",
      "label": "Smoothing Factor",
      "type": "text",
      "default": "3",
      "placeholder": "e.g. 3",
      "required": true,
      "description": "Additional %K smoothing."
    }
  ]
}
