{
  "id": "rsi",
  "name": "RSI",
  "label": "Relative Strength Index",

  "meta": {
    "role": "action",
    "execution": "http",
    "tier": "main",
    "domain": "indicators",
    "provider": {
      "type": "internal",
      "name": "indicators"
    }
  },

  "ui": {
    "icon": "/assets/icons/rsi.svg",
    "color": "text-blue-500",
    "size": { "width": 300, "height": 220 },
    "description": "Relative Strength Index technical indicator"
  },

  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],

  "action": {
    "url": "/indicators/rsi",
    "method": "POST"
  },

  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "window",
      "label": "RSI Period",
      "type": "text",
      "placeholder": "e.g. 14",
      "default": "14",
      "required": true
    }
  ]
}
