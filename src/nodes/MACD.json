{
  "name": "MACD",
  "def": "Moving Average Convergence Divergence",
  "node_type": "main",
  "icon": "/assets/icons/macd.svg",
  "category": "Indicators",
  "subcategory": "Trend Indicators",
  "description": "MACD (Moving Average Convergence Divergence) indicator to measure momentum and trend strength",
  "color": "text-purple-500",
  "size": {
    "width": 320,
    "height": 320
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/macd",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true
    },
    {
      "key": "fastPeriod",
      "label": "Fast EMA Period",
      "type": "text",
      "placeholder": "e.g. 12",
      "default": "12",
      "required": true
    },
    {
      "key": "slowPeriod",
      "label": "Slow EMA Period",
      "type": "text",
      "placeholder": "e.g. 26",
      "default": "26",
      "required": true
    },
    {
      "key": "signalPeriod",
      "label": "Signal Line EMA",
      "type": "text",
      "placeholder": "e.g. 9",
      "default": "9",
      "required": true
    }
  ]
}
