{
  "name": "Visualize",
  "def": "Visualize Candles & Signals",
  "node_type": "main",
  "category": "Visualization",
  "icon": "/assets/icons/visualize.svg",
  "size": {
    "width": 580,
    "height": 800
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "fields": [
    {
      "key": "candles",
      "label": "Candle Data",
      "type": "string",
      "placeholder": "{{ $('Alpaca').json.data.BarSeries[0].bars }}",
      "required": false
    },
    {
      "key": "overlays",
      "label": "Overlays",
      "type": "repeater",
      "subFields": [
        {
          "key": "name",
          "type": "string",
          "placeholder": "BB(20,2)"
        },
        {
          "key": "data",
          "type": "string",
          "placeholder": "{{ $('BB').json.data }}"
        },
        {
          "key": "indicatorType",
          "label": "Indicator",
          "type": "select",
          "options": [
            {
              "id": "auto",
              "name": "Auto detect"
            },
            {
              "id": "rsi",
              "name": "RSI"
            },
            {
              "id": "ema",
              "name": "EMA"
            },
            {
              "id": "sma",
              "name": "SMA"
            },
            {
              "id": "macd",
              "name": "MACD"
            },
            {
              "id": "bb",
              "name": "Bollinger Bands"
            },
            {
              "id": "adx",
              "name": "ADX"
            },
            {
              "id": "stoch",
              "name": "Stochastic"
            },
            {
              "id": "vwap",
              "name": "VWAP"
            },
            {
              "id": "obv",
              "name": "OBV"
            },
            {
              "id": "volume_oscillator",
              "name": "Volume Oscillator"
            },
            {
              "id": "pvo",
              "name": "PVO"
            },
            {
              "id": "ichimoku",
              "name": "Ichimoku"
            },
            {
              "id": "support_resistance",
              "name": "Support & Resistance"
            }
          ],
          "default": "auto"
        },
        {
          "key": "render",
          "type": "select",
          "options": [
            {
              "id": "Auto",
              "name": "Auto"
            },
            {
              "id": "Line",
              "name": "Line"
            },
            {
              "id": "Bands",
              "name": "Bands"
            },
            {
              "id": "Levels",
              "name": "Levels"
            },
            {
              "id": "Panel",
              "name": "Panel"
            }
          ],
          "default": "Auto"
        },
        {
          "key": "color",
          "type": "string",
          "placeholder": "#3b82f6"
        }
      ],
      "default": []
    }
  ]
}
