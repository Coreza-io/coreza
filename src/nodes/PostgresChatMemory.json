{
  "name": "PostgresChatMemory",
  "def": "Postgres Chat Memory",
  "node_type": "sub",
  "category": "Memory",
  "icon": "/assets/icons/store.svg",
  "description": "Stores chat history in the auto-provisioned `public.coreza_chat_history` Supabase table. Run `setup/setup.js` (or `setup/database-schema.sql`) if the table is missing. Use a Supabase Secret Key (`sb_secret_…`) — legacy `service_role` JWTs are also accepted.",
  "size": {
    "width": 320,
    "height": 260
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "memory"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Supabase",
      "placeholder": "e.g., Production Supabase"
    },
    {
      "key": "supabase_url",
      "label": "Supabase URL",
      "type": "text",
      "placeholder": "https://xxxx.supabase.co",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Supabase Secret Key",
      "type": "password",
      "placeholder": "sb_secret_… (or legacy service_role JWT)",
      "required": true
    }
  ],
  "authAction": {
    "url": "/storage/supabase/auth",
    "method": "POST"
  },
  "subCategory": "Supabase",
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "optionsSourceParams": {
        "service_type": "supabase"
      },
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "sessionKey",
      "label": "Session Key",
      "type": "hidden",
      "default": ""
    },
    {
      "key": "tableName",
      "label": "Table Name",
      "type": "string",
      "default": "coreza_chat_history",
      "required": true,
      "disabled": true,
      "description": "Managed table for chat history. Provisioned by setup with columns: `id`, `session_id`, `message` (jsonb), `created_at`."
    },
    {
      "key": "contextWindowLength",
      "label": "Context Window Length",
      "type": "number",
      "default": 5,
      "required": true,
      "description": "Number of most recent user/assistant turns loaded into the prompt (\u2248 2\u00d7 messages)."
    }
  ]
}
