{
  "name": "VectorizedIndicators",
  "def": "Calculate multiple indicators on entire dataset in one pass",
  "node_type": "main",
  "icon": "/assets/icons/rsi.svg",
  "category": "Indicators",
  "subcategory": "Backtesting",
  "description": "Pre-calculate selected indicators for an entire bar array - optimized for backtesting",
  "color": "text-emerald-500",
  "size": { "width": 380, "height": 400 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": {
    "url": "/indicators/vectorized",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data Array",
      "type": "text",
      "required": true,
      "description": "Reference to historical bar data (e.g., {{ $('YahooFinance').json.data }})"
    },
    {
      "key": "indicators",
      "label": "Indicators to Calculate",
      "type": "multiselect",
      "required": true,
      "options": [
        { "label": "RSI", "value": "rsi" },
        { "label": "EMA", "value": "ema" },
        { "label": "SMA", "value": "sma" },
        { "label": "MACD", "value": "macd" },
        { "label": "Bollinger Bands", "value": "bb" },
        { "label": "Stochastic", "value": "stochastic" },
        { "label": "VWAP", "value": "vwap" },
        { "label": "ADX", "value": "adx" },
        { "label": "OBV", "value": "obv" }
      ]
    },
    {
      "key": "rsi_period",
      "label": "RSI Period",
      "type": "text",
      "default": "14",
      "displayOptions": { "show": { "indicators": ["rsi"] } }
    },
    {
      "key": "ema_period",
      "label": "EMA Period",
      "type": "text",
      "default": "20",
      "displayOptions": { "show": { "indicators": ["ema"] } }
    },
    {
      "key": "sma_period",
      "label": "SMA Period",
      "type": "text",
      "default": "50",
      "displayOptions": { "show": { "indicators": ["sma"] } }
    },
    {
      "key": "macd_fast",
      "label": "MACD Fast Period",
      "type": "text",
      "default": "12",
      "displayOptions": { "show": { "indicators": ["macd"] } }
    },
    {
      "key": "macd_slow",
      "label": "MACD Slow Period",
      "type": "text",
      "default": "26",
      "displayOptions": { "show": { "indicators": ["macd"] } }
    },
    {
      "key": "macd_signal",
      "label": "MACD Signal Period",
      "type": "text",
      "default": "9",
      "displayOptions": { "show": { "indicators": ["macd"] } }
    },
    {
      "key": "bb_period",
      "label": "Bollinger Period",
      "type": "text",
      "default": "20",
      "displayOptions": { "show": { "indicators": ["bb"] } }
    },
    {
      "key": "bb_stddev",
      "label": "Bollinger Std Dev",
      "type": "text",
      "default": "2",
      "displayOptions": { "show": { "indicators": ["bb"] } }
    },
    {
      "key": "stoch_k",
      "label": "Stochastic %K Period",
      "type": "text",
      "default": "14",
      "displayOptions": { "show": { "indicators": ["stochastic"] } }
    },
    {
      "key": "stoch_d",
      "label": "Stochastic %D Period",
      "type": "text",
      "default": "3",
      "displayOptions": { "show": { "indicators": ["stochastic"] } }
    },
    {
      "key": "adx_period",
      "label": "ADX Period",
      "type": "text",
      "default": "14",
      "displayOptions": { "show": { "indicators": ["adx"] } }
    }
  ]
}
