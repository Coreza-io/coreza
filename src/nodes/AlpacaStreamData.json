{
  "name": "AlpacaStreamData",
  "def": "Alpaca Stream Data",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Broker",
  "subCategory": "Alpaca",
  "executionMode": "streaming",
  "streamingConfig": {
    "waitForFirstEvent": true,
    "timeout": 30000
  },
  "description": "Subscribe to real-time market data streams (trades, quotes, bars) from Alpaca",
  "color": "text-yellow-500",
  "size": {
    "width": 380,
    "height": 340
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/websocket/alpaca_stream/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "subscribe",
          "name": "Subscribe",
          "method": "POST"
        },
        {
          "id": "unsubscribe",
          "name": "Unsubscribe",
          "method": "POST"
        }
      ],
      "required": true
    },
    {
      "key": "stream_types",
      "label": "Stream Types",
      "type": "multiselect",
      "options": [
        {
          "id": "trades",
          "name": "Trades"
        },
        {
          "id": "quotes",
          "name": "Quotes"
        },
        {
          "id": "bars",
          "name": "Minute Bars"
        },
        {
          "id": "dailyBars",
          "name": "Daily Bars"
        }
      ],
      "default": ["trades"],
      "description": "Select data stream types to subscribe to",
      "required": true
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "e.g. AAPL,MSFT,TSLA or * for all",
      "description": "Comma-separated symbols or * for all symbols",
      "required": true
    }
  ]
}
