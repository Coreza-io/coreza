{
  "name": "FMPTool",
  "def": "Fundamental Data",
  "description": "Fetch comprehensive fundamental data from Financial Modeling Prep (FMP)",
  "node_type": "tool",
  "category": "Data",
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My FMP API"
    },
    {
      "key": "api_key",
      "label": "FMP API Key",
      "type": "password",
      "placeholder": "Your FMP API key"
    }
  ],
  "authAction": { "url": "/fmp/auth", "method": "POST" },
  "icon": "/assets/icons/fmp.svg",
  "size": { "width": 340, "height": 580 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/fmp/execute", "method": "POST" },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "id": "profile", "name": "Company Profile" },
        { "id": "quote", "name": "Stock Quote" },
        { "id": "stock_screener", "name": "Stock Screener" },
        { "id": "income_statement", "name": "Income Statement" },
        { "id": "balance_sheet", "name": "Balance Sheet" },
        { "id": "cash_flow", "name": "Cash Flow Statement" },
        { "id": "key_metrics", "name": "Key Metrics" },
        { "id": "ratios", "name": "Financial Ratios" },
        { "id": "financial_growth", "name": "Financial Growth" },
        { "id": "financial_scores", "name": "Financial Scores (Z-Score, Piotroski)" },
        { "id": "enterprise_value", "name": "Enterprise Value" },
        { "id": "stock_peers", "name": "Stock Peers" },
        { "id": "analyst_estimates", "name": "Analyst Estimates" },
        { "id": "price_target", "name": "Price Target" },
        { "id": "earnings_calendar", "name": "Earnings Calendar" },
        { "id": "dividends", "name": "Dividends" },
        { "id": "splits", "name": "Stock Splits" },
        { "id": "news", "name": "Stock News" },
        { "id": "insider_trading", "name": "Insider Trading" },
        { "id": "institutional_holders", "name": "Institutional Holders" }
      ],
      "default": "profile",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "displayOptions": {
        "hide": {
          "operation": ["stock_screener"]
        }
      }
    },
    {
      "key": "period",
      "label": "Period",
      "type": "select",
      "options": [
        { "id": "annual", "name": "Annual" },
        { "id": "quarter", "name": "Quarterly" }
      ],
      "default": "annual",
      "displayOptions": {
        "show": {
          "operation": [
            "income_statement", "balance_sheet", "cash_flow",
            "key_metrics", "ratios", "financial_growth"
          ]
        }
      }
    },
    {
      "key": "limit",
      "label": "Limit (Results)",
      "type": "text",
      "placeholder": "10",
      "default": "10",
      "displayOptions": {
        "show": {
          "operation": [
            "income_statement", "balance_sheet", "cash_flow",
            "key_metrics", "ratios", "financial_growth",
            "analyst_estimates", "price_target", "earnings_calendar",
            "dividends", "splits", "news", "insider_trading", "stock_screener"
          ]
        }
      }
    },
    {
      "key": "market_cap_more_than",
      "label": "Min Market Cap",
      "type": "text",
      "placeholder": "e.g. 1000000000 (1B)",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "market_cap_lower_than",
      "label": "Max Market Cap",
      "type": "text",
      "placeholder": "e.g. 10000000000 (10B)",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "price_more_than",
      "label": "Min Price",
      "type": "text",
      "placeholder": "e.g. 10",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "price_lower_than",
      "label": "Max Price",
      "type": "text",
      "placeholder": "e.g. 500",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "beta_more_than",
      "label": "Min Beta",
      "type": "text",
      "placeholder": "e.g. 0.5",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "beta_lower_than",
      "label": "Max Beta",
      "type": "text",
      "placeholder": "e.g. 2.0",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "volume_more_than",
      "label": "Min Volume",
      "type": "text",
      "placeholder": "e.g. 1000000",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "dividend_more_than",
      "label": "Min Dividend Yield",
      "type": "text",
      "placeholder": "e.g. 0.02 (2%)",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "dividend_lower_than",
      "label": "Max Dividend Yield",
      "type": "text",
      "placeholder": "e.g. 0.10 (10%)",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "sector",
      "label": "Sector",
      "type": "select",
      "options": [
        { "id": "", "name": "All Sectors" },
        { "id": "Technology", "name": "Technology" },
        { "id": "Healthcare", "name": "Healthcare" },
        { "id": "Financial Services", "name": "Financial Services" },
        { "id": "Consumer Cyclical", "name": "Consumer Cyclical" },
        { "id": "Consumer Defensive", "name": "Consumer Defensive" },
        { "id": "Industrials", "name": "Industrials" },
        { "id": "Energy", "name": "Energy" },
        { "id": "Basic Materials", "name": "Basic Materials" },
        { "id": "Communication Services", "name": "Communication Services" },
        { "id": "Real Estate", "name": "Real Estate" },
        { "id": "Utilities", "name": "Utilities" }
      ],
      "default": "",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "industry",
      "label": "Industry",
      "type": "text",
      "placeholder": "e.g. Software—Application",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "country",
      "label": "Country",
      "type": "text",
      "placeholder": "e.g. US, CA, GB",
      "default": "US",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "exchange",
      "label": "Exchange",
      "type": "select",
      "options": [
        { "id": "", "name": "All Exchanges" },
        { "id": "NYSE", "name": "NYSE" },
        { "id": "NASDAQ", "name": "NASDAQ" },
        { "id": "AMEX", "name": "AMEX" }
      ],
      "default": "",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "is_etf",
      "label": "Include ETFs",
      "type": "select",
      "options": [
        { "id": "", "name": "Include All" },
        { "id": "true", "name": "ETFs Only" },
        { "id": "false", "name": "Exclude ETFs" }
      ],
      "default": "false",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    },
    {
      "key": "is_actively_trading",
      "label": "Actively Trading",
      "type": "select",
      "options": [
        { "id": "", "name": "All" },
        { "id": "true", "name": "Active Only" },
        { "id": "false", "name": "Inactive Only" }
      ],
      "default": "true",
      "displayOptions": {
        "show": { "operation": ["stock_screener"] }
      }
    }
  ]
}
