{
  "name": "AlpacaScreenerTool",
  "def": "Alpaca Screener",
  "node_type": "sub",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Tool",
  "subCategory": "Alpaca",
  "description": "Screen stocks using Alpaca's Most Actives and Market Movers APIs",
  "color": "text-yellow-500",
  "size": { "width": 340, "height": 280 },
  "handles": [
    { "type": "source", "position": "top", "id": "tool" }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password"
    }
  ],
  "authAction": { "url": "/broker/alpaca/auth", "method": "POST" },
  "action": {
    "url": "/screener/alpaca/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "required": true
    },
    {
      "key": "operation",
      "label": "Screener Type",
      "type": "select",
      "options": [
        { "id": "most_actives", "name": "Most Actives" },
        { "id": "market_movers", "name": "Market Movers" }
      ],
      "default": "most_actives",
      "required": true
    },
    {
      "key": "market_type",
      "label": "Market Type",
      "type": "select",
      "options": [
        { "id": "stocks", "name": "Stocks" },
        { "id": "crypto", "name": "Crypto" }
      ],
      "default": "stocks",
      "displayOptions": {
        "show": {
          "operation": ["market_movers"]
        }
      }
    },
    {
      "key": "top",
      "label": "Number of Results",
      "type": "text",
      "placeholder": "10",
      "default": "10",
      "description": "Number of results to return"
    },
    {
      "key": "by",
      "label": "Sort By",
      "type": "select",
      "options": [
        { "id": "volume", "name": "Volume" },
        { "id": "trades", "name": "Trades" }
      ],
      "default": "volume",
      "displayOptions": {
        "show": {
          "operation": ["most_actives"]
        }
      }
    }
  ]
}