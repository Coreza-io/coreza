{
  "name": "OpenAIChatModel",
  "def": "OpenAI Chat Model",
  "node_type": "sub",
  "category": "ChatModel",
  "provider": "openai",
  "icon": "/assets/icons/openai.svg",
  "size": { "width": 300, "height": 320 },
  "handles": [{ "type": "source", "position": "top", "id": "chatModel" }],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "OpenAI API"
    },
    {
      "key": "apiKey",
      "label": "OpenAI API Key",
      "type": "password",
      "placeholder": "sk-..."
    }
  ],
  "authAction": { "url": "/openai/auth", "method": "POST" },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "default": "gpt-5.4-mini",
      "options": [
        {
          "label": "GPT-5.5",
          "value": "gpt-5.5",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5.4",
          "value": "gpt-5.4",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5.4 Mini",
          "value": "gpt-5.4-mini",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5.4 Nano",
          "value": "gpt-5.4-nano",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5",
          "value": "gpt-5",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5 Mini",
          "value": "gpt-5-mini",
          "supportsReasoning": true
        },
        {
          "label": "GPT-5 Nano",
          "value": "gpt-5-nano",
          "supportsReasoning": true
        },
        {
          "label": "GPT-4.1",
          "value": "gpt-4.1"
        },
        {
          "label": "GPT-4.1 Mini",
          "value": "gpt-4.1-mini"
        },
        {
          "label": "GPT-4o",
          "value": "gpt-4o"
        },
        {
          "label": "GPT-4o Mini",
          "value": "gpt-4o-mini"
        }
      ],
      "required": true
    },
    {
      "key": "reasoningEffort",
      "label": "Reasoning Effort",
      "type": "select",
      "default": "medium",
      "options": [
        { "id": "none", "name": "None" },
        { "id": "low", "name": "Low" },
        { "id": "medium", "name": "Medium" },
        { "id": "high", "name": "High" },
        { "id": "xhigh", "name": "Extra High" }
      ],
      "description": "Reasoning effort for GPT-5 family models. Use low for speed, medium as default, high/xhigh for complex analysis.",
      "displayOptions": {
        "show": {
          "model": [
            "gpt-5.5",
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.4-nano",
            "gpt-5",
            "gpt-5-mini",
            "gpt-5-nano"
          ]
        }
      },
      "required": false
    },
    {
      "key": "temperature",
      "label": "Temperature",
      "type": "number",
      "default": 1,
      "description": "Controls randomness. Use lower values for deterministic tool execution.",
      "displayOptions": {
        "show": {
          "model": [
            "gpt-4.1",
            "gpt-4.1-mini",
            "gpt-4o",
            "gpt-4o-mini",
            "gpt-4-turbo",
            "gpt-3.5-turbo"
          ]
        }
      },
      "required": false
    },
    {
      "key": "maxTokens",
      "label": "Max Tokens",
      "type": "number",
      "default": 1000,
      "required": false
    }
  ]
}
