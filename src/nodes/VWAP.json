{
  "name": "VWAP",
  "def": "Volume-Weighted Average Price",
  "node_type": "main",
  "icon": "/assets/icons/vwap.svg",
  "category": "Indicators",
  "description": "VWAP indicator to identify average price levels weighted by volume over a time frame",
  "color": "text-indigo-500",
  "size": {
    "width": 320,
    "height": 300
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/vwap",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "The ticker symbol for the asset being analyzed (e.g. AAPL, BTCUSDT)."
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true,
      "description": "The timeframe/interval of the candle data (e.g. 1m, 5m, 1h, 1d)."
    },
    {
      "key": "session_type",
      "label": "VWAP Session Type",
      "type": "select",
      "options": [
        {
          "id": "daily",
          "name": "Daily Session VWAP"
        },
        {
          "id": "weekly",
          "name": "Weekly VWAP"
        },
        {
          "id": "custom",
          "name": "Custom Range VWAP"
        }
      ],
      "default": "daily",
      "required": true,
      "description": "Time period for VWAP calculation. Daily resets each day, Weekly spans the week, Custom uses specified start time."
    },
    {
      "key": "custom_start_time",
      "label": "Custom Start Time (UTC)",
      "type": "text",
      "placeholder": "e.g. 2025-07-18T09:30:00Z",
      "required": false,
      "displayOptions": {
        "show": {
          "session_type": [
            "custom"
          ]
        }
      },
      "description": "Start time for custom VWAP range in ISO 8601 format. Only used when session_type is 'custom'."
    }
  ]
}
