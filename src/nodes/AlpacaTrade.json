{
  "name": "AlpacaTrade",
  "def": "Alpaca Trade",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Broker",
  "subCategory": "Alpaca",
  "description": "Execute trades through Alpaca Markets",
  "color": "text-red-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/broker/alpaca/place_order",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "place_order",
          "name": "Place Order"
        },
        {
          "id": "close_position",
          "name": "Close Position"
        }
      ],
      "default": "place_order",
      "required": true
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        { "id": "paper", "name": "Paper" },
        { "id": "live", "name": "Live" }
      ],
      "default": "paper",
      "required": true
    },
    {
      "key": "asset_type",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "stock",
          "name": "Stock"
        },
        {
          "id": "crypto",
          "name": "Crypto"
        }
      ],
      "default": "stock",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Stock Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": ["stock"]
        }
      }
    },
    {
      "key": "crypto_base",
      "label": "Base Asset",
      "type": "text",
      "placeholder": "e.g. BTC, ETH",
      "description": "The cryptocurrency to trade (e.g. BTC, ETH, DOGE).",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": ["crypto"]
        }
      }
    },
    {
      "key": "crypto_quote",
      "label": "Quote Currency",
      "type": "select",
      "options": [
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "BTC",
          "name": "BTC"
        }
      ],
      "default": "USD",
      "description": "The currency to price against.",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": ["crypto"]
        }
      }
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "id": "buy",
          "name": "Buy"
        },
        {
          "id": "sell",
          "name": "Sell"
        }
      ],
      "default": "buy",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["place_order"]
        }
      }
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": ["place_order", "close_position"]
        }
      }
    },
    {
      "key": "percentage",
      "label": "Percentage",
      "type": "text",
      "placeholder": "e.g. 50",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": ["close_position"]
        }
      }
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market Order"
        },
        {
          "id": "limit",
          "name": "Limit Order"
        },
        {
          "id": "stop",
          "name": "Stop Order"
        },
        {
          "id": "trailing_stop",
          "name": "Trailing Stop Order"
        }
      ],
      "default": "market",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["place_order"]
        }
      }
    },
    {
      "key": "limit_price",
      "label": "Limit Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 1",
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "type": "limit"
        }
      }
    },
    {
      "key": "stop_price",
      "label": "Stop Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 1",
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "type": "stop"
        }
      }
    },
    {
      "key": "trail_price",
      "label": "Trailing Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 0.20",
      "description": "Dollar amount to trail. Required if trail_percent is not provided",
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "trail_percent",
      "label": "Trailing Percentage",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 0.20",
      "description": "Percentage to trail (0-1). Required if trail_price is not provided",
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "time_in_force",
      "label": "Time In Force",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "gtc",
          "name": "Good Till Cancelled (GTC)"
        },
        {
          "id": "opg",
          "name": "Market/Limit on Open (OPG)"
        },
        {
          "id": "cls",
          "name": "Market/Limit on Close (CLS)"
        },
        {
          "id": "ioc",
          "name": "Immediate Or Cancel (IOC)"
        },
        {
          "id": "fok",
          "name": "Fill Or Kill (FOK)"
        }
      ],
      "default": "day",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "asset_type": ["stock", "crypto"]
        }
      }
    },
    {
      "key": "extended_hours",
      "label": "Extended Hours",
      "type": "select",
      "options": [
        {
          "id": "false",
          "name": "Regular Hours Only"
        },
        {
          "id": "true",
          "name": "Include Pre/After Market"
        }
      ],
      "default": "false",
      "required": false,
      "description": "Enable execution during pre-market and after-hours. Only available for limit orders with day time-in-force.",
      "displayOptions": {
        "show": {
          "operation": ["place_order"],
          "type": ["limit"],
          "time_in_force": ["day"],
          "asset_type": ["stock"]
        }
      },
      "showDescription": false
    }
  ]
}
