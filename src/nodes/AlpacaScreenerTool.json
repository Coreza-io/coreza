{
  "name": "AlpacaScreenerTool",
  "def": "Alpaca Screener",
  "node_type": "sub",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Tool",
  "subCategory": "Alpaca",
  "description": "Screen stocks using Alpaca's Most Actives and Market Movers APIs. Find top traded stocks by volume or trade count, and biggest gainers/losers.",
  "color": "text-yellow-500",
  "size": {
    "width": 340,
    "height": 280
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/screener/alpaca/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "description": "Your saved Alpaca API credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "operation",
      "label": "Screener Type",
      "type": "select",
      "options": [
        {
          "id": "most_actives",
          "name": "Most Actives"
        },
        {
          "id": "market_movers",
          "name": "Market Movers"
        }
      ],
      "default": "most_actives",
      "description": "Most Actives: highest volume/trades. Market Movers: biggest price changes (gainers/losers).",
      "required": true,
      "showDescription": false
    },
    {
      "key": "assetType",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "stock",
          "name": "Stock"
        },
        {
          "id": "crypto",
          "name": "Crypto"
        }
      ],
      "default": "stock",
      "description": "Asset class to screen: US stocks or cryptocurrency.",
      "displayOptions": {
        "show": {
          "operation": ["market_movers"]
        }
      },
      "showDescription": false
    },
    {
      "key": "top",
      "label": "Number of Results",
      "type": "text",
      "placeholder": "10",
      "default": "10",
      "description": "Maximum number of results to return (1-100).",
      "showDescription": false
    },
    {
      "key": "by",
      "label": "Sort By",
      "type": "select",
      "options": [
        {
          "id": "volume",
          "name": "Volume"
        },
        {
          "id": "trades",
          "name": "Trades"
        }
      ],
      "default": "volume",
      "description": "Ranking criteria: by dollar volume traded or by number of trades.",
      "displayOptions": {
        "show": {
          "operation": ["most_actives"]
        }
      },
      "showDescription": false
    }
  ]
}
