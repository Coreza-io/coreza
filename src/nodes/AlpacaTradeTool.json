{
  "name": "AlpacaTradeTool",
  "def": "Alpaca Trade",
  "node_type": "sub",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Tool",
  "subCategory": "Alpaca",
  "description": "Execute stock and crypto trades through Alpaca Markets. Supports market, limit, stop, and trailing stop orders.",
  "color": "text-red-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/broker/alpaca/place_order",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "hidden",
      "default": "place_order"
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "description": "Your saved Alpaca API credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "asset_type",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "stock",
          "name": "Stock"
        },
        {
          "id": "crypto",
          "name": "Crypto"
        }
      ],
      "default": "stock",
      "description": "Type of asset to trade: US stocks or cryptocurrency.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "description": "Stock symbol (e.g., AAPL).",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": [
            "stock"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "crypto_base",
      "label": "Base Asset",
      "type": "text",
      "placeholder": "e.g. BTC, ETH",
      "description": "The cryptocurrency to trade (e.g. BTC, ETH, DOGE).",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": [
            "crypto"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "crypto_quote",
      "label": "Quote Currency",
      "type": "select",
      "options": [
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "BTC",
          "name": "BTC"
        }
      ],
      "default": "USD",
      "description": "The currency to price against.",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": [
            "crypto"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "id": "buy",
          "name": "Buy"
        },
        {
          "id": "sell",
          "name": "Sell"
        }
      ],
      "default": "buy",
      "description": "Buy to open/add position, Sell to close/reduce position.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "description": "Number of shares/units to trade. Supports fractional for crypto.",
      "required": false,
      "showDescription": false
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market Order"
        },
        {
          "id": "limit",
          "name": "Limit Order"
        },
        {
          "id": "stop",
          "name": "Stop Order"
        },
        {
          "id": "trailing_stop",
          "name": "Trailing Stop Order"
        }
      ],
      "default": "market",
      "description": "Market executes immediately, Limit at specified price, Stop triggers at price, Trailing Stop follows price.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "limit_price",
      "label": "Limit Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 150.00",
      "description": "Price for limit order. Order fills at this price or better.",
      "displayOptions": {
        "show": {
          "type": "limit"
        }
      },
      "showDescription": false
    },
    {
      "key": "stop_price",
      "label": "Stop Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 145.00",
      "description": "Trigger price for stop order. Order activates when price reaches this level.",
      "displayOptions": {
        "show": {
          "type": "stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "trail_price",
      "label": "Trailing Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 0.20",
      "description": "Dollar amount to trail below/above market. Required if trail_percent not provided.",
      "displayOptions": {
        "show": {
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "trail_percent",
      "label": "Trailing Percentage",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 1.5",
      "description": "Percentage to trail (e.g., 1.5 for 1.5%). Required if trail_price not provided.",
      "displayOptions": {
        "show": {
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "time_in_force",
      "label": "Time In Force",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "gtc",
          "name": "Good Till Cancelled (GTC)"
        },
        {
          "id": "opg",
          "name": "Market/Limit on Open (OPG)"
        },
        {
          "id": "cls",
          "name": "Market/Limit on Close (CLS)"
        },
        {
          "id": "ioc",
          "name": "Immediate Or Cancel (IOC)"
        },
        {
          "id": "fok",
          "name": "Fill Or Kill (FOK)"
        }
      ],
      "default": "day",
      "description": "How long order stays active. Day expires at market close, GTC stays until filled/cancelled.",
      "required": true,
      "displayOptions": {
        "show": {
          "asset_type": [
            "stock"
          ]
        }
      },
      "showDescription": false
    },
    {
      "key": "extended_hours",
      "label": "Extended Hours",
      "type": "select",
      "options": [
        {
          "id": "false",
          "name": "Regular Hours Only"
        },
        {
          "id": "true",
          "name": "Include Pre/After Market"
        }
      ],
      "default": "false",
      "required": false,
      "description": "Allow execution during pre-market (4am-9:30am) and after-hours (4pm-8pm). Only for limit day orders.",
      "displayOptions": {
        "show": {
          "type": [
            "limit"
          ],
          "time_in_force": [
            "day"
          ],
          "asset_type": [
            "stock"
          ]
        }
      },
      "showDescription": false
    }
  ]
}
