{
  "name": "SchwabStreamListener",
  "broker": "schwab",
  "def": "Schwab Stream Listener",
  "node_type": "trigger",
  "icon": "/assets/icons/schwab.svg",
  "category": "Stream",
  "subCategory": "schwab",
  "executionMode": "streaming",
  "action": {
    "url": "/stream/schwab/register",
    "method": "POST"
  },
  "stopAction": {
    "url": "/stream/unregister",
    "method": "POST"
  },
  "streamingConfig": {
    "waitForFirstEvent": false,
    "timeout": 300000,
    "listeningFlag": "isTestListening",
    "subscribeListeningFlag": "isStreamingWaiting",
    "recoveryPolling": {
      "endpoint": "/market/stream-test-result/{{workflow_id}}/{{node_id}}",
      "interval": 10000
    }
  },
  "description": "Register to receive Schwab real-time equity quote data. Use Listen mode to receive pre-subscribed symbols, or Subscribe mode to subscribe and stream in one node.",
  "color": "text-blue-500",
  "size": {
    "width": 320,
    "height": 320
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "SchwabAuthModal",
  "authAction": {
    "url": "/oauth/schwab/generate-auth-url",
    "method": "POST"
  },
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "required": true,
      "placeholder": "e.g., My Schwab Account"
    },
    {
      "key": "app_key",
      "label": "App Key",
      "type": "password",
      "required": true,
      "placeholder": "Your Schwab App Key"
    },
    {
      "key": "app_secret",
      "label": "App Secret",
      "type": "password",
      "required": true,
      "placeholder": "Your Schwab App Secret"
    },
    {
      "key": "account_number",
      "label": "Account Number (Optional)",
      "type": "text",
      "required": false,
      "placeholder": "For reference only - will be fetched dynamically"
    }
  ],
  "fields": [
    {
      "key": "assetType",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "equity",
          "name": "Equity"
        },
        {
          "id": "future",
          "name": "Future"
        }
      ],
      "default": "equity",
      "required": true
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "hidden",
      "default": "live"
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        {
          "id": "listen",
          "name": "Register"
        },
        {
          "id": "subscribe",
          "name": "Subscribe & Register"
        }
      ],
      "default": "listen",
      "description": "Listen mode uses symbols from Subscribe nodes. Subscribe mode subscribes symbols directly.",
      "showDescription": false
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": true
    },
    {
      "key": "account_id",
      "label": "Account",
      "type": "select",
      "optionsSource": "dependentApi",
      "optionsApiUrl": "/broker/schwab/get_account_numbers",
      "dependsOn": "credential_id",
      "placeholder": "Select an account",
      "description": "Required for Account Activity / Order Updates.",
      "displayOptions": {
        "show": {
          "stream_type": [
            "account_activity"
          ],
          "mode": [
            "subscribe"
          ]
        }
      },
      "required": true,
      "showDescription": false
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "AAPL, MSFT, /ES",
      "description": "Comma-separated symbols for market streams. Not required when only Account Activity is selected.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "showDescription": false,
      "required": false
    },
    {
      "key": "stream_type",
      "label": "Stream Type",
      "type": "multiselect",
      "options": [
        {
          "id": "quote",
          "name": "Quotes"
        },
        {
          "id": "chart",
          "name": "Chart Bars"
        },
        {
          "id": "account_activity",
          "name": "Account Activity / Order Updates"
        }
      ],
      "default": ["chart"],
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": true,
      "description": "Select Schwab market streams or account activity order updates to subscribe to."
    },
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        {
          "id": "workflow",
          "name": "Only This Workflow's Subscriptions"
        },
        {
          "id": "global",
          "name": "All My Subscriptions"
        }
      ],
      "default": "workflow",
      "description": "Receive only symbols subscribed targeting this workflow, or all your global subscriptions.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_symbols",
      "label": "Filter Symbols (Optional)",
      "type": "text",
      "placeholder": "AAPL, MSFT (leave empty for all)",
      "description": "Only receive data for specific symbols. Leave empty to receive all pre-subscribed symbols.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_types",
      "label": "Filter Event Types (Optional)",
      "type": "multiselect",
      "options": [
        {
          "id": "quote",
          "name": "Quotes"
        },
        {
          "id": "chart",
          "name": "Chart Bars"
        },
        {
          "id": "account_activity",
          "name": "Account Activity / Order Updates"
        }
      ],
      "description": "Filter specific event types. Leave empty to receive all types.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    }
  ]
}
