{
  "name": "Portfolio",
  "def": "Portfolio",
  "node_type": "main",
  "icon": "/assets/icons/backtest.svg",
  "category": "Portfolio",
  "description": "Generic portfolio state node for backtest and live broker modes. Supports order intent, order updates, executions, position reconciliation, balance reconciliation, MTM, and portfolio queries.",
  "color": "text-orange-500",
  "size": {
    "width": 360,
    "height": 420
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/portfolio",
    "method": "POST"
  },
  "fields": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "required": true,
      "default": "broker",
      "options": [
        {
          "id": "backtest",
          "name": "Backtest (SimBroker)"
        },
        {
          "id": "broker",
          "name": "Live (Broker)"
        }
      ]
    },
    {
      "key": "backtest_id",
      "label": "Backtest ID",
      "type": "text",
      "placeholder": "{{ $('BacktestInit').json.backtest_id }}",
      "required": true,
      "displayOptions": {
        "show": {
          "mode": [
            "backtest"
          ]
        }
      }
    },
    {
      "key": "broker",
      "label": "Broker",
      "type": "select",
      "required": false,
      "default": "generic",
      "options": [
        {
          "id": "generic",
          "name": "Generic"
        },
        {
          "id": "alpaca",
          "name": "Alpaca"
        },
        {
          "id": "binance_spot",
          "name": "Binance Spot"
        },
        {
          "id": "binance_futures",
          "name": "Binance Futures"
        }
      ],
      "displayOptions": {
        "show": {
          "mode": [
            "broker"
          ]
        }
      }
    },
    {
      "key": "account_id",
      "label": "Account ID",
      "type": "text",
      "placeholder": "e.g. primary",
      "required": false,
      "displayOptions": {
        "show": {
          "mode": [
            "broker"
          ]
        }
      }
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "required": true,
      "default": "get_portfolio",
      "options": [
        {
          "id": "create_portfolio",
          "name": "Create Portfolio"
        },
        {
          "id": "register_order_intent",
          "name": "Register Order Intent"
        },
        {
          "id": "apply_order_update",
          "name": "Apply Order Update"
        },
        {
          "id": "apply_execution",
          "name": "Apply Execution"
        },
        {
          "id": "sync_order_event",
          "name": "Sync Order Event"
        },
        {
          "id": "reconcile_position",
          "name": "Reconcile Position"
        },
        {
          "id": "reconcile_balances",
          "name": "Reconcile Balances"
        },
        {
          "id": "cancel_order",
          "name": "Cancel Order"
        },
        {
          "id": "get_pending_orders",
          "name": "Get Pending Orders"
        },
        {
          "id": "get_portfolio",
          "name": "Get Portfolio"
        },
        {
          "id": "get_position",
          "name": "Get Position"
        },
        {
          "id": "update_mtm",
          "name": "Update MTM"
        },
        {
          "id": "get_cash",
          "name": "Get Cash"
        },
        {
          "id": "get_equity",
          "name": "Get Equity"
        },
        {
          "id": "get_trades",
          "name": "Get Trades"
        }
      ]
    },
    {
      "key": "base_currency",
      "label": "Base Currency",
      "type": "select",
      "required": false,
      "default": "USD",
      "options": [
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "EUR",
          "name": "EUR"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "create_portfolio",
            "apply_execution",
            "get_portfolio",
            "get_cash",
            "get_equity",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "cash_balance",
      "label": "Cash Balance",
      "type": "text",
      "placeholder": "e.g. 100000",
      "required": true,
      "description": "Starting cash balance in the base currency.",
      "displayOptions": {
        "show": {
          "operation": [
            "create_portfolio"
          ]
        }
      }
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. ETH/USD",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_order_update",
            "apply_execution",
            "reconcile_position",
            "get_position",
            "update_mtm",
            "get_pending_orders",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "asset",
      "label": "Asset",
      "type": "text",
      "placeholder": "e.g. USD or BNB",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_balances"
          ]
        }
      }
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "required": false,
      "options": [
        {
          "id": "BUY",
          "name": "BUY"
        },
        {
          "id": "SELL",
          "name": "SELL"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_execution",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "order_type",
      "label": "Order Type",
      "type": "text",
      "placeholder": "e.g. market, limit, stop",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "time_in_force",
      "label": "Time In Force",
      "type": "text",
      "placeholder": "e.g. gtc, day, ioc",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "status",
      "label": "Status",
      "type": "text",
      "placeholder": "e.g. new, partially_filled, filled, canceled",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_order_update",
            "apply_execution",
            "cancel_order",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "broker_order_id",
      "label": "Broker Order ID",
      "type": "text",
      "placeholder": "e.g. broker order id",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_order_update",
            "apply_execution",
            "cancel_order",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "client_order_id",
      "label": "Client Order ID",
      "type": "text",
      "placeholder": "e.g. client order id",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_order_update",
            "apply_execution",
            "cancel_order",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "execution_id",
      "label": "Execution ID",
      "type": "text",
      "placeholder": "e.g. execution or trade id",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "apply_execution",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "orig_qty",
      "label": "Original Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent",
            "apply_order_update",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "filled_qty",
      "label": "Filled Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": false,
      "description": "Cumulative filled quantity from the broker. The executor derives the execution delta internally.",
      "displayOptions": {
        "show": {
          "operation": [
            "apply_execution",
            "apply_order_update",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "avg_fill_price",
      "label": "Average Price",
      "type": "text",
      "placeholder": "e.g. 2122.79",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "apply_order_update",
            "apply_execution",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "market_price",
      "label": "Market Price",
      "type": "text",
      "placeholder": "e.g. 2125.10",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "update_mtm"
          ]
        }
      }
    },
    {
      "key": "fee_amount",
      "label": "Fee Amount",
      "type": "text",
      "placeholder": "0",
      "required": false,
      "default": "0",
      "displayOptions": {
        "show": {
          "operation": [
            "apply_execution",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "fee_asset",
      "label": "Fee Asset",
      "type": "text",
      "placeholder": "e.g. USD, ETH, BNB",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "apply_execution",
            "sync_order_event"
          ]
        }
      }
    },
    {
      "key": "limit_price",
      "label": "Limit Price",
      "type": "text",
      "placeholder": "e.g. 2120.00",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "stop_price",
      "label": "Stop Price",
      "type": "text",
      "placeholder": "e.g. 2100.00",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "trail_percent",
      "label": "Trail Percent",
      "type": "text",
      "placeholder": "e.g. 1.5",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "trail_price",
      "label": "Trail Price",
      "type": "text",
      "placeholder": "e.g. 2.0",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "register_order_intent"
          ]
        }
      }
    },
    {
      "key": "position_qty",
      "label": "Position Quantity",
      "type": "text",
      "placeholder": "e.g. 0.9982",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_position"
          ]
        }
      }
    },
    {
      "key": "avg_entry_price",
      "label": "Average Entry Price",
      "type": "text",
      "placeholder": "e.g. 2126.62",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_position"
          ]
        }
      }
    },
    {
      "key": "total",
      "label": "Total Balance",
      "type": "text",
      "placeholder": "e.g. 1000",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_balances"
          ]
        }
      }
    },
    {
      "key": "available",
      "label": "Available Balance",
      "type": "text",
      "placeholder": "e.g. 950",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_balances"
          ]
        }
      }
    },
    {
      "key": "locked",
      "label": "Locked Balance",
      "type": "text",
      "placeholder": "e.g. 50",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "reconcile_balances"
          ]
        }
      }
    },
    {
      "key": "current_bar",
      "label": "Current Bar",
      "type": "textarea",
      "placeholder": "{{ $('OnBar').json.bar }}",
      "required": false,
      "description": "Current OHLCV bar for mark-to-market pricing in backtest mode.",
      "displayOptions": {
        "show": {
          "operation": [
            "update_mtm"
          ],
          "mode": [
            "backtest"
          ]
        }
      }
    }
  ],
  "operationDisplayOptions": {
    "register_order_intent": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "apply_order_update": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "apply_execution": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "reconcile_position": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "reconcile_balances": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "cancel_order": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "get_pending_orders": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    },
    "update_mtm": {
      "show": {
        "mode": [
          "backtest",
          "broker"
        ]
      }
    },
    "sync_order_event": {
      "show": {
        "mode": [
          "broker"
        ]
      }
    }
  }
}
