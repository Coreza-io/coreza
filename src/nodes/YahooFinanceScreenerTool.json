{
  "name": "YahooFinanceScreenerTool",
  "def": "Yahoo Finance Screener",
  "node_type": "sub",
  "icon": "/assets/icons/YahooFinance.svg",
  "category": "Tool",
  "subCategory": "YahooFinance",
  "description": "Screen stocks using Yahoo Finance predefined screeners. Find day gainers/losers, most active, small cap gainers, undervalued stocks, growth tech, and more.",
  "color": "text-purple-500",
  "size": { "width": 340, "height": 300 },
  "handles": [
    { "type": "source", "position": "top", "id": "tool" }
  ],
  "action": {
    "url": "/screener/yahoofinance/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Screener Type",
      "type": "select",
      "options": [
        { "id": "day_gainers", "name": "Day Gainers" },
        { "id": "day_losers", "name": "Day Losers" },
        { "id": "most_actives", "name": "Most Actives" },
        { "id": "small_cap_gainers", "name": "Small Cap Gainers" },
        { "id": "undervalued_large_caps", "name": "Undervalued Large Caps" },
        { "id": "growth_technology_stocks", "name": "Growth Technology Stocks" },
        { "id": "aggressive_small_caps", "name": "Aggressive Small Caps" },
        { "id": "undervalued_growth_stocks", "name": "Undervalued Growth Stocks" }
      ],
      "default": "day_gainers",
      "required": true,
      "description": "Predefined screening strategy: Day Gainers/Losers for daily movers, Most Actives for volume, others for specific investment styles."
    },
    {
      "key": "count",
      "label": "Number of Results",
      "type": "text",
      "placeholder": "100",
      "default": "100",
      "description": "Maximum number of stocks to return."
    },
    {
      "key": "min_gap_percent",
      "label": "Min Gap %",
      "type": "text",
      "placeholder": "3.0",
      "default": "0",
      "description": "Minimum gap percentage filter (difference between previous close and current open).",
      "displayOptions": {
        "show": {
          "operation": ["day_gainers"]
        }
      }
    },
    {
      "key": "min_change_percent",
      "label": "Min Change %",
      "type": "text",
      "placeholder": "1.0",
      "default": "1.0",
      "description": "Minimum absolute price change percentage to include.",
      "displayOptions": {
        "show": {
          "operation": ["most_actives"]
        }
      }
    },
    {
      "key": "min_loss_percent",
      "label": "Min Loss %",
      "type": "text",
      "placeholder": "0",
      "default": "0",
      "description": "Minimum loss percentage (absolute value) for day losers filter.",
      "displayOptions": {
        "show": {
          "operation": ["day_losers"]
        }
      }
    }
  ]
}
