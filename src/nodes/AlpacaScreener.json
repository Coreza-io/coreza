{
  "name": "AlpacaScreener",
  "def": "Alpaca Screener",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "color": "text-yellow-500",
  "category": "Broker",
  "subCategory": "Alpaca",
  "description": "Screen stocks using Alpaca's Most Actives and Market Movers APIs",
  "size": {
    "width": 300,
    "height": 200
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Name",
      "type": "text",
      "placeholder": "My Alpaca Account"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "text",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": {
    "url": "/alpaca/auth-url",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Alpaca Credentials",
      "type": "select",
      "required": true,
      "optionsSource": "/alpaca/credentials"
    },
    {
      "key": "screener_type",
      "label": "Screener Type",
      "type": "select",
      "options": [
        {
          "label": "Most Actives",
          "value": "most_actives"
        },
        {
          "label": "Market Movers",
          "value": "market_movers"
        }
      ],
      "required": true,
      "default": "most_actives"
    },
    {
      "key": "market_type",
      "label": "Market Type",
      "type": "select",
      "options": [
        {
          "label": "Stocks",
          "value": "stocks"
        },
        {
          "label": "Crypto",
          "value": "crypto"
        }
      ],
      "default": "stocks",
      "displayOptions": {
        "show": {
          "screener_type": ["market_movers"]
        }
      }
    },
    {
      "key": "top",
      "label": "Number of Results",
      "type": "text",
      "placeholder": "e.g., 10, 20, 50",
      "default": "10"
    },
    {
      "key": "operation",
      "type": "hidden",
      "default": "{{screener_type}}"
    }
  ],
  "action": {
    "url": "/alpaca/:operation",
    "method": "POST"
  }
}
