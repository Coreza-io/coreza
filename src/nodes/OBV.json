{
  "name": "OBV",
  "def": "On-Balance Volume",
  "node_type": "main",
  "icon": "/assets/icons/obv.svg",
  "category": "Indicators",
  "description": "On-Balance Volume indicator to detect volume-driven momentum trends",
  "color": "text-orange-500",
  "size": {
    "width": 300,
    "height": 280
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/obv",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "The ticker symbol for the asset being analyzed (e.g. AAPL, BTCUSDT)."
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true,
      "description": "The timeframe/interval of the candle data (e.g. 1m, 5m, 1h, 1d)."
    }
  ]
}
