{
  "name": "VolumeOscillator",
  "def": "Volume Oscillator",
  "node_type": "main",
  "icon": "/assets/icons/volume-oscillator.svg",
  "category": "Indicators",
  "description": "Volume Oscillator - shows difference between two volume moving averages to identify volume trends and divergences.",
  "color": "text-purple-500",
  "size": {
    "width": 300,
    "height": 320
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/volume-oscillator",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "The ticker symbol for the asset being analyzed (e.g. AAPL, BTCUSDT)."
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true,
      "description": "The timeframe/interval of the candle data (e.g. 1m, 5m, 1h, 1d)."
    },
    {
      "key": "short_period",
      "label": "Short Period",
      "type": "text",
      "placeholder": "e.g. 12",
      "default": "12",
      "required": true,
      "width": "half",
      "description": "Period for short-term volume MA."
    },
    {
      "key": "long_period",
      "label": "Long Period",
      "type": "text",
      "placeholder": "e.g. 26",
      "default": "26",
      "required": true,
      "width": "half",
      "description": "Period for long-term volume MA. Must be greater than short period."
    },
    {
      "key": "type",
      "label": "Calculation Type",
      "type": "select",
      "options": [
        {
          "id": "percentage",
          "name": "Percentage (PVO)"
        },
        {
          "id": "absolute",
          "name": "Absolute Difference"
        }
      ],
      "default": "percentage",
      "required": true,
      "description": "Output format: 'percentage' for comparing across stocks, 'absolute' for raw volume difference analysis."
    }
  ]
}
