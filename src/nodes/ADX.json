{
  "name": "ADX",
  "def": "Average Directional Index",
  "node_type": "main",
  "icon": "/assets/icons/adx.svg",
  "category": "Indicators",
  "description": "ADX indicator to evaluate trend strength using DI+/DI- lines",
  "color": "text-yellow-500",
  "size": {
    "width": 320,
    "height": 300
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/adx",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true
    },
    {
      "key": "period",
      "label": "ADX Period",
      "type": "text",
      "placeholder": "e.g. 14",
      "default": "14",
      "required": true
    }
  ]
}
