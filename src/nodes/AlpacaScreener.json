{
  "name": "AlpacaScreener",
  "def": "Alpaca Screener",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Screener",
  "subCategory": "Alpaca",
  "description": "Screen stocks using Alpaca's Most Actives and Market Movers APIs",
  "color": "text-yellow-500",
  "size": {
    "width": 340,
    "height": 280
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/screener/alpaca/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "required": true,
      "description": "Your saved Alpaca API credential."
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "paper",
          "name": "Paper Trading (Sandbox)"
        },
        {
          "id": "live",
          "name": "Live Trading (Production)"
        }
      ],
      "default": "paper",
      "required": true
    },
    {
      "key": "operation",
      "label": "Screener Type",
      "type": "select",
      "options": [
        {
          "id": "most_actives",
          "name": "Most Actives"
        },
        {
          "id": "market_movers",
          "name": "Market Movers"
        }
      ],
      "default": "most_actives",
      "required": true,
      "description": "Most Actives: highest volume/trades. Market Movers: biggest price changes (gainers/losers)."
    },
    {
      "key": "assetType",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "stock",
          "name": "Stock"
        },
        {
          "id": "crypto",
          "name": "Crypto"
        }
      ],
      "default": "stock",
      "displayOptions": {
        "show": {
          "operation": [
            "market_movers"
          ]
        }
      },
      "description": "Asset class to screen: US stocks or cryptocurrency."
    },
    {
      "key": "top",
      "label": "Number of Results",
      "type": "text",
      "placeholder": "10",
      "default": "10",
      "description": "Maximum number of results to return (1-100)."
    },
    {
      "key": "by",
      "label": "Sort By",
      "type": "select",
      "options": [
        {
          "id": "volume",
          "name": "Volume"
        },
        {
          "id": "trades",
          "name": "Trades"
        }
      ],
      "default": "volume",
      "displayOptions": {
        "show": {
          "operation": [
            "most_actives"
          ]
        }
      },
      "description": "Ranking criteria: by dollar volume traded or by number of trades."
    }
  ]
}
