{
  "name":        "Edit Fields",
  "label":       "Edit Fields",
  "def":         "Map or drop fields from your JSON payload",
  "node_type":   "main",
  "manualExecution": "available",
  "icon": "/assets/icons/edit-fields.svg",
  "category":    "Logic",
  "description": "Set, remove or rename JSON fields",
  "color":       "text-yellow-500",
  "size":        { "width": 340, "height": 440 },
  "handles": [
    { "type": "target", "position": "left",  "id": "input"  },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": {
    "url":    "/comparator/field",
    "method": "POST"
  },
  "fields": [
    {
      "key": "persistent",
      "label": "Persistent",
      "type": "checkbox",
      "placeholder": "Keep values across workflow runs",
      "default": false
    },
    {
      "key":   "fields",
      "label": "Fields to Set",
      "type":  "repeater",
      "subFields": [
        {
          "key":         "fieldName",
          "type":        "string",
          "label":        "Field Name",
          "placeholder": "Field name"
        },
        {
          "key":     "dataType",
          "label":   "Type",
          "type":    "select",
          "options": [
            { "label": "String",  "value": "string"  },
            { "label": "Number",  "value": "number"  },
            { "label": "Boolean", "value": "boolean" },
            { "label": "Array",   "value": "array"   },
            { "label": "Object",  "value": "object"  }
          ],
          "default": "string"
        },
        {
          "key": "valueMode",
          "label": "Value Mode",
          "type": "select",
          "options": [
            { "label": "Fixed", "value": "fixed" },
            { "label": "Expression", "value": "expression" }
          ],
          "default": "fixed"
        },
        {
          "key":         "value",
          "label":       "Value",
          "type":        "string",
          "placeholder": "Value"
        }
      ],
      "default": [
        { "fieldName": "", "dataType": "string", "valueMode": "fixed", "value": "" }
      ]
    }
  ]
}
