{
  "name": "HttpRequestTool",
  "def": "HTTP Request",
  "node_type": "sub",
  "icon": "Globe",
  "category": "Tool",
  "description": "Make HTTP requests to external APIs. Supports GET, POST, PUT, DELETE, PATCH with various authentication methods (Bearer, Basic, API Key) and body formats (JSON, Form, Raw).",
  "color": "text-green-500",
  "size": {
    "width": 360,
    "height": 400
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "action": {
    "url": "/http/request",
    "method": "POST"
  },
  "fields": [
    {
      "key": "method",
      "label": "HTTP Method",
      "type": "select",
      "options": [
        { "id": "GET", "name": "GET" },
        { "id": "POST", "name": "POST" },
        { "id": "PUT", "name": "PUT" },
        { "id": "DELETE", "name": "DELETE" },
        { "id": "PATCH", "name": "PATCH" },
        { "id": "HEAD", "name": "HEAD" },
        { "id": "OPTIONS", "name": "OPTIONS" }
      ],
      "default": "GET",
      "description": "HTTP method: GET for reading, POST for creating, PUT for replacing, PATCH for updating, DELETE for removing.",
      "required": true
    },
    {
      "key": "url",
      "label": "URL",
      "type": "text",
      "placeholder": "https://api.example.com/endpoint",
      "description": "Full URL to request including protocol (https://). Can include query parameters.",
      "required": true
    },
    {
      "key": "auth_type",
      "label": "Authentication",
      "type": "select",
      "options": [
        { "id": "none", "name": "None" },
        { "id": "bearer", "name": "Bearer Token" },
        { "id": "basic", "name": "Basic Auth" },
        { "id": "api_key", "name": "API Key" }
      ],
      "default": "none",
      "description": "Authentication method: None for public APIs, Bearer for OAuth tokens, Basic for username/password, API Key for header/query auth.",
      "required": true
    },
    {
      "key": "bearer_token",
      "label": "Bearer Token",
      "type": "text",
      "placeholder": "your-bearer-token",
      "description": "OAuth access token or JWT. Will be sent as 'Authorization: Bearer <token>'.",
      "displayOptions": {
        "show": {
          "auth_type": ["bearer"]
        }
      }
    },
    {
      "key": "basic_username",
      "label": "Username",
      "type": "text",
      "placeholder": "username",
      "description": "Username for HTTP Basic authentication.",
      "displayOptions": {
        "show": {
          "auth_type": ["basic"]
        }
      }
    },
    {
      "key": "basic_password",
      "label": "Password",
      "type": "text",
      "placeholder": "password",
      "description": "Password for HTTP Basic authentication.",
      "displayOptions": {
        "show": {
          "auth_type": ["basic"]
        }
      }
    },
    {
      "key": "api_key_location",
      "label": "API Key Location",
      "type": "select",
      "options": [
        { "id": "header", "name": "Header" },
        { "id": "query", "name": "Query Parameter" }
      ],
      "default": "header",
      "description": "Where to send the API key: in request headers or as URL query parameter.",
      "displayOptions": {
        "show": {
          "auth_type": ["api_key"]
        }
      }
    },
    {
      "key": "api_key_name",
      "label": "API Key Name",
      "type": "text",
      "placeholder": "X-API-Key",
      "description": "Header name or query parameter name for the API key.",
      "displayOptions": {
        "show": {
          "auth_type": ["api_key"]
        }
      }
    },
    {
      "key": "api_key_value",
      "label": "API Key Value",
      "type": "text",
      "placeholder": "your-api-key",
      "description": "The actual API key value.",
      "displayOptions": {
        "show": {
          "auth_type": ["api_key"]
        }
      }
    },
    {
      "key": "headers",
      "label": "Custom Headers",
      "type": "repeater",
      "description": "Additional HTTP headers to send with the request.",
      "subFields": [
        {
          "key": "name",
          "type": "text",
          "placeholder": "Header name"
        },
        {
          "key": "value",
          "type": "text",
          "placeholder": "Header value"
        }
      ],
      "default": []
    },
    {
      "key": "body_type",
      "label": "Body Type",
      "type": "select",
      "options": [
        { "id": "none", "name": "No Body" },
        { "id": "json", "name": "JSON" },
        { "id": "form", "name": "Form Data" },
        { "id": "raw", "name": "Raw Text" }
      ],
      "default": "none",
      "description": "Request body format: JSON for APIs, Form for traditional forms, Raw for plain text.",
      "displayOptions": {
        "show": {
          "method": ["POST", "PUT", "PATCH"]
        }
      }
    },
    {
      "key": "json_body",
      "label": "JSON Body",
      "type": "textarea",
      "placeholder": "{\n  \"key\": \"value\"\n}",
      "description": "JSON object to send in request body.",
      "displayOptions": {
        "show": {
          "body_type": ["json"]
        }
      }
    },
    {
      "key": "form_data",
      "label": "Form Data",
      "type": "repeater",
      "description": "Form fields to send (application/x-www-form-urlencoded).",
      "subFields": [
        {
          "key": "name",
          "type": "text",
          "placeholder": "Field name"
        },
        {
          "key": "value",
          "type": "text",
          "placeholder": "Field value"
        }
      ],
      "default": [],
      "displayOptions": {
        "show": {
          "body_type": ["form"]
        }
      }
    },
    {
      "key": "raw_body",
      "label": "Raw Body",
      "type": "textarea",
      "placeholder": "Raw text content",
      "description": "Plain text content to send in request body.",
      "displayOptions": {
        "show": {
          "body_type": ["raw"]
        }
      }
    },
    {
      "key": "timeout",
      "label": "Timeout (seconds)",
      "type": "text",
      "placeholder": "30",
      "default": "30",
      "description": "Maximum time to wait for response in seconds."
    }
  ]
}
