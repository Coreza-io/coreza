{
  "name": "AIAgent",
  "def": "AI Agent",
  "node_type": "main",
  "category": "AIAgent",
  "icon": "/assets/icons/openai.svg",
  "size": { "width": 380, "height": 420 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "target", "position": "bottom", "id": "chatModel" },
    { "type": "target", "position": "bottom", "id": "memory" },
    { "type": "target", "position": "bottom", "id": "tool" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/aiagent/execute", "method": "POST" },
  "fields": [
    {
      "key": "systemPrompt",
      "label": "System Prompt",
      "type": "textarea",
      "placeholder": "You are a helpful AI assistant...",
      "default": "You are a helpful AI assistant. Use the available tools to help answer the user's questions.",
      "required": true
    },
    {
      "key": "userPrompt",
      "label": "User Prompt",
      "type": "textarea",
      "placeholder": "Enter user message or use {{variable}}",
      "required": true
    },
    {
      "key": "maxIterations",
      "label": "Max Iterations",
      "type": "number",
      "default": 10,
      "required": false
    },
    {
      "key": "temperature",
      "label": "Temperature",
      "type": "number",
      "default": 0.7,
      "required": false
    },
    {
      "key": "returnIntermediateSteps",
      "label": "Return Intermediate Steps",
      "type": "checkbox",
      "default": false,
      "required": false
    }
  ]
}
