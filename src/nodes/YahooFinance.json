{
  "name": "YahooFinance",
  "def": "YahooFinance Data",
  "node_type": "main",
  "category": "Data",
  "icon": "/assets/icons/YahooFinance.svg",
  "size": {
    "width": 340,
    "height": 420
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/datasource/yahoofinance/:operation",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "get_history",
          "name": "Get Candle"
        }
      ],
      "default": "get_history",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Ticker Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "Stock ticker symbol (e.g., AAPL for Apple, TSLA for Tesla, MSFT for Microsoft)."
    },
    {
      "key": "interval",
      "label": "Interval",
      "type": "select",
      "options": [
        {
          "id": "1m",
          "name": "1 min"
        },
        {
          "id": "5m",
          "name": "5 min"
        },
        {
          "id": "15m",
          "name": "15 min"
        },
        {
          "id": "60m",
          "name": "1 hour"
        },
        {
          "id": "1d",
          "name": "1 day"
        }
      ],
      "placeholder": "Select interval",
      "required": true,
      "description": "Time interval between data points. Use 1d for daily analysis, shorter intervals for intraday."
    },
    {
      "key": "date_mode",
      "label": "Date Mode",
      "type": "select",
      "options": [
        {
          "id": "lookback",
          "name": "Lookback (Bars)"
        },
        {
          "id": "range",
          "name": "Date Range"
        }
      ],
      "default": "lookback",
      "required": true,
      "description": "How to specify date range. Use 'lookback' (RECOMMENDED) to get most recent N bars from today. Use 'range' only for specific historical periods like backtesting."
    },
    {
      "key": "lookback",
      "label": "Bars to Fetch",
      "type": "text",
      "placeholder": "e.g. 100",
      "required": false,
      "displayOptions": {
        "show": {
          "date_mode": [
            "lookback"
          ]
        }
      },
      "description": "Number of bars/periods to fetch backwards from today. For example, 90 with interval '1d' gets the last 90 days of daily data."
    },
    {
      "key": "start_date",
      "label": "Start Date",
      "type": "text",
      "placeholder": "e.g. 2023-01-01 or {{ $('BacktestInit').json.start_date }}",
      "required": false,
      "displayOptions": {
        "show": {
          "date_mode": [
            "range"
          ]
        }
      },
      "description": "Start date for historical data range. Format: YYYY-MM-DD. Only used when date_mode is 'range'."
    },
    {
      "key": "end_date",
      "label": "End Date",
      "type": "text",
      "placeholder": "e.g. 2024-01-01 or {{ $('BacktestInit').json.end_date }}",
      "required": false,
      "displayOptions": {
        "show": {
          "date_mode": [
            "range"
          ]
        }
      },
      "description": "End date for historical data range. Format: YYYY-MM-DD. Defaults to today if not specified."
    }
  ]
}
