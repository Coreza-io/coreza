# Redis (required for Pub/Sub and job queue)
REDIS_URL=redis://localhost:6379

# Supabase (required for database access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption (required for credential decryption)
COREZA_ENCRYPTION_KEY=your_base64_encryption_key_here

# JWT Secret (required for authentication)
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development

# Optional: BullMQ Worker Concurrency
WORKFLOW_JOB_CONCURRENCY=5
