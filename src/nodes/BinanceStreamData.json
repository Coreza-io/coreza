{
  "name": "BinanceStreamData",
  "def": "Binance Stream Data",
  "node_type": "trigger",
  "icon": "/assets/icons/binance.svg",
  "category": "Market",
  "subCategory": "binance",
  "executionMode": "streaming",
  "action": {
    "url": "/stream/binance/register",
    "method": "POST"
  },
  "streamingConfig": {
    "waitForFirstEvent": false,
    "timeout": 300000,
    "listeningFlag": "isTestListening",
    "subscribeListeningFlag": "isStreamingWaiting",
    "recoveryPolling": {
      "endpoint": "/market/stream-test-result/{{workflow_id}}/{{node_id}}",
      "interval": 10000
    }
  },
  "description": "Receives real-time market data, news, or order fill events from Binance. Use BinanceSubscribe node to explicitly subscribe to market streams and/or Order Updates (Fills). Use an If node downstream to route market events vs order updates. Use Listen mode to receive pre-subscribed symbols, or Subscribe mode to subscribe and stream in one node.",
  "color": "text-yellow-500",
  "size": {
    "width": 320,
    "height": 320
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Binance"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true
    }
  ],
  "authAction": {
    "url": "/broker/binance/auth",
    "method": "POST"
  },
  "fields": [
    {
      "key": "assetType",
      "type": "hidden",
      "default": "crypto"
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        {
          "id": "listen",
          "name": "Register"
        },
        {
          "id": "subscribe",
          "name": "Subscribe & Register"
        }
      ],
      "default": "listen",
      "description": "Listen mode uses symbols from Subscribe nodes. Subscribe mode subscribes symbols directly.",
      "showDescription": false
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": false
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "testnet",
          "name": "Testnet (Paper)"
        },
        {
          "id": "live",
          "name": "Live"
        }
      ],
      "default": "testnet",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "marketType",
      "label": "Market Type",
      "type": "select",
      "options": [
        {
          "id": "spot",
          "name": "Spot"
        },
        {
          "id": "futures",
          "name": "Futures (USDT-M)"
        }
      ],
      "default": "spot",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "BTCUSDT, ETHUSDT",
      "description": "Symbols to subscribe and stream.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "showDescription": false
    },
    {
      "key": "stream_type",
      "label": "Stream Type",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trade"
        },
        {
          "id": "aggTrade",
          "name": "Aggregated Trade"
        },
        {
          "id": "kline",
          "name": "Kline (Candlestick)"
        },
        {
          "id": "miniTicker",
          "name": "Mini Ticker"
        },
        {
          "id": "ticker",
          "name": "Ticker (24h)"
        },
        {
          "id": "bookTicker",
          "name": "Book Ticker"
        },
        {
          "id": "depth",
          "name": "Depth (Order Book)"
        },
        {
          "id": "ORDER_TRADE_UPDATE",
          "name": "Trade Updates (Fills)",
          "valueMap": {
            "field": "marketType",
            "values": {
              "spot": "executionReport",
              "futures": "ORDER_TRADE_UPDATE"
            }
          }
        },
        {
          "id": "markPrice",
          "name": "Mark Price Update",
          "displayOptions": {
            "show": {
              "marketType": ["futures"]
            }
          }
        },
        {
          "id": "liquidation",
          "name": "Liquidation (forceOrder)",
          "displayOptions": {
            "show": {
              "marketType": ["futures"]
            }
          }
        },
        {
          "id": "continuousKline",
          "name": "Continuous Kline",
          "displayOptions": {
            "show": {
              "marketType": ["futures"]
            }
          }
        },
        {
          "id": "indexPrice",
          "name": "Index Price Update",
          "displayOptions": {
            "show": {
              "marketType": ["futures"]
            }
          }
        },
        {
          "id": "compositeIndex",
          "name": "Composite Index",
          "displayOptions": {
            "show": {
              "marketType": ["futures"]
            }
          }
        }
      ],
      "default": ["kline"],
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "interval",
      "label": "Kline Interval",
      "type": "select",
      "options": [
        {
          "id": "1m",
          "name": "1 Minute"
        },
        {
          "id": "3m",
          "name": "3 Minutes"
        },
        {
          "id": "5m",
          "name": "5 Minutes"
        },
        {
          "id": "15m",
          "name": "15 Minutes"
        },
        {
          "id": "30m",
          "name": "30 Minutes"
        },
        {
          "id": "1h",
          "name": "1 Hour"
        },
        {
          "id": "2h",
          "name": "2 Hours"
        },
        {
          "id": "4h",
          "name": "4 Hours"
        },
        {
          "id": "6h",
          "name": "6 Hours"
        },
        {
          "id": "8h",
          "name": "8 Hours"
        },
        {
          "id": "12h",
          "name": "12 Hours"
        },
        {
          "id": "1d",
          "name": "1 Day"
        },
        {
          "id": "3d",
          "name": "3 Days"
        },
        {
          "id": "1w",
          "name": "1 Week"
        },
        {
          "id": "1M",
          "name": "1 Month"
        }
      ],
      "default": "1m",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"],
          "stream_type": ["kline", "continuousKline"]
        }
      }
    },
    {
      "key": "depth_levels",
      "label": "Order Book Depth",
      "type": "select",
      "options": [
        {
          "id": "5",
          "name": "Top 5 Levels"
        },
        {
          "id": "10",
          "name": "Top 10 Levels"
        },
        {
          "id": "20",
          "name": "Top 20 Levels"
        }
      ],
      "default": "10",
      "displayOptions": {
        "show": {
          "stream_type": ["depth"]
        }
      }
    },
    {
      "key": "contractType",
      "label": "Contract Type",
      "type": "select",
      "options": [
        {
          "id": "perpetual",
          "name": "Perpetual"
        },
        {
          "id": "current_quarter",
          "name": "Current Quarter"
        },
        {
          "id": "next_quarter",
          "name": "Next Quarter"
        }
      ],
      "default": "perpetual",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"],
          "marketType": ["futures"],
          "stream_type": ["continuousKline"]
        }
      }
    },
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        {
          "id": "workflow",
          "name": "Only This Workflow's Subscriptions"
        },
        {
          "id": "global",
          "name": "All My Subscriptions"
        }
      ],
      "default": "workflow",
      "description": "Receive only symbols subscribed targeting this workflow, or all your global subscriptions.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_symbols",
      "label": "Filter Symbols",
      "type": "text",
      "placeholder": "BTCUSDT, ETHUSDT",
      "description": "Optional \u2014 only receive events for these symbols. Leave empty for all.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_types",
      "label": "Filter Stream Types",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trade"
        },
        {
          "id": "aggTrade",
          "name": "Aggregated Trade"
        },
        {
          "id": "kline",
          "name": "Kline (Candlestick)"
        },
        {
          "id": "miniTicker",
          "name": "Mini Ticker"
        },
        {
          "id": "ticker",
          "name": "Ticker (24h)"
        },
        {
          "id": "bookTicker",
          "name": "Book Ticker"
        },
        {
          "id": "depth",
          "name": "Depth (Order Book)"
        },
        {
          "id": "ORDER_TRADE_UPDATE",
          "name": "Trade Updates (Fills)",
          "valueMap": {
            "field": "marketType",
            "values": {
              "spot": "executionReport",
              "futures": "ORDER_TRADE_UPDATE"
            }
          }
        }
      ],
      "default": [],
      "description": "Optional \u2014 only receive these event types. Leave empty for all.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "onlyClosedBars",
      "label": "Only Closed Bars",
      "type": "toggle",
      "default": true,
      "description": "When enabled, only forward kline events with isClosed=true. Disable to receive every tick update.",
      "showDescription": false
    }
  ]
}
