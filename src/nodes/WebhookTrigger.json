{
  "name": "WebhookTrigger",
  "type": "trigger",
  "category": "Trigger",
  "subCategory": "webhook",
  "icon": "webhook",
  "description": "Receive HTTP webhooks from external services",
  "color": "text-purple-500",
  "size": {
    "width": 360,
    "height": 340
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "fields": [
    {
      "key": "webhookUrl",
      "label": "Webhook URL",
      "type": "webhookUrl",
      "required": false
    },
    {
      "key": "httpMethod",
      "label": "HTTP Method",
      "type": "select",
      "options": [
        { "label": "All Methods", "value": "ALL" },
        { "label": "GET", "value": "GET" },
        { "label": "POST", "value": "POST" },
        { "label": "PUT", "value": "PUT" },
        { "label": "PATCH", "value": "PATCH" },
        { "label": "DELETE", "value": "DELETE" },
        { "label": "HEAD", "value": "HEAD" }
      ],
      "default": "POST",
      "required": false
    },
    {
      "key": "secret",
      "label": "Webhook Secret (Optional)",
      "type": "password",
      "placeholder": "For HMAC signature verification",
      "required": false
    },
    {
      "key": "filterEvents",
      "label": "Filter Event Types",
      "type": "tags",
      "placeholder": "e.g., push, pull_request",
      "required": false,
      "default": []
    }
  ],
  "output": {
    "webhookPayload": {
      "timestamp": "ISO 8601 timestamp",
      "method": "HTTP method",
      "headers": "Request headers (sensitive ones redacted)",
      "body": "Request body",
      "query": "Query parameters",
      "raw": "Complete raw request data"
    }
  }
}
