{
  "name": "AlpacaSubscribe",
  "def": "Alpaca Subscribe",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Broker",
  "subCategory": "Alpaca",
  "description": "Subscribe or unsubscribe to Alpaca real-time market data. Subscriptions persist and can be received by any activated AlpacaStreamData trigger.",
  "color": "text-yellow-500",
  "size": { "width": 380, "height": 420 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    { "key": "credential_name", "label": "Credential Label", "type": "text", "default": "My Alpaca" },
    { "key": "api_key", "label": "API Key", "type": "password", "required": true },
    { "key": "secret_key", "label": "Secret Key", "type": "password", "required": true }
  ],
  "authAction": { "url": "/broker/alpaca/auth", "method": "POST" },
  "action": { "url": "/market/alpaca/subscribe", "method": "POST" },
  "fields": [
    { 
      "key": "credential_id", 
      "label": "Credential", 
      "type": "select", 
      "optionsSource": "credentialsApi", 
      "placeholder": "Select credential",
      "required": true 
    },
    { 
      "key": "operation", 
      "label": "Operation", 
      "type": "select",
      "options": [
        { "id": "subscribe", "name": "Subscribe" },
        { "id": "unsubscribe", "name": "Unsubscribe" }
      ],
      "default": "subscribe",
      "required": true
    },
    { 
      "key": "stream_types", 
      "label": "Stream Types", 
      "type": "multiselect",
      "options": [
        { "id": "trade", "name": "Trades" },
        { "id": "quote", "name": "Quotes" },
        { "id": "bar", "name": "Minute Bars" },
        { "id": "daily_bar", "name": "Daily Bars" }
      ],
      "default": ["trade"],
      "description": "Select data stream types to subscribe to",
      "required": true
    },
    { 
      "key": "symbolSource", 
      "label": "Symbol Source", 
      "type": "select", 
      "options": [
        { "id": "manual", "name": "Enter Manually" },
        { "id": "store", "name": "From Store Variable" },
        { "id": "input", "name": "From Input" }
      ],
      "default": "manual", 
      "required": true 
    },
    { 
      "key": "symbols", 
      "label": "Symbols", 
      "type": "text", 
      "placeholder": "AAPL, TSLA, MSFT",
      "description": "Comma-separated symbols or * for all",
      "displayOptions": { "show": { "symbolSource": ["manual"] } }, 
      "required": false 
    },
    { 
      "key": "sourceWorkflowId", 
      "label": "Source Workflow", 
      "type": "select",
      "optionsSource": "storeWorkflowsApi",
      "placeholder": "Select workflow containing symbols",
      "displayOptions": { "show": { "symbolSource": ["store"] } }
    },
    { 
      "key": "sourceVariable", 
      "label": "Variable Name", 
      "type": "select",
      "optionsSource": "storeVariablesApi",
      "dependsOn": "sourceWorkflowId",
      "placeholder": "Select stored variable",
      "displayOptions": { "show": { "symbolSource": ["store"] } }
    },
    { 
      "key": "feed", 
      "label": "Data Feed", 
      "type": "select",
      "options": [
        { "id": "iex", "name": "IEX (Free - Regular Hours)" },
        { "id": "sip", "name": "SIP (Paid - Extended Hours)" }
      ],
      "default": "iex",
      "description": "SIP feed requires Alpaca subscription for pre/after-market data",
      "required": true
    }
  ]
}
