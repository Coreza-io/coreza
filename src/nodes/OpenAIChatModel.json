{
  "name": "OpenAIChatModel",
  "def": "OpenAI Chat Model",
  "node_type": "sub",
  "category": "ChatModel",
  "provider": "openai",
  "icon": "/assets/icons/openai.svg",
  "size": { "width": 300, "height": 280 },
  "handles": [{ "type": "source", "position": "top", "id": "chatModel" }],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "OpenAI API"
    },
    {
      "key": "apiKey",
      "label": "OpenAI API Key",
      "type": "password",
      "placeholder": "sk-..."
    }
  ],
  "authAction": { "url": "/openai/auth", "method": "POST" },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "model",
      "label": "Model",
      "type": "select",
      "default": "gpt-4o-mini",
      "options": [
        { "label": "GPT-4o", "value": "gpt-4o" },
        { "label": "GPT-4o Mini", "value": "gpt-4o-mini" },
        { "label": "GPT-4 Turbo", "value": "gpt-4-turbo" },
        { "label": "GPT-3.5 Turbo", "value": "gpt-3.5-turbo" },
        {
          "label": "GPT-4o Search",
          "value": "gpt-4o-search-preview",
          "noTemperature": true,
          "modelKwargs": { "web_search_options": {} }
        },
        {
          "label": "GPT-4o Mini Search",
          "value": "gpt-4o-mini-search-preview",
          "noTemperature": true,
          "modelKwargs": { "web_search_options": {} }
        }
      ],
      "required": true
    },
    {
      "key": "temperature",
      "label": "Temperature",
      "type": "number",
      "default": 0.7,
      "description": "Not applicable for Search models (gpt-4o-search-preview, gpt-4o-mini-search-preview).",
      "displayOptions": {
        "hide": {
          "model": ["gpt-4o-search-preview", "gpt-4o-mini-search-preview"]
        }
      },
      "required": false
    },
    {
      "key": "maxTokens",
      "label": "Max Tokens",
      "type": "number",
      "default": 1000,
      "required": false
    }
  ]
}
