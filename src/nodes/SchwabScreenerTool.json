{
  "name": "SchwabScreenerTool",
  "def": "Schwab Screener",
  "node_type": "sub",
  "icon": "/assets/icons/schwab.svg",
  "category": "Tool",
  "subCategory": "Schwab",
  "description": "Screen stocks using Schwab API. Get fundamentals (quote, financial data, reference info), market movers by index, search instruments, and lookup by CUSIP.",
  "color": "text-blue-600",
  "size": { "width": 360, "height": 400 },
  "handles": [
    { "type": "source", "position": "top", "id": "tool" }
  ],
  "auth": "SchwabAuthModal",
  "action": {
    "url": "/screener/schwab/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select Schwab credential",
      "description": "Your saved Schwab OAuth credential.",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "id": "get_fundamentals", "name": "Get Fundamentals (Enrich Symbols)" },
        { "id": "movers", "name": "Market Movers" },
        { "id": "get_instruments", "name": "Search Instruments" },
        { "id": "get_instrument_cusip", "name": "Get Instrument by CUSIP" }
      ],
      "default": "get_fundamentals",
      "required": true,
      "description": "Screener operation: Fundamentals enriches symbols with data, Movers shows top gainers/losers, Search finds symbols, CUSIP looks up by ID."
    },
    {
      "key": "symbols",
      "label": "Symbols (comma-separated)",
      "type": "text",
      "placeholder": "AAPL,TSLA,MSFT",
      "description": "Comma-separated list of stock symbols to get fundamentals for.",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["get_fundamentals"]
        }
      }
    },
    {
      "key": "fields",
      "label": "Data Fields",
      "type": "select",
      "options": [
        { "id": "quote,fundamental,reference", "name": "All (Quote + Fundamental + Reference)" },
        { "id": "quote,fundamental", "name": "Quote + Fundamental" },
        { "id": "fundamental", "name": "Fundamental Only" },
        { "id": "quote", "name": "Quote Only" },
        { "id": "reference", "name": "Reference Only" }
      ],
      "default": "quote,fundamental,reference",
      "description": "Types of data to return: Quote (price data), Fundamental (financial ratios), Reference (company info).",
      "displayOptions": {
        "show": {
          "operation": ["get_fundamentals"]
        }
      }
    },
    {
      "key": "index",
      "label": "Market Index",
      "type": "select",
      "options": [
        { "id": "$DJI", "name": "Dow Jones ($DJI)" },
        { "id": "$COMPX", "name": "NASDAQ Composite ($COMPX)" },
        { "id": "$SPX.X", "name": "S&P 500 ($SPX.X)" }
      ],
      "default": "$DJI",
      "description": "Market index to get movers for.",
      "displayOptions": {
        "show": {
          "operation": ["movers"]
        }
      }
    },
    {
      "key": "direction",
      "label": "Direction",
      "type": "select",
      "options": [
        { "id": "up", "name": "Gainers (Up)" },
        { "id": "down", "name": "Losers (Down)" }
      ],
      "default": "up",
      "description": "Filter for gainers (up) or losers (down).",
      "displayOptions": {
        "show": {
          "operation": ["movers"]
        }
      }
    },
    {
      "key": "change",
      "label": "Change Type",
      "type": "select",
      "options": [
        { "id": "percent", "name": "Percent Change" },
        { "id": "value", "name": "Dollar Value Change" }
      ],
      "default": "percent",
      "description": "Rank movers by percentage change or absolute dollar change.",
      "displayOptions": {
        "show": {
          "operation": ["movers"]
        }
      }
    },
    {
      "key": "symbol",
      "label": "Symbol or Pattern",
      "type": "text",
      "placeholder": "AAPL or APP*",
      "description": "Symbol or pattern for instrument search. Use * as wildcard (e.g., APP* matches AAPL, APPS, etc.).",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["get_instruments"]
        }
      }
    },
    {
      "key": "projection",
      "label": "Search Type",
      "type": "select",
      "options": [
        { "id": "symbol-search", "name": "Symbol Search" },
        { "id": "symbol-regex", "name": "Symbol Regex" },
        { "id": "desc-search", "name": "Description Search" },
        { "id": "desc-regex", "name": "Description Regex" },
        { "id": "fundamental", "name": "Fundamental" }
      ],
      "default": "symbol-search",
      "description": "Search method: symbol/description search or regex pattern matching.",
      "displayOptions": {
        "show": {
          "operation": ["get_instruments"]
        }
      }
    },
    {
      "key": "cusip",
      "label": "CUSIP",
      "type": "text",
      "placeholder": "037833100 (AAPL CUSIP)",
      "description": "CUSIP identifier (9-character security ID used by US/Canada).",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["get_instrument_cusip"]
        }
      }
    }
  ]
}
