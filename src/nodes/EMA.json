{
  "name": "EMA",
  "def": "Exponential Moving Average",
  "node_type": "main",
  "icon": "/assets/icons/ema.svg",
  "category": "Indicators",
  "description": "Exponential Moving Average indicator",
  "color": "text-blue-500",
  "size": {
    "width": 300,
    "height": 280
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/ema",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true
    },
    {
      "key": "window",
      "label": "EMA Window",
      "type": "text",
      "placeholder": "e.g. 20",
      "default": "20",
      "required": true
    }
  ]
}
