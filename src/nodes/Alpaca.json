{
  "name": "Alpaca",
  "def": "Alpaca",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Broker",
  "description": "Execute trades and get market data from Alpaca Markets",
  "color": "text-green-600",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "placeholder": "Your Alpaca API Key"
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "placeholder": "Your Alpaca Secret Key"
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/broker/alpaca/{{operation}}",
    "method": "{{method}}"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true,
      "description": "Your saved Alpaca API credential."
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "paper",
          "name": "Paper Trading (Sandbox)"
        },
        {
          "id": "live",
          "name": "Live Trading (Production)"
        }
      ],
      "default": "paper",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_account",
            "get_positions",
            "get_orders",
            "get_order",
            "get_trades",
            "cancel_order",
            "cancel_all_orders",
            "place_order",
            "close_position"
          ]
        }
      },
      "description": "Paper for testing/simulation, Live for real money trading."
    },
    {
      "key": "assetType",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "stock",
          "name": "Stock"
        },
        {
          "id": "crypto",
          "name": "Crypto"
        }
      ],
      "default": "stock",
      "required": true,
      "description": "Type of asset: US stocks or cryptocurrency."
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "get_account",
          "name": "Get Account",
          "method": "POST"
        },
        {
          "id": "get_positions",
          "name": "Get Positions",
          "method": "POST"
        },
        {
          "id": "get_orders",
          "name": "Get Orders",
          "method": "POST"
        },
        {
          "id": "get_order",
          "name": "Get Order",
          "method": "POST"
        },
        {
          "id": "get_trades",
          "name": "Get Trades",
          "method": "POST"
        },
        {
          "id": "cancel_order",
          "name": "Cancel Order",
          "method": "POST"
        },
        {
          "id": "cancel_all_orders",
          "name": "Cancel All Orders",
          "method": "POST"
        },
        {
          "id": "get_candle",
          "name": "Get Historical Bars",
          "method": "POST"
        },
        {
          "id": "get_latest_bar",
          "name": "Get Latest Bar",
          "method": "POST"
        },
        {
          "id": "fetch_news",
          "name": "Get News",
          "method": "POST"
        },
        {
          "id": "place_order",
          "name": "Place Order",
          "method": "POST"
        },
        {
          "id": "close_position",
          "name": "Close Position",
          "method": "POST"
        }
      ],
      "placeholder": "Select operation",
      "required": true,
      "description": "Action to perform: fetch account info, positions, orders, or market data."
    },
    {
      "key": "order_id",
      "label": "Order ID",
      "type": "text",
      "placeholder": "Order UUID",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "cancel_order",
            "get_order"
          ]
        }
      },
      "description": "Order UUID for single-order lookup/cancel operations."
    },
    {
      "key": "symbol",
      "label": "Stock Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "get_latest_bar",
            "fetch_news",
            "place_order",
            "close_position"
          ],
          "assetType": [
            "stock"
          ]
        }
      },
      "description": "Ticker symbol for market data operations."
    },
    {
      "key": "crypto_base",
      "label": "Base Asset",
      "type": "text",
      "placeholder": "e.g. BTC, ETH",
      "description": "The cryptocurrency to trade (e.g. BTC, ETH, DOGE).",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "get_latest_bar",
            "place_order",
            "close_position"
          ],
          "assetType": [
            "crypto"
          ]
        }
      }
    },
    {
      "key": "crypto_quote",
      "label": "Quote Currency",
      "type": "select",
      "options": [
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "BTC",
          "name": "BTC"
        }
      ],
      "default": "USD",
      "description": "The currency to price against.",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "get_latest_bar",
            "place_order",
            "close_position"
          ],
          "assetType": [
            "crypto"
          ]
        }
      }
    },
    {
      "key": "interval",
      "label": "Interval",
      "type": "select",
      "options": [
        {
          "id": "1Min",
          "name": "1 min"
        },
        {
          "id": "5Min",
          "name": "5 min"
        },
        {
          "id": "15Min",
          "name": "15 min"
        },
        {
          "id": "1Hour",
          "name": "1 hour"
        },
        {
          "id": "1Day",
          "name": "1 day"
        }
      ],
      "placeholder": "Select interval",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle"
          ]
        }
      },
      "description": "Time interval between data bars."
    },
    {
      "key": "limit",
      "label": "Bars to Fetch",
      "type": "text",
      "placeholder": "e.g. 100",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "fetch_news"
          ]
        }
      },
      "description": "Number of historical bars to retrieve."
    },
    {
      "key": "feed",
      "label": "Data Feed",
      "type": "select",
      "options": [
        {
          "id": "sip",
          "name": "SIP - All US Exchanges"
        },
        {
          "id": "iex",
          "name": "IEX - Investors Exchange"
        },
        {
          "id": "delayed_sip",
          "name": "Delayed SIP (15 min)"
        },
        {
          "id": "otc",
          "name": "OTC - Over-the-counter"
        },
        {
          "id": "boats",
          "name": "BOATS - Blue Ocean"
        },
        {
          "id": "overnight",
          "name": "Overnight Data"
        }
      ],
      "default": "sip",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_latest_bar",
            "get_candle"
          ],
          "assetType": [
            "stock"
          ]
        }
      },
      "description": "Market data feed source. SIP includes all US exchanges, IEX is free tier."
    },
    {
      "key": "currency",
      "label": "Currency",
      "type": "text",
      "placeholder": "e.g. USD",
      "default": "USD",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_latest_bar"
          ]
        }
      },
      "description": "Currency for pricing data."
    },
    {
      "key": "sort",
      "label": "Sort",
      "type": "select",
      "options": [
        {
          "id": "asc",
          "name": "asc"
        },
        {
          "id": "desc",
          "name": "desc"
        }
      ],
      "default": "asc",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "fetch_news"
          ]
        }
      },
      "description": "Sort order for historical bars: ascending (oldest first) or descending (newest first)."
    },
    {
      "key": "start",
      "label": "Start Date",
      "type": "text",
      "placeholder": "2024-01-03T00:00:00Z or 2024-01-03",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "fetch_news"
          ]
        }
      },
      "description": "Start date/time for historical data range. ISO 8601 format."
    },
    {
      "key": "end",
      "label": "End Date",
      "type": "text",
      "placeholder": "2024-01-04T00:00:00Z or 2024-01-04",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "get_candle",
            "fetch_news"
          ]
        }
      },
      "description": "End date/time for historical data range. ISO 8601 format."
    },
    {
      "key": "include_content",
      "label": "Include Full Content",
      "type": "select",
      "options": [
        {
          "id": "true",
          "name": "Yes"
        },
        {
          "id": "false",
          "name": "No"
        }
      ],
      "default": "false",
      "description": "Include full article content (may increase response size)",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "fetch_news"
          ]
        }
      }
    },
    {
      "key": "page_token",
      "label": "Page Token",
      "type": "text",
      "placeholder": "For pagination (optional)",
      "description": "Token from previous response for pagination",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "fetch_news"
          ]
        }
      }
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "options": [
        {
          "id": "buy",
          "name": "Buy"
        },
        {
          "id": "sell",
          "name": "Sell"
        }
      ],
      "default": "buy",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Buy to open/add position, Sell to close/reduce position."
    },
    {
      "key": "qty",
      "label": "Quantity",
      "type": "text",
      "placeholder": "e.g. 1",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order",
            "close_position"
          ]
        }
      },
      "description": "Number of shares/units to trade. Supports fractional for crypto."
    },
    {
      "key": "percentage",
      "label": "Percentage",
      "type": "text",
      "placeholder": "e.g. 50",
      "required": false,
      "displayOptions": {
        "show": {
          "operation": [
            "close_position"
          ]
        }
      }
    },
    {
      "key": "type",
      "label": "Order Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market Order"
        },
        {
          "id": "limit",
          "name": "Limit Order"
        },
        {
          "id": "stop",
          "name": "Stop Order"
        },
        {
          "id": "trailing_stop",
          "name": "Trailing Stop Order"
        }
      ],
      "default": "market",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ]
        }
      },
      "description": "Market executes immediately, Limit at specified price, Stop triggers at price, Trailing Stop follows price."
    },
    {
      "key": "limit_price",
      "label": "Limit Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 1",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "type": "limit"
        }
      },
      "description": "Price for limit order. Order fills at this price or better."
    },
    {
      "key": "stop_price",
      "label": "Stop Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 1",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "type": "stop"
        }
      },
      "description": "Trigger price for stop order. Order activates when price reaches this level."
    },
    {
      "key": "trail_price",
      "label": "Trailing Price",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 0.20",
      "description": "Dollar amount to trail. Required if trail_percent is not provided",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "trail_percent",
      "label": "Trailing Percentage",
      "type": "text",
      "required": false,
      "placeholder": "e.g. 0.20",
      "description": "Percentage to trail (0-1). Required if trail_price is not provided",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "type": "trailing_stop"
        }
      },
      "showDescription": false
    },
    {
      "key": "time_in_force",
      "label": "Time In Force",
      "type": "select",
      "options": [
        {
          "id": "day",
          "name": "Day"
        },
        {
          "id": "gtc",
          "name": "Good Till Cancelled (GTC)"
        },
        {
          "id": "opg",
          "name": "Market/Limit on Open (OPG)"
        },
        {
          "id": "cls",
          "name": "Market/Limit on Close (CLS)"
        },
        {
          "id": "ioc",
          "name": "Immediate Or Cancel (IOC)"
        },
        {
          "id": "fok",
          "name": "Fill Or Kill (FOK)"
        }
      ],
      "default": "day",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "assetType": [
            "stock",
            "crypto"
          ]
        }
      },
      "description": "How long order stays active. Day expires at market close, GTC stays until filled/cancelled."
    },
    {
      "key": "extended_hours",
      "label": "Extended Hours",
      "type": "select",
      "options": [
        {
          "id": "false",
          "name": "Regular Hours Only"
        },
        {
          "id": "true",
          "name": "Include Pre/After Market"
        }
      ],
      "default": "false",
      "required": false,
      "description": "Enable execution during pre-market and after-hours. Only available for limit orders with day time-in-force.",
      "displayOptions": {
        "show": {
          "operation": [
            "place_order"
          ],
          "type": [
            "limit"
          ],
          "time_in_force": [
            "day"
          ],
          "assetType": [
            "stock"
          ]
        }
      },
      "showDescription": false
    }
  ]
}
