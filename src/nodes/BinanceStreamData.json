{
  "name": "BinanceStreamData",
  "def": "Binance Stream Data",
  "node_type": "trigger",
  "icon": "/assets/icons/binance.svg",
  "category": "Market",
  "subCategory": "binance",
  "executionMode": "streaming",
  "action": {
    "url": "/stream/binance/register",
    "method": "POST"
  },
  "streamingConfig": {
    "waitForFirstEvent": false,
    "timeout": 300000,
    "listeningFlag": "isTestListening",
    "subscribeListeningFlag": "isStreamingWaiting",
    "recoveryPolling": {
      "endpoint": "/market/stream-test-result/{{workflow_id}}/{{node_id}}",
      "interval": 10000
    }
  },
  "description": "Receives real-time market data from Binance. Use Listen mode to receive pre-subscribed symbols, or Subscribe mode to subscribe and stream in one node.",
  "color": "text-yellow-500",
  "size": {
    "width": 320,
    "height": 280
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Binance"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true
    }
  ],
  "authAction": {
    "url": "/broker/binance/auth",
    "method": "POST"
  },
  "fields": [
    {
      "key": "data_type",
      "type": "hidden",
      "default": "market"
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        {
          "id": "listen",
          "name": "Listen (Use Pre-subscribed Symbols)"
        },
        {
          "id": "subscribe",
          "name": "Subscribe & Stream (Self-contained)"
        }
      ],
      "default": "listen",
      "description": "Listen mode uses symbols from Subscribe nodes. Subscribe mode subscribes symbols directly.",
      "showDescription": false
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": false
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "testnet",
          "name": "Testnet (Paper)"
        },
        {
          "id": "live",
          "name": "Production (Live)"
        }
      ],
      "default": "testnet",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "asset_type",
      "label": "Asset Type",
      "type": "select",
      "options": [
        {
          "id": "spot",
          "name": "Spot"
        },
        {
          "id": "futures",
          "name": "Futures (USDT-M)"
        }
      ],
      "default": "spot",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "BTCUSDT, ETHUSDT",
      "description": "Symbols to subscribe and stream.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "showDescription": false
    },
    {
      "key": "stream_types",
      "label": "Stream Type",
      "type": "select",
      "options": [
        {
          "id": "trade",
          "name": "Trade - Individual trades (high frequency)"
        },
        {
          "id": "aggTrade",
          "name": "Aggregated Trade - Grouped trades (less noise)"
        },
        {
          "id": "kline",
          "name": "Kline (Candlestick) - OHLCV data"
        },
        {
          "id": "miniTicker",
          "name": "Mini Ticker - Lightweight price updates"
        },
        {
          "id": "ticker",
          "name": "Ticker (24h) - 24h statistics"
        },
        {
          "id": "bookTicker",
          "name": "Book Ticker - Best bid/ask"
        },
        {
          "id": "depth",
          "name": "Depth (Order Book) - Bid/ask levels"
        }
      ],
      "default": "kline",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "interval",
      "label": "Kline Interval",
      "type": "select",
      "options": [
        {
          "id": "1m",
          "name": "1 Minute"
        },
        {
          "id": "3m",
          "name": "3 Minutes"
        },
        {
          "id": "5m",
          "name": "5 Minutes"
        },
        {
          "id": "15m",
          "name": "15 Minutes"
        },
        {
          "id": "30m",
          "name": "30 Minutes"
        },
        {
          "id": "1h",
          "name": "1 Hour"
        },
        {
          "id": "2h",
          "name": "2 Hours"
        },
        {
          "id": "4h",
          "name": "4 Hours"
        },
        {
          "id": "6h",
          "name": "6 Hours"
        },
        {
          "id": "8h",
          "name": "8 Hours"
        },
        {
          "id": "12h",
          "name": "12 Hours"
        },
        {
          "id": "1d",
          "name": "1 Day"
        },
        {
          "id": "3d",
          "name": "3 Days"
        },
        {
          "id": "1w",
          "name": "1 Week"
        },
        {
          "id": "1M",
          "name": "1 Month"
        }
      ],
      "default": "1m",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"],
          "stream_types": ["kline"]
        }
      }
    },
    {
      "key": "depth_levels",
      "label": "Order Book Depth",
      "type": "select",
      "options": [
        {
          "id": "5",
          "name": "Top 5 Levels"
        },
        {
          "id": "10",
          "name": "Top 10 Levels"
        },
        {
          "id": "20",
          "name": "Top 20 Levels"
        }
      ],
      "default": "10",
      "displayOptions": {
        "show": {
          "stream_types": ["depth"]
        }
      }
    },
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        {
          "id": "workflow",
          "name": "Only This Workflow's Subscriptions"
        },
        {
          "id": "global",
          "name": "All My Subscriptions"
        }
      ],
      "default": "workflow",
      "description": "Receive only symbols subscribed targeting this workflow, or all your global subscriptions.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "onlyClosedBars",
      "label": "Only Closed Bars",
      "type": "checkbox",
      "default": true,
      "description": "Only emit bar/kline data when the candle is closed. Disable to receive all streaming updates.",
      "displayOptions": {
        "show": {
          "mode": ["listen"],
          "stream_types": ["kline"]
        }
      },
      "showDescription": true
    }
  ]
}
