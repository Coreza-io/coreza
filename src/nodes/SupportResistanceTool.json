{
  "name": "SupportResistanceTool",
  "def": "Support and Resistance Levels",
  "node_type": "sub",
  "icon": "/assets/icons/support-resistance.svg",
  "category": "Tool",
  "description": "Calculate support and resistance levels using multiple methods",
  "color": "text-purple-500",
  "size": {
    "width": 360,
    "height": 320
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "action": {
    "url": "/indicators/support-resistance",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data (OHLC)",
      "type": "text",
      "description": "The dataRef string returned from a market data tool (YahooFinanceTool, PolygonTool, etc). You MUST first call a market data tool, wait for its response containing dataRef, then use that exact dataRef value here. Do NOT guess or invent this value.",
      "required": true
    },
    {
      "key": "method",
      "label": "Calculation Method",
      "type": "select",
      "options": [
        {
          "value": "pivot",
          "label": "Pivot Points (Classic)"
        },
        {
          "value": "swing",
          "label": "Swing High/Low (Price Action)"
        },
        {
          "value": "historical",
          "label": "Historical High/Low"
        }
      ],
      "default": "pivot",
      "required": true
    },
    {
      "key": "lookback_period",
      "label": "Lookback Period",
      "type": "text",
      "default": "20",
      "placeholder": "e.g. 20"
    },
    {
      "key": "sensitivity",
      "label": "Sensitivity (%)",
      "type": "text",
      "default": "1.0",
      "placeholder": "e.g. 1.0"
    },
    {
      "key": "num_levels",
      "label": "Number of Levels",
      "type": "text",
      "default": "3",
      "placeholder": "e.g. 3"
    }
  ]
}