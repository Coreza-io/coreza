{
  "name": "BinanceScreenerTool",
  "def": "Binance Screener",
  "node_type": "sub",
  "icon": "/assets/icons/binance.svg",
  "category": "Tool",
  "subCategory": "binance",
  "description": "Screen crypto assets on Binance. Find top gainers, losers, most active by volume, and new listings for spot and futures markets.",
  "color": "text-yellow-400",
  "size": {
    "width": 340,
    "height": 340
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "tool"
    }
  ],
  "action": {
    "url": "/screener/binance/{{filter_type}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "description": "Your saved Binance API credential.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "name": "Testnet (Paper)",
          "id": "testnet"
        },
        {
          "name": "Production (Live)",
          "id": "live"
        }
      ],
      "default": "testnet",
      "description": "Testnet for testing, Production for real market data.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "assetType",
      "type": "hidden",
      "default": "crypto"
    },
    {
      "key": "marketType",
      "label": "Market Type",
      "type": "select",
      "options": [
        {
          "name": "Spot",
          "id": "spot"
        },
        {
          "name": "Futures",
          "id": "futures"
        }
      ],
      "default": "spot",
      "description": "Market type: Spot for regular trading, Futures for derivatives.",
      "required": true,
      "showDescription": false
    },
    {
      "key": "filter_type",
      "label": "Filter Type",
      "type": "select",
      "options": [
        {
          "name": "Top Gainers",
          "id": "top_gainers"
        },
        {
          "name": "Top Losers",
          "id": "top_losers"
        },
        {
          "name": "Most Active by Volume",
          "id": "most_active"
        },
        {
          "name": "New Listings",
          "id": "new_listings"
        }
      ],
      "default": "top_gainers",
      "required": true,
      "description": "Screening criteria: Top Gainers/Losers by price change, Most Active by 24h volume, New Listings for recently added pairs.",
      "showDescription": false
    },
    {
      "key": "limit",
      "label": "Limit",
      "type": "text",
      "default": "10",
      "placeholder": "Number of results",
      "required": true,
      "description": "Maximum number of results to return.",
      "showDescription": false
    },
    {
      "key": "quote_asset",
      "label": "Quote Asset",
      "type": "select",
      "options": [
        {
          "name": "USDT",
          "id": "USDT"
        },
        {
          "name": "BUSD",
          "id": "BUSD"
        },
        {
          "name": "BTC",
          "id": "BTC"
        },
        {
          "name": "ETH",
          "id": "ETH"
        }
      ],
      "default": "USDT",
      "description": "Quote currency to filter pairs (e.g., USDT shows only *USDT pairs).",
      "displayOptions": {
        "show": {
          "asset_type": ["spot"]
        }
      },
      "showDescription": false
    },
    {
      "key": "min_volume",
      "label": "Min Volume (24h)",
      "type": "text",
      "placeholder": "Minimum 24h volume",
      "description": "Minimum 24-hour trading volume in quote currency.",
      "displayOptions": {
        "show": {
          "filter_type": ["most_active"]
        }
      },
      "showDescription": false
    },
    {
      "key": "min_price_change",
      "label": "Min Price Change %",
      "type": "text",
      "placeholder": "Minimum price change percentage",
      "description": "Minimum absolute price change percentage to include.",
      "displayOptions": {
        "show": {
          "filter_type": ["top_gainers", "top_losers"]
        }
      },
      "showDescription": false
    }
  ]
}
