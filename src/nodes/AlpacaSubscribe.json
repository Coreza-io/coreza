{
  "name": "AlpacaSubscribe",
  "def": "Alpaca Subscribe",
  "node_type": "main",
  "icon": "/assets/icons/alpaca.svg",
  "category": "Market",
  "subCategory": "alpaca",
  "description": "Subscribe or unsubscribe to Alpaca real-time market data or news. Subscriptions persist and can be received by any activated AlpacaStreamData trigger.",
  "color": "text-yellow-500",
  "size": {
    "width": 380,
    "height": 480
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Alpaca"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true
    }
  ],
  "authAction": {
    "url": "/broker/alpaca/auth",
    "method": "POST"
  },
  "action": {
    "url": "/stream/alpaca/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "data_type",
      "label": "Data Type",
      "type": "select",
      "options": [
        {
          "id": "market",
          "name": "Market Data (Trades, Quotes, Bars)"
        },
        {
          "id": "crypto",
          "name": "Crypto (BTC/USD, ETH/USD)"
        },
        {
          "id": "news",
          "name": "News"
        }
      ],
      "default": "market",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "subscribe",
          "name": "Subscribe"
        },
        {
          "id": "unsubscribe",
          "name": "Unsubscribe"
        }
      ],
      "default": "subscribe",
      "required": true
    },
    {
      "key": "stream_types",
      "label": "Stream Types",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trades"
        },
        {
          "id": "quote",
          "name": "Quotes"
        },
        {
          "id": "bar",
          "name": "Bars"
        },
        {
          "id": "daily_bar",
          "name": "Daily Bars"
        },
        {
          "id": "order_update",
          "name": "Order Updates (Fills)"
        }
      ],
      "default": ["trade"],
      "description": "Select data stream types to subscribe to",
      "required": true,
      "showDescription": false,
      "displayOptions": {
        "show": {
          "data_type": ["market", "crypto"]
        }
      }
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "AAPL, TSLA or BTC/USD, ETH/USD",
      "description": "Comma-separated symbols or * for all",
      "required": true,
      "showDescription": false,
      "displayOptions": {
        "show": {
          "data_type": ["market", "news"]
        }
      }
    },
    {
      "key": "crypto_base",
      "label": "Base Asset(s)",
      "type": "text",
      "placeholder": "e.g. BTC, ETH",
      "description": "Comma-separated crypto bases (e.g. BTC, ETH, DOGE).",
      "required": true,
      "showDescription": false,
      "displayOptions": {
        "show": {
          "data_type": ["crypto"]
        }
      }
    },
    {
      "key": "crypto_quote",
      "label": "Quote Currency",
      "type": "select",
      "options": [
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "BTC",
          "name": "BTC"
        }
      ],
      "default": "USD",
      "description": "The currency to price against.",
      "required": true,
      "showDescription": false,
      "displayOptions": {
        "show": {
          "data_type": ["crypto"]
        }
      }
    },
    {
      "key": "feed",
      "label": "Data Feed",
      "type": "select",
      "options": [
        {
          "id": "iex",
          "name": "IEX (Free - Regular Hours)"
        },
        {
          "id": "sip",
          "name": "SIP (Paid - Extended Hours)"
        },
        {
          "id": "test",
          "name": "Test (FAKEPACA - Always Active)"
        }
      ],
      "default": "iex",
      "description": "SIP feed requires Alpaca subscription for pre/after-market data",
      "required": true,
      "showDescription": false,
      "displayOptions": {
        "show": {
          "data_type": ["market"]
        }
      },
      "hideOptions": {
        "show": {
          "data_type": ["crypto"]
        }
      }
    },
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        {
          "id": "global",
          "name": "Global (All Workflows)"
        },
        {
          "id": "workflow",
          "name": "Specific Workflow Only"
        }
      ],
      "default": "global",
      "description": "Choose who can access this subscription",
      "required": true,
      "showDescription": false
    },
    {
      "key": "targetWorkflowId",
      "label": "Target Workflow",
      "type": "select",
      "options": [
        {
          "id": "__current__",
          "name": "This Workflow (Current)"
        }
      ],
      "optionsSource": "storeWorkflowsApi",
      "placeholder": "Select workflow to receive data",
      "displayOptions": {
        "show": {
          "subscriptionScope": ["workflow"]
        }
      },
      "default": "__current__"
    }
  ]
}
