{
  "name": "RedisChatMemory",
  "def": "Redis Chat Memory",
  "node_type": "sub",
  "category": "Memory",
  "subCategory": "Redis",
  "icon": "/assets/icons/store.svg",
  "description": "Connects to a Redis instance you manage.",
  "size": {
    "width": 320,
    "height": 280
  },
  "handles": [
    {
      "type": "source",
      "position": "top",
      "id": "memory"
    }
  ],
  "auth": "GenericAuthModal",
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true,
      "optionsSourceParams": {
        "service_type": "redis"
      }
    },
    {
      "key": "sessionKey",
      "label": "Session Key",
      "type": "hidden",
      "default": ""
    },
    {
      "key": "contextWindowLength",
      "label": "Context Window Length",
      "type": "number",
      "default": 5,
      "required": true,
      "description": "Number of most recent user/assistant turns loaded into the prompt (\u2248 2\u00d7 messages)."
    },
    {
      "key": "sessionTTL",
      "label": "Session TTL (seconds)",
      "type": "number",
      "default": 0,
      "required": true,
      "description": "Time to live for session history in seconds. Use 0 to never expire."
    }
  ],
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Redis",
      "placeholder": "e.g., Production Redis"
    },
    {
      "key": "host",
      "label": "Host",
      "type": "text",
      "placeholder": "localhost or redis-12345.cloud.redislabs.com",
      "required": true
    },
    {
      "key": "port",
      "label": "Port",
      "type": "text",
      "default": "6379",
      "placeholder": "6379"
    },
    {
      "key": "password",
      "label": "Password",
      "type": "password",
      "placeholder": "Redis password (leave blank if none)"
    },
    {
      "key": "user",
      "label": "User (optional)",
      "type": "text",
      "placeholder": "Leave blank for password-only auth"
    },
    {
      "key": "database",
      "label": "Database Number",
      "type": "text",
      "default": "0",
      "placeholder": "0"
    },
    {
      "key": "tls",
      "label": "Use TLS",
      "type": "select",
      "options": [
        {
          "label": "No",
          "value": "false"
        },
        {
          "label": "Yes",
          "value": "true"
        }
      ],
      "default": "false"
    }
  ],
  "authAction": {
    "url": "/storage/redis/auth",
    "method": "POST"
  }
}
