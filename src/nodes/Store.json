{
  "name": "Store",
  "label": "Store",
  "def": "Store Variables",
  "node_type": "main",
  "icon": "/assets/icons/store.svg",
  "category": "Data",
  "subCategory": "Store",
  "description": "Persistent storage with full Redis data types. No external Redis required.",
  "color": "text-purple-500",
  "size": { "width": 360, "height": 520 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/storage/store/:operation", "method": "POST" },
  "fields": [
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        {
          "label": "local (this workflow only)",
          "value": "local"
        },
        {
          "label": "Global (shared across workflows)",
          "value": "global"
        }
      ],
      "default": "global",
      "description": "Determines key namespace",
      "showDescription": false
    },
    {
      "key": "dataType",
      "label": "Data Type",
      "type": "select",
      "options": [
        { "id": "string", "name": "String (key-value)" },
        { "id": "list", "name": "List (ordered array)" },
        { "id": "hash", "name": "Hash (object/dictionary)" },
        { "id": "set", "name": "Set (unique values)" },
        { "id": "sortedSet", "name": "Sorted Set (ranked)" },
        { "id": "utility", "name": "Utility (keys, ttl)" }
      ],
      "default": "string",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [],
      "required": true,
      "dependsOn": "dataType",
      "conditionalOptions": {
        "string": [
          { "id": "set", "name": "Set Value" },
          { "id": "get", "name": "Get Value" },
          { "id": "delete", "name": "Delete Key" },
          { "id": "increment", "name": "Increment (counter)" },
          { "id": "append", "name": "Append to Value" }
        ],
        "list": [
          { "id": "lpush", "name": "Push Left (prepend)" },
          { "id": "rpush", "name": "Push Right (append)" },
          { "id": "lpop", "name": "Pop Left" },
          { "id": "rpop", "name": "Pop Right" },
          { "id": "lrange", "name": "Get Range" },
          { "id": "llen", "name": "Get Length" },
          { "id": "lindex", "name": "Get by Index" },
          { "id": "lset", "name": "Set by Index" },
          { "id": "ltrim", "name": "Trim to Range" },
          { "id": "delete", "name": "Delete Key" }
        ],
        "hash": [
          { "id": "hset", "name": "Set Field" },
          { "id": "hget", "name": "Get Field" },
          { "id": "hgetall", "name": "Get All Fields" },
          { "id": "hdel", "name": "Delete Field" },
          { "id": "hkeys", "name": "Get Field Names" },
          { "id": "hvals", "name": "Get All Values" },
          { "id": "hexists", "name": "Field Exists?" },
          { "id": "hincrby", "name": "Increment Field" },
          { "id": "delete", "name": "Delete Key" }
        ],
        "set": [
          { "id": "sadd", "name": "Add Members" },
          { "id": "srem", "name": "Remove Members" },
          { "id": "smembers", "name": "Get All Members" },
          { "id": "sismember", "name": "Is Member?" },
          { "id": "scard", "name": "Get Size" },
          { "id": "sinter", "name": "Intersection" },
          { "id": "sunion", "name": "Union" },
          { "id": "sdiff", "name": "Difference" },
          { "id": "delete", "name": "Delete Key" }
        ],
        "sortedSet": [
          { "id": "zadd", "name": "Add with Score" },
          { "id": "zrange", "name": "Get by Rank" },
          { "id": "zscore", "name": "Get Score" },
          { "id": "zcount", "name": "Count in Range" },
          { "id": "zincrby", "name": "Increment Score" },
          { "id": "zrem", "name": "Remove Members" },
          { "id": "delete", "name": "Delete Key" }
        ],
        "utility": [
          { "id": "keys", "name": "List Keys (pattern)" },
          { "id": "exists", "name": "Key Exists?" },
          { "id": "expire", "name": "Set TTL" },
          { "id": "ttl", "name": "Get TTL" },
          { "id": "delete", "name": "Delete Key" }
        ]
      }
    },
    {
      "key": "variableSource",
      "label": "Variable Source",
      "type": "select",
      "options": [
        { "id": "manual", "name": "Manual Entry (Current Workflow)" },
        { "id": "store", "name": "From Store (Another Workflow)" }
      ],
      "default": "manual",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "get",
            "delete",
            "increment",
            "append",
            "lpop",
            "rpop",
            "lrange",
            "llen",
            "lindex",
            "ltrim",
            "hget",
            "hgetall",
            "hdel",
            "hkeys",
            "hvals",
            "hexists",
            "hincrby",
            "srem",
            "smembers",
            "sismember",
            "scard",
            "sinter",
            "sunion",
            "sdiff",
            "zrange",
            "zscore",
            "zcount",
            "zincrby",
            "zrem",
            "exists",
            "expire",
            "ttl"
          ]
        }
      }
    },
    {
      "key": "variableNameManual",
      "label": "Variable Name",
      "type": "text",
      "placeholder": "e.g., scanner_tickers",
      "required": true,
      "displayOptions": {
        "show": {
          "variableSource": ["manual"],
          "operation": [
            "get",
            "delete",
            "increment",
            "append",
            "lpop",
            "rpop",
            "lrange",
            "llen",
            "lindex",
            "ltrim",
            "hget",
            "hgetall",
            "hdel",
            "hkeys",
            "hvals",
            "hexists",
            "hincrby",
            "srem",
            "smembers",
            "sismember",
            "scard",
            "sinter",
            "sunion",
            "sdiff",
            "zrange",
            "zscore",
            "zcount",
            "zincrby",
            "zrem",
            "exists",
            "expire",
            "ttl"
          ]
        }
      }
    },
    {
      "key": "sourceWorkflowId",
      "label": "Source Workflow",
      "type": "select",
      "optionsSource": "storeWorkflowsApi",
      "placeholder": "Select workflow",
      "required": true,
      "displayOptions": {
        "show": {
          "variableSource": ["store"],
          "operation": [
            "get",
            "delete",
            "increment",
            "append",
            "lpop",
            "rpop",
            "lrange",
            "llen",
            "lindex",
            "ltrim",
            "hget",
            "hgetall",
            "hdel",
            "hkeys",
            "hvals",
            "hexists",
            "hincrby",
            "srem",
            "smembers",
            "sismember",
            "scard",
            "sinter",
            "sunion",
            "sdiff",
            "zrange",
            "zscore",
            "zcount",
            "zincrby",
            "zrem",
            "exists",
            "expire",
            "ttl"
          ]
        }
      }
    },
    {
      "key": "variableNameSelect",
      "label": "Variable Name",
      "type": "select",
      "optionsSource": "storeVariablesApi",
      "dependsOn": "sourceWorkflowId",
      "placeholder": "Select variable",
      "required": true,
      "displayOptions": {
        "show": {
          "variableSource": ["store"],
          "operation": [
            "get",
            "delete",
            "increment",
            "append",
            "lpop",
            "rpop",
            "lrange",
            "llen",
            "lindex",
            "ltrim",
            "hget",
            "hgetall",
            "hdel",
            "hkeys",
            "hvals",
            "hexists",
            "hincrby",
            "srem",
            "smembers",
            "sismember",
            "scard",
            "sinter",
            "sunion",
            "sdiff",
            "zrange",
            "zscore",
            "zcount",
            "zincrby",
            "zrem",
            "exists",
            "expire",
            "ttl"
          ]
        }
      }
    },
    {
      "key": "variableName",
      "label": "Variable Name",
      "type": "text",
      "placeholder": "e.g., scanner_tickers",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "set",
            "lpush",
            "rpush",
            "lset",
            "hset",
            "sadd",
            "zadd",
            "keys"
          ]
        }
      }
    },
    {
      "key": "value",
      "label": "Value",
      "type": "textarea",
      "placeholder": "Enter value or {{ $('Node').json.field }}",
      "displayOptions": {
        "show": {
          "operation": ["set", "append", "lpush", "rpush", "lset", "hset"]
        }
      }
    },
    {
      "key": "hashField",
      "label": "Hash Field",
      "type": "text",
      "placeholder": "field_name",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["hset", "hget", "hdel", "hexists", "hincrby"]
        }
      }
    },
    {
      "key": "members",
      "label": "Members",
      "type": "textarea",
      "placeholder": "member1, member2, member3 (comma-separated)",
      "displayOptions": {
        "show": {
          "operation": ["sadd", "srem", "zrem"]
        }
      }
    },
    {
      "key": "member",
      "label": "Member",
      "type": "textarea",
      "placeholder": "Enter member value or {{ $('Node').json.field }}",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["zadd", "sismember", "zscore", "zincrby"]
        }
      }
    },
    {
      "key": "score",
      "label": "Score",
      "type": "text",
      "placeholder": "Numeric score (e.g., timestamp or rank)",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["zadd"]
        }
      }
    },
    {
      "key": "startIndex",
      "label": "Start Index/Rank",
      "type": "text",
      "placeholder": "0",
      "default": 0,
      "displayOptions": {
        "show": {
          "operation": ["lrange", "ltrim", "zrange"]
        }
      }
    },
    {
      "key": "endIndex",
      "label": "End Index/Rank",
      "type": "text",
      "placeholder": "-1 (all)",
      "default": -1,
      "displayOptions": {
        "show": {
          "operation": ["lrange", "ltrim", "zrange"]
        }
      }
    },
    {
      "key": "index",
      "label": "Index",
      "type": "text",
      "placeholder": "0",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": ["lindex", "lset"]
        }
      }
    },
    {
      "key": "incrementBy",
      "label": "Increment By",
      "type": "text",
      "placeholder": "1",
      "default": 1,
      "displayOptions": {
        "show": {
          "operation": ["increment", "hincrby", "zincrby"]
        }
      }
    },
    {
      "key": "minScore",
      "label": "Min Score",
      "type": "text",
      "placeholder": "-inf",
      "displayOptions": {
        "show": {
          "operation": ["zcount"]
        }
      }
    },
    {
      "key": "maxScore",
      "label": "Max Score",
      "type": "text",
      "placeholder": "+inf",
      "displayOptions": {
        "show": {
          "operation": ["zcount"]
        }
      }
    },
    {
      "key": "pattern",
      "label": "Pattern",
      "type": "text",
      "placeholder": "* or prefix_*",
      "default": "*",
      "displayOptions": {
        "show": {
          "operation": ["keys"]
        }
      }
    },
    {
      "key": "otherKeys",
      "label": "Other Keys",
      "type": "textarea",
      "placeholder": "key1, key2, key3 (comma-separated variable names)",
      "displayOptions": {
        "show": {
          "operation": ["sinter", "sunion", "sdiff"]
        }
      }
    },
    {
      "key": "withScores",
      "label": "Include Scores",
      "type": "checkbox",
      "default": false,
      "displayOptions": {
        "show": {
          "operation": ["zrange"]
        }
      }
    },
    {
      "key": "reverseOrder",
      "label": "Reverse Order",
      "type": "checkbox",
      "default": false,
      "displayOptions": {
        "show": {
          "operation": ["zrange"]
        }
      }
    },
    {
      "key": "ttl",
      "label": "TTL (seconds)",
      "type": "text",
      "placeholder": "0 = no expiry, e.g., 86400 = 24hrs",
      "default": 0,
      "displayOptions": {
        "show": {
          "operation": [
            "set",
            "lpush",
            "rpush",
            "hset",
            "sadd",
            "zadd",
            "expire"
          ]
        }
      }
    }
  ]
}
