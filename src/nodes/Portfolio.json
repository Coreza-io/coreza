{
  "name": "Portfolio",
  "def": "Portfolio",
  "node_type": "main",
  "icon": "/assets/icons/backtest.svg",
  "category": "Portfolio",
  "description": "Query and update portfolio state -- positions, cash, equity, orders, trades. Works in both backtest and live broker modes.",
  "color": "text-orange-500",
  "size": {
    "width": 340,
    "height": 360
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/portfolio",
    "method": "POST"
  },
  "fields": [
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "required": true,
      "default": "backtest",
      "options": [
        {
          "id": "backtest",
          "name": "Backtest (SimBroker)"
        },
        {
          "id": "broker",
          "name": "Live (Broker)"
        }
      ]
    },
    {
      "key": "backtest_id",
      "label": "Backtest ID",
      "type": "text",
      "placeholder": "{{ $('BacktestInit').json.backtest_id }}",
      "required": true,
      "displayOptions": {
        "show": {
          "mode": ["backtest"]
        }
      }
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "required": true,
      "default": "get_portfolio",
      "options": [
        {
          "id": "create_portfolio",
          "name": "Create Portfolio (Bootstrap)"
        },
        {
          "id": "update_portfolio",
          "name": "Update Portfolio (Sync Fills)"
        },
        {
          "id": "get_portfolio",
          "name": "Get Portfolio"
        },
        {
          "id": "get_position",
          "name": "Get Position"
        },
        {
          "id": "update_mtm",
          "name": "Update Portfolio (MTM)"
        },
        {
          "id": "get_cash",
          "name": "Get Cash"
        },
        {
          "id": "get_equity",
          "name": "Get Equity"
        },
        {
          "id": "get_trades",
          "name": "Get Trades"
        }
      ]
    },
    {
      "key": "base_currency",
      "label": "Base Currency",
      "type": "select",
      "required": true,
      "default": "USDT",
      "options": [
        {
          "id": "USDT",
          "name": "USDT"
        },
        {
          "id": "USDC",
          "name": "USDC"
        },
        {
          "id": "USD",
          "name": "USD"
        },
        {
          "id": "EUR",
          "name": "EUR"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "create_portfolio",
            "update_portfolio",
            "get_portfolio",
            "get_cash",
            "get_equity"
          ]
        }
      }
    },
    {
      "key": "cash_balance",
      "label": "Cash Balance",
      "type": "text",
      "placeholder": "e.g. 64786.0",
      "required": true,
      "description": "Starting cash balance in the base currency.",
      "displayOptions": {
        "show": {
          "operation": ["create_portfolio"]
        }
      }
    },
    {
      "key": "symbol",
      "label": "Symbol(s)",
      "type": "text",
      "placeholder": "e.g. BTCUSDT or BTCUSDT,ETHUSDT",
      "required": false,
      "description": "One or more symbols (comma-separated).",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "get_position", "update_mtm"]
        }
      }
    },
    {
      "key": "side",
      "label": "Side",
      "type": "select",
      "required": true,
      "description": "Trade side. Determines whether quantity adds or reduces the position.",
      "options": [
        {
          "id": "BUY",
          "name": "BUY"
        },
        {
          "id": "SELL",
          "name": "SELL"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio"]
        }
      }
    },
    {
      "key": "quantity",
      "label": "Quantity",
      "type": "text",
      "placeholder": "{{ $('BinanceTrade').json.executedQty }}",
      "required": true,
      "description": "Filled quantity (absolute value). Trade side controls whether it adds to or reduces the position.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio"]
        }
      }
    },
    {
      "key": "price",
      "label": "Price",
      "type": "text",
      "placeholder": "{{ $('BinanceTrade').json.avgPrice }}",
      "required": true,
      "description": "Average fill price.",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio", "update_mtm"]
        }
      }
    },
    {
      "key": "commission",
      "label": "Commission",
      "type": "text",
      "placeholder": "0",
      "required": false,
      "default": "0",
      "description": "Trade commission (deducted from cash).",
      "displayOptions": {
        "show": {
          "operation": ["update_portfolio"]
        }
      }
    },
    {
      "key": "current_bar",
      "label": "Current Bar",
      "type": "textarea",
      "placeholder": "{{ $('OnBar').json.bar }}",
      "required": false,
      "description": "Current OHLCV bar for mark-to-market pricing",
      "displayOptions": {
        "show": {
          "operation": ["update_mtm"],
          "mode": ["backtest"]
        }
      }
    }
  ],
  "operationDisplayOptions": {
    "update_mtm": {
      "show": {
        "mode": ["backtest", "broker"]
      }
    }
  }
}
