{
  "name": "BacktestInit",
  "def": "Backtest Init",
  "node_type": "backtest",
  "icon": "/assets/icons/backtest.svg",
  "category": "Backtest",
  "description": "Initialize a backtest session with capital and simulation settings",
  "color": "text-orange-500",
  "size": {
    "width": 380,
    "height": 700
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/backtest/init",
    "method": "POST"
  },
  "fields": [
    {
      "key": "name",
      "label": "Backtest Name",
      "type": "text",
      "placeholder": "My Strategy Backtest",
      "required": false
    },
    {
      "key": "initial_capital",
      "label": "Initial Capital ($)",
      "type": "text",
      "placeholder": "10000",
      "default": "10000",
      "required": true
    },
    {
      "key": "start_date",
      "label": "Start Date",
      "type": "text",
      "placeholder": "2023-01-01",
      "required": false
    },
    {
      "key": "end_date",
      "label": "End Date",
      "type": "text",
      "placeholder": "2024-01-01",
      "required": false
    },
    {
      "key": "broker",
      "label": "Data Provider",
      "type": "select",
      "options": [
        {
          "id": "alpaca",
          "name": "Alpaca"
        },
        {
          "id": "binance",
          "name": "Binance"
        },
        {
          "id": "dhan",
          "name": "Dhan"
        },
        {
          "id": "schwab",
          "name": "Schwab"
        },
        {
          "id": "yahoo_finance",
          "name": "Yahoo Finance"
        },
        {
          "id": "fmp",
          "name": "FMP"
        },
        {
          "id": "polygon",
          "name": "Polygon"
        }
      ],
      "default": "alpaca",
      "required": true
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "dependsOn": "broker",
      "placeholder": "Select credential",
      "required": false,
      "displayOptions": {
        "hide": {
          "broker": [
            "yahoo_finance"
          ]
        }
      }
    },
    {
      "key": "asset_type",
      "label": "Asset Type",
      "type": "select",
      "required": false,
      "displayOptions": {
        "show": {
          "broker": [
            "alpaca",
            "binance"
          ]
        }
      },
      "dependsOn": "broker",
      "conditionalOptions": {
        "alpaca": [
          {
            "id": "stock",
            "name": "Stock"
          },
          {
            "id": "crypto",
            "name": "Crypto"
          }
        ],
        "binance": [
          {
            "id": "spot",
            "name": "Spot"
          },
          {
            "id": "futures",
            "name": "Futures"
          }
        ]
      }
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "AAPL",
      "required": true
    },
    {
      "key": "interval",
      "label": "Interval",
      "type": "select",
      "default": "1Day",
      "required": true,
      "dependsOn": "broker",
      "conditionalOptions": {
        "alpaca": [
          {
            "id": "1Min",
            "name": "1 min"
          },
          {
            "id": "5Min",
            "name": "5 min"
          },
          {
            "id": "15Min",
            "name": "15 min"
          },
          {
            "id": "1Hour",
            "name": "1 hour"
          },
          {
            "id": "1Day",
            "name": "1 day"
          }
        ],
        "binance": [
          {
            "id": "1m",
            "name": "1 min"
          },
          {
            "id": "3m",
            "name": "3 min"
          },
          {
            "id": "5m",
            "name": "5 min"
          },
          {
            "id": "15m",
            "name": "15 min"
          },
          {
            "id": "30m",
            "name": "30 min"
          },
          {
            "id": "1h",
            "name": "1 hour"
          },
          {
            "id": "4h",
            "name": "4 hour"
          },
          {
            "id": "1d",
            "name": "1 day"
          },
          {
            "id": "1w",
            "name": "1 week"
          }
        ],
        "dhan": [
          {
            "id": "1Min",
            "name": "1 min"
          },
          {
            "id": "5Min",
            "name": "5 min"
          },
          {
            "id": "15Min",
            "name": "15 min"
          },
          {
            "id": "1Hour",
            "name": "1 hour"
          },
          {
            "id": "1Day",
            "name": "1 day"
          }
        ],
        "schwab": [
          {
            "id": "1Min",
            "name": "1 min"
          },
          {
            "id": "5Min",
            "name": "5 min"
          },
          {
            "id": "15Min",
            "name": "15 min"
          },
          {
            "id": "1Hour",
            "name": "1 hour"
          },
          {
            "id": "1Day",
            "name": "1 day"
          }
        ],
        "yahoo_finance": [
          {
            "id": "1m",
            "name": "1 min"
          },
          {
            "id": "5m",
            "name": "5 min"
          },
          {
            "id": "15m",
            "name": "15 min"
          },
          {
            "id": "60m",
            "name": "60 min"
          },
          {
            "id": "1d",
            "name": "1 day"
          }
        ],
        "fmp": [
          {
            "id": "1min",
            "name": "1 min"
          },
          {
            "id": "5min",
            "name": "5 min"
          },
          {
            "id": "15min",
            "name": "15 min"
          },
          {
            "id": "1hour",
            "name": "1 hour"
          },
          {
            "id": "1day",
            "name": "1 day"
          }
        ],
        "polygon": [
          {
            "id": "1/minute",
            "name": "1 minute"
          },
          {
            "id": "5/minute",
            "name": "5 minute"
          },
          {
            "id": "15/minute",
            "name": "15 minute"
          },
          {
            "id": "1/hour",
            "name": "1 hour"
          },
          {
            "id": "1/day",
            "name": "1 day"
          }
        ]
      }
    },
    {
      "key": "feed",
      "label": "Data Feed",
      "type": "select",
      "options": [
        {
          "id": "sip",
          "name": "SIP - All US Exchanges"
        },
        {
          "id": "iex",
          "name": "IEX - Investors Exchange"
        },
        {
          "id": "delayed_sip",
          "name": "Delayed SIP (15 min)"
        },
        {
          "id": "otc",
          "name": "OTC - Over-the-counter"
        },
        {
          "id": "boats",
          "name": "BOATS - Blue Ocean"
        },
        {
          "id": "overnight",
          "name": "Overnight Data"
        }
      ],
      "default": "sip",
      "required": false,
      "displayOptions": {
        "show": {
          "broker": [
            "alpaca"
          ],
          "asset_type": [
            "stock"
          ]
        }
      }
    },
    {
      "key": "warmup_period",
      "label": "Warmup Period",
      "type": "text",
      "placeholder": "200",
      "default": "200",
      "required": false
    },
    {
      "key": "fill_model",
      "label": "Fill Model",
      "type": "select",
      "options": [
        {
          "id": "next_bar_open",
          "name": "Next Bar Open (Realistic)"
        },
        {
          "id": "immediate",
          "name": "Immediate (Current Close)"
        }
      ],
      "default": "next_bar_open",
      "required": true
    },
    {
      "key": "slippage_model",
      "label": "Slippage Model",
      "type": "select",
      "options": [
        {
          "id": "none",
          "name": "None"
        },
        {
          "id": "fixed",
          "name": "Fixed ($)"
        },
        {
          "id": "percentage",
          "name": "Percentage (%)"
        }
      ],
      "default": "percentage",
      "required": true
    },
    {
      "key": "slippage_value",
      "label": "Slippage Value",
      "type": "text",
      "placeholder": "0.001 (0.1%)",
      "default": "0.001",
      "required": false
    },
    {
      "key": "commission_model",
      "label": "Commission Model",
      "type": "select",
      "options": [
        {
          "id": "none",
          "name": "None (Zero Commission)"
        },
        {
          "id": "per_share",
          "name": "Per Share ($)"
        },
        {
          "id": "percentage",
          "name": "Percentage (%)"
        },
        {
          "id": "fixed",
          "name": "Fixed Per Trade ($)"
        }
      ],
      "default": "per_share",
      "required": true
    },
    {
      "key": "commission_value",
      "label": "Commission Value",
      "type": "text",
      "placeholder": "0.01 ($0.01/share)",
      "default": "0.01",
      "required": false
    }
  ]
}
