# Setup / CI-only credentials — never commit, never deploy to runtime.
# These are consumed by the Supabase CLI (supabase login, link, db push).
#
# SUPABASE_ACCESS_TOKEN: personal access token, must start with sbp_.
#   Create at: Supabase Account Settings → Access Tokens.
#   Do NOT paste anon, service_role, publishable, or secret keys here.
# SUPABASE_DB_PASSWORD: postgres role password for the linked project.
#   Used for non-interactive `supabase db push`.
# SUPABASE_PROJECT_ID: project ref (the subdomain in your project URL).

# Format: your Supabase project reference from its URL/dashboard; required, no default.
SUPABASE_PROJECT_ID=
# Format: sbp_... personal access token; setup/CLI only, not a project API key.
SUPABASE_ACCESS_TOKEN=
# Format: the project postgres role password; required for CLI database changes, no default.
SUPABASE_DB_PASSWORD=
