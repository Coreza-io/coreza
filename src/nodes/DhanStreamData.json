{
  "name": "DhanStreamListener",
  "broker": "dhan",
  "def": "Dhan Stream Listener",
  "node_type": "trigger",
  "icon": "/assets/icons/dhan.svg",
  "category": "Stream",
  "subCategory": "dhan",
  "executionMode": "streaming",
  "action": {
    "url": "/market/execute-stream-node",
    "method": "POST"
  },
  "streamingConfig": {
    "sourceId": "dhan_market",
    "waitForFirstEvent": false,
    "timeout": 300000,
    "listeningFlag": "isTestListening",
    "subscribeListeningFlag": "isStreamingWaiting",
    "recoveryPolling": {
      "endpoint": "/market/stream-test-result/{{workflow_id}}/{{node_id}}",
      "interval": 10000
    }
  },
  "description": "Register to receive subscribed real-time market data from Dhan. Use Listen mode to receive pre-subscribed security IDs, or Subscribe mode to subscribe and stream in one node.",
  "color": "text-blue-500",
  "size": {
    "width": 320,
    "height": 280
  },
  "handles": [
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Dhan"
    },
    {
      "key": "client_id",
      "label": "Client ID",
      "type": "text"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password"
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "live",
          "name": "Live"
        },
        {
          "id": "sandbox",
          "name": "Sandbox"
        }
      ],
      "default": "live"
    }
  ],
  "authAction": {
    "url": "/broker/dhan/auth",
    "method": "POST"
  },
  "fields": [
    {
      "key": "data_type",
      "type": "hidden",
      "default": "market",
      "label": "Data Type"
    },
    {
      "key": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        {
          "id": "listen",
          "name": "Register"
        },
        {
          "id": "subscribe",
          "name": "Subscribe & Register"
        }
      ],
      "default": "listen",
      "description": "Listen mode uses security IDs from Subscribe nodes. Subscribe mode subscribes directly.",
      "showDescription": false
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "required": false
    },
    {
      "key": "exchange",
      "label": "Exchange",
      "type": "select",
      "options": [
        {
          "id": "NSE_EQ",
          "name": "NSE Equity"
        },
        {
          "id": "BSE_EQ",
          "name": "BSE Equity"
        },
        {
          "id": "NSE_FNO",
          "name": "NSE F&O"
        },
        {
          "id": "BSE_FNO",
          "name": "BSE F&O"
        },
        {
          "id": "NSE_CURR",
          "name": "NSE Currency"
        },
        {
          "id": "BSE_CURR",
          "name": "BSE Currency"
        },
        {
          "id": "MCX",
          "name": "MCX"
        },
        {
          "id": "IDX",
          "name": "Index"
        }
      ],
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      }
    },
    {
      "key": "symbols",
      "label": "Security IDs",
      "type": "text",
      "placeholder": "1333, 11536",
      "description": "Comma-separated security IDs. Not required when only Order Updates is selected.",
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "showDescription": false,
      "required": false
    },
    {
      "key": "stream_types",
      "label": "Stream Types",
      "type": "multiselect",
      "options": [
        {
          "id": "ticker",
          "name": "Ticker (LTP)"
        },
        {
          "id": "quote",
          "name": "Quote (Bid/Ask)"
        },
        {
          "id": "full",
          "name": "Full (OHLC + Depth)"
        },
        {
          "id": "account_activity",
          "name": "Order Updates (Fills)"
        }
      ],
      "default": ["ticker"],
      "displayOptions": {
        "show": {
          "mode": ["subscribe"]
        }
      },
      "description": "Select Dhan market streams or order updates to subscribe to."
    },
    {
      "key": "scope",
      "label": "scope",
      "type": "select",
      "options": [
        {
          "id": "workflow",
          "name": "Only This Workflow's Subscriptions"
        },
        {
          "id": "global",
          "name": "All My Subscriptions"
        }
      ],
      "default": "workflow",
      "description": "Receive only security IDs subscribed targeting this workflow, or all your global subscriptions.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_symbols",
      "label": "Filter Security IDs (Optional)",
      "type": "text",
      "placeholder": "1333, 11536 (leave empty for all)",
      "description": "Only receive data for specific security IDs. Leave empty to receive all pre-subscribed.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    },
    {
      "key": "filter_types",
      "label": "Filter Stream Types (Optional)",
      "type": "multiselect",
      "options": [
        {
          "id": "ticker",
          "name": "Ticker"
        },
        {
          "id": "quote",
          "name": "Quote"
        },
        {
          "id": "full",
          "name": "Full"
        },
        {
          "id": "account_activity",
          "name": "Order Updates (Fills)"
        }
      ],
      "description": "Filter specific stream types. Leave empty to receive all types.",
      "displayOptions": {
        "show": {
          "mode": ["listen"]
        }
      },
      "showDescription": false
    }
  ]
}
