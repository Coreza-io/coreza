{
  "name": "FMPTool",
  "def": "Fundamental Data",
  "description": "Fetch comprehensive fundamental data from Financial Modeling Prep (FMP)",
  "node_type": "tool",
  "category": "Data",
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My FMP API"
    },
    {
      "key": "api_key",
      "label": "FMP API Key",
      "type": "password",
      "placeholder": "Your FMP API key"
    }
  ],
  "authAction": { "url": "/fmp/auth", "method": "POST" },
  "icon": "/assets/icons/fmp.svg",
  "size": { "width": 340, "height": 480 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "action": { "url": "/fmp/execute", "method": "POST" },
  "fields": [
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "id": "profile", "name": "Company Profile" },
        { "id": "quote", "name": "Stock Quote" },
        { "id": "income_statement", "name": "Income Statement" },
        { "id": "balance_sheet", "name": "Balance Sheet" },
        { "id": "cash_flow", "name": "Cash Flow Statement" },
        { "id": "key_metrics", "name": "Key Metrics" },
        { "id": "ratios", "name": "Financial Ratios" },
        { "id": "financial_growth", "name": "Financial Growth" },
        { "id": "financial_scores", "name": "Financial Scores (Z-Score, Piotroski)" },
        { "id": "enterprise_value", "name": "Enterprise Value" },
        { "id": "stock_peers", "name": "Stock Peers" },
        { "id": "analyst_estimates", "name": "Analyst Estimates" },
        { "id": "price_target", "name": "Price Target" },
        { "id": "earnings_calendar", "name": "Earnings Calendar" },
        { "id": "dividends", "name": "Dividends" },
        { "id": "splits", "name": "Stock Splits" },
        { "id": "news", "name": "Stock News" },
        { "id": "insider_trading", "name": "Insider Trading" },
        { "id": "institutional_holders", "name": "Institutional Holders" }
      ],
      "default": "profile",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true
    },
    {
      "key": "period",
      "label": "Period",
      "type": "select",
      "options": [
        { "id": "annual", "name": "Annual" },
        { "id": "quarter", "name": "Quarterly" }
      ],
      "default": "annual",
      "displayOptions": {
        "show": {
          "operation": [
            "income_statement", "balance_sheet", "cash_flow",
            "key_metrics", "ratios", "financial_growth"
          ]
        }
      }
    },
    {
      "key": "limit",
      "label": "Limit (Results)",
      "type": "text",
      "placeholder": "10",
      "default": "10",
      "displayOptions": {
        "show": {
          "operation": [
            "income_statement", "balance_sheet", "cash_flow",
            "key_metrics", "ratios", "financial_growth",
            "analyst_estimates", "price_target", "earnings_calendar",
            "dividends", "splits", "news", "insider_trading"
          ]
        }
      }
    }
  ]
}
