{
  "name": "WebhookTrigger",
  "node_type": "trigger",
  "category": "webhook",
  "icon": "webhook",
  "description": "Receive HTTP webhooks from external services",
  "color": "text-purple-500",
  "size": {
    "width": 360,
    "height": 400
  },
  "handles": [
    { "type": "source", "position": "right", "id": "output" }
  ],
  "executionMode": "webhook_listening",
  "fields": [
    {
      "key": "webhookUrl",
      "label": "Webhook URL",
      "type": "webhookUrl",
      "required": false
    },
    {
      "key": "httpMethod",
      "label": "HTTP Method",
      "type": "select",
      "options": [
        { "label": "GET", "value": "GET" },
        { "label": "POST", "value": "POST" },
        { "label": "PUT", "value": "PUT" },
        { "label": "PATCH", "value": "PATCH" },
        { "label": "DELETE", "value": "DELETE" },
        { "label": "HEAD", "value": "HEAD" }
      ],
      "default": "POST",
      "required": false
    },
    {
      "key": "authentication",
      "label": "Authentication",
      "type": "select",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Basic Auth", "value": "basicAuth" },
        { "label": "Header Auth", "value": "headerAuth" },
        { "label": "JWT Auth", "value": "jwtAuth" }
      ],
      "default": "none",
      "required": false
    },
    {
      "key": "authUsername",
      "label": "Username",
      "type": "text",
      "placeholder": "Enter username",
      "required": true,
      "displayOptions": {
        "show": { "authentication": ["basicAuth"] }
      }
    },
    {
      "key": "authPassword",
      "label": "Password",
      "type": "password",
      "placeholder": "Enter password",
      "required": true,
      "displayOptions": {
        "show": { "authentication": ["basicAuth"] }
      }
    },
    {
      "key": "authHeaderName",
      "label": "Header Name",
      "type": "text",
      "placeholder": "X-API-Key",
      "required": true,
      "displayOptions": {
        "show": { "authentication": ["headerAuth"] }
      }
    },
    {
      "key": "authHeaderValue",
      "label": "Header Value",
      "type": "password",
      "placeholder": "Enter header value",
      "required": true,
      "displayOptions": {
        "show": { "authentication": ["headerAuth"] }
      }
    },
    {
      "key": "authJwtSecret",
      "label": "JWT Secret",
      "type": "password",
      "placeholder": "Enter JWT secret for verification",
      "required": true,
      "displayOptions": {
        "show": { "authentication": ["jwtAuth"] }
      }
    }
  ],
  "output": {
    "webhookPayload": {
      "timestamp": "ISO 8601 timestamp",
      "method": "HTTP method",
      "headers": "Request headers (sensitive ones redacted)",
      "body": "Request body",
      "query": "Query parameters",
      "raw": "Complete raw request data"
    }
  }
}
