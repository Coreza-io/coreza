{
  "name": "RollingWindow",
  "def": "Rolling Window Buffer",
  "node_type": "main",
  "icon": "/assets/icons/store.svg",
  "category": "Data",
  "subCategory": "RollingWindow",
  "description": "Holds the most recent N candles and returns them newest to oldest, with the newest candle at index 0.",
  "color": "#8b5cf6",
  "size": {
    "width": 280,
    "height": 300
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/storage/rolling-window",
    "method": "POST"
  },
  "fields": [
    {
      "key": "operation",
      "type": "select",
      "label": "Operation",
      "default": "set",
      "options": [
        {
          "label": "Set",
          "value": "set"
        },
        {
          "label": "Get",
          "value": "get"
        }
      ]
    },
    {
      "key": "size",
      "type": "text",
      "label": "Window Size",
      "required": true,
      "placeholder": "20",
      "default": "20",
      "description": "Max bars to hold (1-500). The window is ready when full. In backtests, warm-up candles can fill the window through the normal OnBar path.",
      "displayOptions": {
        "show": {
          "operation": ["set"]
        }
      }
    },
    {
      "key": "candle_data",
      "type": "textarea",
      "label": "Candle Data",
      "required": true,
      "placeholder": "Bar or bars to add (single bar, array, or {{ $('Node').json.data }})",
      "description": "OHLCV bars to add. Supply batches from oldest to newest.",
      "displayOptions": {
        "show": {
          "operation": ["set"]
        }
      }
    },
    {
      "key": "symbol",
      "type": "text",
      "label": "Symbol",
      "required": true,
      "placeholder": "e.g. BTCUSDT",
      "description": "Symbol for the rolling-window buffer."
    },
    {
      "key": "timeframe",
      "type": "text",
      "label": "Timeframe",
      "required": true,
      "placeholder": "e.g. 1d"
    }
  ]
}
