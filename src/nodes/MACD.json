{
  "name": "MACD",
  "def": "Moving Average Convergence Divergence",
  "node_type": "main",
  "icon": "/assets/icons/macd.svg",
  "category": "Indicators",
  "subcategory": "Trend Indicators",
  "description": "MACD (Moving Average Convergence Divergence) indicator to measure momentum and trend strength",
  "color": "text-purple-500",
  "size": {
    "width": 320,
    "height": 320
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "action": {
    "url": "/indicators/macd",
    "method": "POST"
  },
  "fields": [
    {
      "key": "candle_data",
      "label": "Candle Data",
      "type": "text",
      "required": true
    },
    {
      "key": "symbol",
      "label": "Symbol",
      "type": "text",
      "placeholder": "e.g. AAPL",
      "required": true,
      "description": "The ticker symbol for the asset being analyzed (e.g. AAPL, BTCUSDT)."
    },
    {
      "key": "timeframe",
      "label": "Timeframe",
      "type": "text",
      "placeholder": "e.g. 1d",
      "required": true,
      "description": "The timeframe/interval of the candle data (e.g. 1m, 5m, 1h, 1d)."
    },
    {
      "key": "fastPeriod",
      "label": "Fast EMA Period",
      "type": "text",
      "placeholder": "e.g. 12",
      "default": "12",
      "required": true,
      "description": "Period for fast EMA."
    },
    {
      "key": "slowPeriod",
      "label": "Slow EMA Period",
      "type": "text",
      "placeholder": "e.g. 26",
      "default": "26",
      "required": true,
      "description": "Period for slow EMA. Must be greater than fast period."
    },
    {
      "key": "signalPeriod",
      "label": "Signal Line EMA",
      "type": "text",
      "placeholder": "e.g. 9",
      "default": "9",
      "required": true,
      "description": "Period for signal line."
    }
  ]
}
