{
  "name": "RedisStore",
  "label": "Redis Store",
  "def": "Store and retrieve data from Redis",
  "node_type": "main",
  "icon": "/assets/icons/redis.svg",
  "category": "Data",
  "description": "Persistent key-value storage with TTL, lists, and hash support",
  "color": "text-red-500",
  "size": { "width": 340, "height": 420 },
  "handles": [
    { "type": "target", "position": "left", "id": "input" },
    { "type": "source", "position": "right", "id": "output" }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Redis",
      "placeholder": "e.g., Production Redis"
    },
    {
      "key": "host",
      "label": "Host",
      "type": "text",
      "placeholder": "localhost or redis-12345.cloud.redislabs.com",
      "required": true
    },
    {
      "key": "port",
      "label": "Port",
      "type": "text",
      "default": "6379",
      "placeholder": "6379"
    },
    {
      "key": "password",
      "label": "Password",
      "type": "password",
      "placeholder": "Redis password (leave blank if none)"
    },
    {
      "key": "user",
      "label": "User (optional)",
      "type": "text",
      "placeholder": "Leave blank for password-only auth"
    },
    {
      "key": "database",
      "label": "Database Number",
      "type": "text",
      "default": "0",
      "placeholder": "0"
    },
    {
      "key": "tls",
      "label": "Use TLS/SSL",
      "type": "select",
      "options": [
        { "label": "Yes (recommended for cloud)", "value": "true" },
        { "label": "No", "value": "false" }
      ],
      "default": "true"
    }
  ],
  "authAction": { "url": "/redis/auth", "method": "POST" },
  "action": {
    "url": "/redis/store",
    "method": "POST"
  },
  "fields": [
    {
      "key": "credential_id",
      "label": "Redis Connection",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select Redis account",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        { "label": "Delete", "value": "delete", "description": "Delete a key from Redis" },
        { "label": "Get", "value": "get", "description": "Get the value of a key from Redis" },
        { "label": "Increment", "value": "increment", "description": "Atomically increments a key by 1. Creates the key if it does not exist" },
        { "label": "Info", "value": "info", "description": "Returns generic information about the Redis instance" },
        { "label": "Keys", "value": "keys", "description": "Returns all the keys matching a pattern" },
        { "label": "Pop", "value": "pop", "description": "Pop data from a redis list" },
        { "label": "Publish", "value": "publish", "description": "Publish message to redis channel" },
        { "label": "Push", "value": "push", "description": "Push data to a redis list" },
        { "label": "Set", "value": "set", "description": "Set the value of a key in redis" }
      ],
      "default": "set",
      "required": true
    },
    {
      "key": "scope",
      "label": "Scope",
      "type": "select",
      "options": [
        { "label": "Workflow (this workflow only)", "value": "workflow" },
        { "label": "User (shared across workflows)", "value": "user" },
        { "label": "Global (shared across users)", "value": "global" }
      ],
      "default": "workflow",
      "description": "Determines key namespace",
      "displayOptions": {
        "show": { "operation": ["get", "set", "delete", "increment", "pop", "push"] }
      }
    },
    {
      "key": "keyType",
      "label": "Key Type",
      "type": "select",
      "options": [
        { "label": "Automatic", "value": "automatic", "description": "Tries to figure out the type automatically depending on the data" },
        { "label": "Hash", "value": "hash", "description": "Data in key is of type 'hash'" },
        { "label": "List", "value": "list", "description": "Data in key is of type 'lists'" },
        { "label": "Sets", "value": "sets", "description": "Data in key is of type 'sets'" },
        { "label": "String", "value": "string", "description": "Data in key is of type 'string'" }
      ],
      "default": "automatic",
      "displayOptions": {
        "show": { "operation": ["get", "set", "delete"] }
      }
    },
    {
      "key": "key",
      "label": "Key",
      "type": "text",
      "placeholder": "e.g., scanner:breakoutCandidates",
      "displayOptions": {
        "show": { "operation": ["get", "set", "delete", "increment", "pop", "push"] }
      }
    },
    {
      "key": "pattern",
      "label": "Pattern",
      "type": "text",
      "placeholder": "e.g., user:* or session:*",
      "default": "*",
      "description": "Pattern to match keys (supports * and ? wildcards)",
      "displayOptions": {
        "show": { "operation": ["keys"] }
      }
    },
    {
      "key": "channel",
      "label": "Channel",
      "type": "text",
      "placeholder": "e.g., notifications or alerts",
      "required": true,
      "displayOptions": {
        "show": { "operation": ["publish"] }
      }
    },
    {
      "key": "value",
      "label": "Value",
      "type": "textarea",
      "placeholder": "{{ $('Scanner').json.tickers }} or static value",
      "displayOptions": { 
        "show": { "operation": ["set", "push", "publish"] } 
      }
    },
    {
      "key": "hashField",
      "label": "Hash Field",
      "type": "text",
      "placeholder": "Field name for hash operations",
      "displayOptions": { 
        "show": { 
          "operation": ["get", "set"],
          "keyType": ["hash"]
        } 
      }
    },
    {
      "key": "setMember",
      "label": "Set Member",
      "type": "text",
      "placeholder": "Member value for set operations",
      "displayOptions": { 
        "show": { 
          "operation": ["set"],
          "keyType": ["sets"]
        } 
      }
    },
    {
      "key": "popDirection",
      "label": "Pop Direction",
      "type": "select",
      "options": [
        { "label": "Left (LPOP)", "value": "left" },
        { "label": "Right (RPOP)", "value": "right" }
      ],
      "default": "left",
      "displayOptions": {
        "show": { "operation": ["pop"] }
      }
    },
    {
      "key": "pushDirection",
      "label": "Push Direction",
      "type": "select",
      "options": [
        { "label": "Left (LPUSH)", "value": "left" },
        { "label": "Right (RPUSH)", "value": "right" }
      ],
      "default": "left",
      "displayOptions": {
        "show": { "operation": ["push"] }
      }
    },
    {
      "key": "ttl",
      "label": "TTL (seconds)",
      "type": "number",
      "placeholder": "0 = no expiry, e.g., 86400 = 24hrs",
      "default": 0,
      "description": "Time to live in seconds (0 = no expiry)",
      "displayOptions": { 
        "show": { "operation": ["set", "push"] } 
      }
    }
  ]
}
