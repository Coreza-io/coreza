{
  "name": "BinanceSubscribe",
  "def": "Binance Subscribe",
  "node_type": "main",
  "icon": "/assets/icons/binance.svg",
  "category": "Market",
  "subCategory": "binance",
  "description": "Subscribe or unsubscribe to Binance real-time market data. Subscriptions persist and can be received by any activated BinanceStreamData trigger.",
  "color": "text-yellow-500",
  "size": {
    "width": 380,
    "height": 520
  },
  "handles": [
    {
      "type": "target",
      "position": "left",
      "id": "input"
    },
    {
      "type": "source",
      "position": "right",
      "id": "output"
    }
  ],
  "auth": "GenericAuthModal",
  "authFields": [
    {
      "key": "credential_name",
      "label": "Credential Label",
      "type": "text",
      "default": "My Binance"
    },
    {
      "key": "api_key",
      "label": "API Key",
      "type": "password",
      "required": true
    },
    {
      "key": "secret_key",
      "label": "Secret Key",
      "type": "password",
      "required": true
    }
  ],
  "authAction": {
    "url": "/broker/binance/auth",
    "method": "POST"
  },
  "action": {
    "url": "/stream/binance/{{operation}}",
    "method": "POST"
  },
  "fields": [
    {
      "key": "assetType",
      "type": "hidden",
      "default": "crypto"
    },
    {
      "key": "credential_id",
      "label": "Credential",
      "type": "select",
      "optionsSource": "credentialsApi",
      "placeholder": "Select credential",
      "required": true
    },
    {
      "key": "environment",
      "label": "Environment",
      "type": "select",
      "options": [
        {
          "id": "testnet",
          "name": "Testnet (Paper)"
        },
        {
          "id": "live",
          "name": "Production (Live)"
        }
      ],
      "default": "testnet",
      "required": true
    },
    {
      "key": "marketType",
      "label": "Market Type",
      "type": "select",
      "options": [
        {
          "id": "spot",
          "name": "Spot"
        },
        {
          "id": "futures",
          "name": "Futures (USDT-M)"
        }
      ],
      "default": "spot",
      "required": true
    },
    {
      "key": "operation",
      "label": "Operation",
      "type": "select",
      "options": [
        {
          "id": "subscribe",
          "name": "Subscribe"
        },
        {
          "id": "unsubscribe",
          "name": "Unsubscribe"
        }
      ],
      "default": "subscribe",
      "required": true
    },
    {
      "key": "stream_type",
      "label": "Stream Type",
      "type": "multiselect",
      "options": [
        {
          "id": "trade",
          "name": "Trade"
        },
        {
          "id": "aggTrade",
          "name": "Aggregated Trade"
        },
        {
          "id": "kline",
          "name": "Kline (Candlestick)"
        },
        {
          "id": "miniTicker",
          "name": "Mini Ticker"
        },
        {
          "id": "ticker",
          "name": "Ticker (24h)"
        },
        {
          "id": "bookTicker",
          "name": "Book Ticker"
        },
        {
          "id": "depth",
          "name": "Depth (Order Book)"
        },
        {
          "id": "order_update",
          "name": "Order Updates (Fills)"
        }
      ],
      "default": ["kline"],
      "description": "Select Binance market data stream types",
      "required": true,
      "showDescription": false
    },
    {
      "key": "interval",
      "label": "Kline Interval",
      "type": "select",
      "options": [
        {
          "id": "1m",
          "name": "1 Minute"
        },
        {
          "id": "3m",
          "name": "3 Minutes"
        },
        {
          "id": "5m",
          "name": "5 Minutes"
        },
        {
          "id": "15m",
          "name": "15 Minutes"
        },
        {
          "id": "30m",
          "name": "30 Minutes"
        },
        {
          "id": "1h",
          "name": "1 Hour"
        },
        {
          "id": "2h",
          "name": "2 Hours"
        },
        {
          "id": "4h",
          "name": "4 Hours"
        },
        {
          "id": "6h",
          "name": "6 Hours"
        },
        {
          "id": "8h",
          "name": "8 Hours"
        },
        {
          "id": "12h",
          "name": "12 Hours"
        },
        {
          "id": "1d",
          "name": "1 Day"
        },
        {
          "id": "3d",
          "name": "3 Days"
        },
        {
          "id": "1w",
          "name": "1 Week"
        },
        {
          "id": "1M",
          "name": "1 Month"
        }
      ],
      "default": "1m",
      "displayOptions": {
        "show": {
          "stream_types": ["kline"]
        }
      },
      "description": "Candlestick timeframe for kline data",
      "showDescription": false
    },
    {
      "key": "depth_levels",
      "label": "Order Book Depth",
      "type": "select",
      "options": [
        {
          "id": "5",
          "name": "Top 5 Levels"
        },
        {
          "id": "10",
          "name": "Top 10 Levels"
        },
        {
          "id": "20",
          "name": "Top 20 Levels"
        }
      ],
      "default": "10",
      "displayOptions": {
        "show": {
          "stream_types": ["depth"]
        }
      },
      "description": "Number of order book levels to receive",
      "showDescription": false
    },
    {
      "key": "symbols",
      "label": "Symbols",
      "type": "text",
      "placeholder": "BTCUSDT, ETHUSDT",
      "description": "Comma-separated symbols (uppercase)",
      "required": true,
      "showDescription": false
    },
    {
      "key": "scope",
      "label": "Subscription Scope",
      "type": "select",
      "options": [
        {
          "id": "global",
          "name": "Global (All Workflows)"
        },
        {
          "id": "workflow",
          "name": "Specific Workflow Only"
        }
      ],
      "default": "global",
      "description": "Choose who can access this subscription",
      "required": true,
      "showDescription": false
    },
    {
      "key": "targetWorkflowId",
      "label": "Target Workflow",
      "type": "select",
      "options": [
        {
          "id": "__current__",
          "name": "This Workflow (Current)"
        }
      ],
      "optionsSource": "storeWorkflowsApi",
      "placeholder": "Select workflow to receive data",
      "displayOptions": {
        "show": {
          "scope": ["workflow"]
        }
      },
      "default": "__current__"
    }
  ]
}
